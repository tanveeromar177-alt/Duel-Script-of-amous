	-- slot -> { folder inside Animate, Animation instance name }  (same mapping as Evora)
	local SLOTS = {
		idle1    = { "idle", "Animation1" },
		idle2    = { "idle", "Animation2" },
		walk     = { "walk", "WalkAnim" },
		run      = { "run", "RunAnim" },
		jump     = { "jump", "JumpAnim" },
		fall     = { "fall", "FallAnim" },
		climb    = { "climb", "ClimbAnim" },
		swim     = { "swim", "Swim" },
		swimidle = { "swimidle", "SwimIdle" },
	}
	local ORIG_ATTR = "WindOrigAnimId"
	local DEFAULT_PACK = PACK_ORDER[1]

	local pill = G.WaveTogglePill_Anim
	local prevBtn, nextBtn, nameLbl = G.TextButton_AnimPrev, G.TextButton_AnimNext, G.TextLabel_AnimName

	local anim = { pack = DEFAULT_PACK, on = false, gen = 0 }

	local function toId(v)
		if type(v) == "number" then return "rbxassetid://" .. tostring(v) end
		if type(v) == "string" and v:match("^%d+$") then return "rbxassetid://" .. v end
		if type(v) == "string" and v ~= "" then return v end
		return nil
	end

	local function packIds(pack) -- slot -> asset id string, only the slots the pack has
		local idle = pack.Idle or {}
		return {
			idle1 = toId(pack.Animation1 or idle[1]),
			idle2 = toId(pack.Animation2 or idle[2]),
			walk = toId(pack.WalkAnim),
			run = toId(pack.RunAnim),
			jump = toId(pack.JumpAnim),
			fall = toId(pack.FallAnim),
			climb = toId(pack.ClimbAnim),
			swim = toId(pack.Swim),
			swimidle = toId(pack.SwimIdle),
		}
	end

	local function findSlots(animate) -- slot -> Animation instance (the ones this character's Animate script has)
		local found = {}
		for slot, path in pairs(SLOTS) do
			local folder = animate:FindFirstChild(path[1])
			local inst = folder and folder:FindFirstChild(path[2])
			if inst and inst:IsA("Animation") then found[slot] = inst end
		end
		return found
	end

	local function restoreSlots(slots)
		for _, inst in pairs(slots) do
			local orig = inst:GetAttribute(ORIG_ATTR)
			if orig ~= nil then
				pcall(function() inst.AnimationId = orig end)
				pcall(function() inst:SetAttribute(ORIG_ATTR, nil) end)
			end
		end
	end

	local function stopTracks(char)
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum then return end
		for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
			pcall(function() track:Stop(0) end)
		end
	end

	-- apply = true: put pack `name` on `char`;  apply = false: give the game's own ids back
	local function run(char, name, apply, gen)
		if not char then return false end
		local animate = char:FindFirstChild("Animate") or char:WaitForChild("Animate", 3)
		if gen ~= anim.gen or char ~= lp.Character then return false end -- changed while waiting
		if not animate then
			warn("[WIND] Animation Changer: no 'Animate' script in the character, nothing changed")
			return false
		end
		local slots = findSlots(animate)
		restoreSlots(slots) -- start from the game's ids, so slots the new pack does not have stay original
		if apply then
			local pack = PACKS[name]
			if not pack then return false end
			local ids = packIds(pack)
			for slot, id in pairs(ids) do
				local inst = slots[slot]
				if inst then
					if inst:GetAttribute(ORIG_ATTR) == nil then
						pcall(function() inst:SetAttribute(ORIG_ATTR, inst.AnimationId) end)
					end
					pcall(function() inst.AnimationId = id end)
				end
			end
		end
		stopTracks(char)
		return true
	end

	local function request(apply) -- async: the Animate script may not exist yet
		anim.gen += 1
		local gen, char, name = anim.gen, lp.Character, anim.pack
		if not char then return end
		task.spawn(function()
			local ok, err = pcall(run, char, name, apply, gen)
			if not ok then warn("[WIND] Animation Changer: " .. tostring(err)) end
		end)
	end

	local function setPack(name)
		if type(name) ~= "string" or not PACKS[name] or not table.find(PACK_ORDER, name) then return false end
		anim.pack = name
		if nameLbl then nameLbl.Text = name end
		if anim.on then request(true) end
		return true
	end

	local function stepPack(d)
		local idx = table.find(PACK_ORDER, anim.pack) or 1
		idx = (idx - 1 + d) % #PACK_ORDER + 1
		setPack(PACK_ORDER[idx])
		if not anim.on and pill then
			setToggleVisual(pill, true) -- the attribute signal below turns it on and applies the pack
		end
	end

	if nameLbl then nameLbl.Text = anim.pack end

	if pill then
		pill:GetAttributeChangedSignal("WaveToggleOn"):Connect(function()
			local want = pill:GetAttribute("WaveToggleOn") == true
			if want and not anim.on then
				anim.on = true
				request(true)
			elseif not want and anim.on then
				anim.on = false
				request(false)
			end
		end)
	else
		warn("[WIND] Animation Changer: toggle pill (WaveTogglePill_Anim) missing, feature not wired")
	end

	if prevBtn and nextBtn then
		prevBtn.MouseButton1Click:Connect(function() stepPack(-1) end)
		nextBtn.MouseButton1Click:Connect(function() stepPack(1) end)
	else
		warn("[WIND] Animation Changer: arrow buttons missing, pack row not wired")
	end

	lp.CharacterAdded:Connect(function()
		if not anim.on then return end
		task.wait(0.75)
		if anim.on then request(true) end
	end)

	-- config: the chosen pack rides along with the other visuals values (G.VisualsCtl wraps are chained, the Sky section does the same)
	if G.VisualsCtl then
		local prevGet, prevSet = G.VisualsCtl.getState, G.VisualsCtl.setState
		G.VisualsCtl.getState = function()
			local s = prevGet and prevGet() or {}
			s.animPack = anim.pack
			return s
		end
		G.VisualsCtl.setState = function(s)
			if prevSet then prevSet(s) end
			if type(s) == "table" and type(s.animPack) == "string" then setPack(s.animPack) end
		end
	else
		warn("[WIND] Animation Changer: G.VisualsCtl missing, the animation pack will not be saved in the config")
	end
end

