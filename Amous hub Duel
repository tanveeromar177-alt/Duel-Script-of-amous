local function loadAssetObjects(assetId)
    local ok, inserted = pcall(function()
        return InsertService:LoadAsset(assetId)
    end)
    if ok and inserted then return { inserted } end
    local ok2, objects = pcall(function()
        return game:GetObjects("rbxassetid://" .. tostring(assetId))
    end)
    if ok2 and objects and #objects > 0 then return objects end
    return nil
end

local function findCharacterAttachment(character, name)
    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("Attachment") and obj.Name == name and not obj:FindFirstAncestorWhichIsA("Accessory") then
            return obj
        end
    end
end

local function weldPart(part0, part1)
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = part0
    weld.Part1 = part1
    weld.Parent = part0
end

local function sanitizeVisual(container)
    for _, obj in ipairs(container:GetDescendants()) do
        if obj:IsA("LuaSourceContainer") then
            obj:Destroy()
        elseif obj:IsA("BasePart") then
            obj.Anchored = false
            obj.CanCollide = false
            obj.CanTouch = false
            obj.CanQuery = false
            obj.Massless = true
        end
    end
end

local function clearLocalOutfits(character)
    if not character then return end
    for _, child in ipairs(character:GetChildren()) do
        if child:GetAttribute("LocalOutfit") then
            pcall(function() child:Destroy() end)
        end
    end
end

local function attachClassicClothing(rootObject, character, assetId)
    local candidates = {}
    if rootObject:IsA("Shirt") or rootObject:IsA("Pants") or rootObject:IsA("ShirtGraphic") then
        table.insert(candidates, rootObject)
    end
    for _, obj in ipairs(rootObject:GetDescendants()) do
        if obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") then
            table.insert(candidates, obj)
        end
    end
    local added = 0
    for _, source in ipairs(candidates) do
        for _, existing in ipairs(character:GetChildren()) do
            if existing.ClassName == source.ClassName and not existing:GetAttribute("LocalOutfit") then
                local prop = existing:IsA("Shirt") and "ShirtTemplate"
                    or existing:IsA("Pants") and "PantsTemplate"
                    or "Graphic"
                pcall(function() existing[prop] = "" end)
            end
        end
        local clone = source:Clone()
        clone.Name = "LocalClothing_" .. tostring(assetId)
        clone:SetAttribute("LocalOutfit", true)
        clone:SetAttribute("AssetId", assetId)
        clone.Parent = character
        added = added + 1
    end
    return added
end

local function attachAccessory(accessory, character, rootPart, assetId)
    local handle = accessory:FindFirstChild("Handle") or accessory:FindFirstChildWhichIsA("BasePart", true)
    if not handle then return false end
    sanitizeVisual(accessory)
    accessory.Name = "LocalOutfit_" .. tostring(assetId)
    accessory:SetAttribute("LocalOutfit", true)
    accessory:SetAttribute("AssetId", assetId)
    accessory.Parent = character

    local sourceAttachment
    for _, child in ipairs(handle:GetChildren()) do
        if child:IsA("Attachment") and findCharacterAttachment(character, child.Name) then
            sourceAttachment = child
            break
        end
    end
    local targetAttachment = sourceAttachment and findCharacterAttachment(character, sourceAttachment.Name)
    local targetPart = targetAttachment and targetAttachment.Parent
    if targetAttachment and targetPart and targetPart:IsA("BasePart") then
        handle.CFrame = targetAttachment.WorldCFrame * sourceAttachment.CFrame:Inverse()
    else
        targetPart = character:FindFirstChild("Head")
            or character:FindFirstChild("UpperTorso")
            or character:FindFirstChild("Torso")
            or rootPart
        if not targetPart then
            accessory:Destroy()
            return false
        end
        handle.CFrame = targetPart.CFrame
    end
    weldPart(handle, targetPart)
    return true
end

local function WearOutfit(assetIds)
    local char = LP.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root then return end
    clearLocalOutfits(char)
    if not assetIds or #assetIds == 0 then return end
    for _, id in ipairs(assetIds) do
        local objects = loadAssetObjects(id)
        if objects then
            for _, loaded in ipairs(objects) do
                attachClassicClothing(loaded, char, id)
                local accessories = {}
                if loaded:IsA("Accessory") or loaded:IsA("Accoutrement") then
                    table.insert(accessories, loaded)
                else
                    for _, desc in ipairs(loaded:GetDescendants()) do
                        if desc:IsA("Accessory") or desc:IsA("Accoutrement") then
                            table.insert(accessories, desc:Clone())
                        end
                    end
                end
                for _, acc in ipairs(accessories) do
                    pcall(attachAccessory, acc, char, root, id)
                end
                if loaded.Parent and not loaded:GetAttribute("LocalOutfit") then
                    pcall(function() loaded:Destroy() end)
                end
            end
        end
    end
end

function applyOutfitByName(name)
    if not Outfits[name] then name = "Off" end
    currentOutfitName = name
    for i, n in ipairs(OUTFIT_ORDER) do
        if n == name then currentOutfitIndex = i break end
    end
    if name == "Off" then
        clearLocalOutfits(LP.Character)
    else
        WearOutfit(Outfits[name])
    end
    if outfitSelectorLabel then outfitSelectorLabel.Text = name end
end

