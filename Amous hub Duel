-- Mobile Button Size -> every mobile button; each button keeps its own centre,
-- so buttons you placed by hand stay where they are and only grow/shrink.
local function applyButtonScale(newScale)
	local old = G.WAVEButtonScale.Scale
	if math.abs(newScale - old) < 1e-6 then return end
	for _, pair in ipairs(stackDragPairs) do
		local f = pair[1]
		local p, sz = f.Position, f.Size
		local cx = p.X.Offset * old + sz.X.Offset * old / 2 -- centre in screen px from panel origin
		local cy = p.Y.Offset * old + sz.Y.Offset * old / 2
		f.Position = UDim2.new(
			p.X.Scale, (cx - sz.X.Offset * newScale / 2) / newScale,
			p.Y.Scale, (cy - sz.Y.Offset * newScale / 2) / newScale
		)
	end
	G.WAVEButtonScale.Scale = newScale
end

