-- Image helper: thumbnail first (works for decals and images), then swaps in the real texture when the
-- executor has game:GetObjects and the asset is a Decal/Texture (same approach the mini button logo uses).
G.ApplyAssetImage = function(imageLabel, assetId)
	imageLabel.Image = "rbxthumb://type=Asset&id=" .. tostring(assetId) .. "&w=420&h=420"
	task.spawn(function()
		local ok, objs = pcall(function()
			return game:GetObjects("rbxassetid://" .. tostring(assetId))
		end)
		if not ok or type(objs) ~= "table" then return end
		local obj = objs[1]
		if obj and (obj:IsA("Decal") or obj:IsA("Texture")) and obj.Texture ~= "" and imageLabel.Parent then
			imageLabel.Image = obj.Texture
		end
		pcall(function() if obj then obj:Destroy() end end)
	end)
end

