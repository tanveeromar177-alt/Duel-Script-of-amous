        if type(data) ~= "table" then return end
        local s = tonumber(data.bubbleBatAimbotSpeed)
        if s and s == s and s > -math.huge and s < math.huge then
            CFG.ApproachSpeed = math.clamp(s, 1, 120)
        end
    end

