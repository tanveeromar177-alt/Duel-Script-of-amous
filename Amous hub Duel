	local function isProtected(obj) -- Evora __BubblePreserveOptimizerUI: never touch UI instances
		local node = obj
		while node and node ~= workspace and node ~= game do
			if node:IsA("LayerCollector") or node:IsA("BillboardGui") or node:IsA("SurfaceGui") or node:IsA("ScreenGui")
				or node:IsA("GuiObject") or node:IsA("UIComponent") then
				return true
			end
			node = node.Parent
		end
		return false
	end

	local function isPostEffect(obj)
		return obj:IsA("BlurEffect") or obj:IsA("SunRaysEffect") or obj:IsA("ColorCorrectionEffect")
			or obj:IsA("BloomEffect") or obj:IsA("DepthOfFieldEffect") or obj:IsA("BrightnessEffect")
			or obj:IsA("DitheringEffect")
	end

	-- Evora __BubbleWalkDescendantsBatched: depth-first over the children of the roots, 0.8 ms per Heartbeat
	local walkJobs, walkConn = {}, nil
	local function pumpWalk()
		if walkConn then return end
		walkConn = RunService.Heartbeat:Connect(function()
			local deadline = os.clock() + 0.0008
			while walkJobs[1] and os.clock() < deadline do
				local job = walkJobs[1]
				if job.cancelled or (job.alive and not job.alive()) then
					table.remove(walkJobs, 1)
				else
					local inst = job.pending[#job.pending]
					if not inst then
						table.remove(walkJobs, 1)
					else
						job.pending[#job.pending] = nil
						pcall(job.apply, inst)
						local ok, kids = pcall(inst.GetChildren, inst)
						if ok then
							for _, k in ipairs(kids) do job.pending[#job.pending + 1] = k end
						end
						if walkJobs[2] then
							table.remove(walkJobs, 1)
							walkJobs[#walkJobs + 1] = job
						end
					end
				end
			end
			if not walkJobs[1] and walkConn then
				walkConn:Disconnect()
				walkConn = nil
			end
		end)
	end

	local function walkBatched(roots, apply, alive)
		local job = { pending = {}, apply = apply, alive = alive, cancelled = false }
		for _, root in ipairs(roots) do
			local ok, kids = pcall(root.GetChildren, root)
			if ok then
				for _, k in ipairs(kids) do job.pending[#job.pending + 1] = k end
			end
		end
		walkJobs[#walkJobs + 1] = job
		pumpWalk()
		return function() job.cancelled = true end
	end

	-- ====================================================================== Anti Lag
	local antiLag = { on = false, conn = nil, cancelWalk = nil, gen = 0 }

	-- Evora NO ANIMATIONS: stop animators that are not part of any player character
	local noAnim = { enabled = false, saved = {}, conns = {} }
	local function isPlayerAnimator(animator)
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr.Character and animator:IsDescendantOf(plr.Character) then return true end
		end
		return false
	end
	local function stopAnimator(animator)
		pcall(function()
			for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
				if not isPlayerAnimator(animator) then
					noAnim.saved[#noAnim.saved + 1] = { track = track, speed = track.Speed }
					track:Stop(0)
				end
			end
		end)
	end
	local function setNoAnimations(enabled)
		noAnim.enabled = enabled
		for _, c in ipairs(noAnim.conns) do pcall(function() c:Disconnect() end) end
		noAnim.conns = {}
		if enabled then
			for _, obj in ipairs(workspace:GetDescendants()) do
				if obj:IsA("Animator") then stopAnimator(obj) end
			end
			noAnim.conns[#noAnim.conns + 1] = workspace.DescendantAdded:Connect(function(obj)
				task.defer(function()
					if not noAnim.enabled then return end
					if obj:IsA("Animator") then
						stopAnimator(obj)
					elseif obj:IsA("AnimationTrack") then
						local a = obj.Parent
						if a and a:IsA("Animator") then stopAnimator(a) end
					end
				end)
			end)
		else
			for _, e in ipairs(noAnim.saved) do
				pcall(function()
					if e.track and e.track.Parent then
						e.track:Play(0)
						e.track:AdjustSpeed(e.speed)
					end
				end)
			end
			noAnim.saved = {}
		end
	end

	local function flattenPart(part)
		part.Material = Enum.Material.Plastic
		part.Reflectance = 0
		part.CastShadow = false
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.FrontSurface = Enum.SurfaceType.Smooth
		part.BackSurface = Enum.SurfaceType.Smooth
		part.LeftSurface = Enum.SurfaceType.Smooth
		part.RightSurface = Enum.SurfaceType.Smooth
	end

	local function antiLagDerender(obj) -- Evora applyAntiLagDerender
		pcall(function()
			if obj:IsA("Sky") or obj:IsA("Atmosphere") or obj:IsA("Clouds") then return end
			if isProtected(obj) then return end
			if obj:IsA("Accessory") or obj:IsA("Hat") then
				local char = LocalPlayer.Character
				if char and obj:IsDescendantOf(char) then return end
				obj:Destroy()
			elseif obj:IsA("BasePart") then
				flattenPart(obj)
				for _, child in ipairs(obj:GetChildren()) do
					if child:IsA("Decal") or child:IsA("Texture") then child.Transparency = 0.5 end
				end
			elseif obj:IsA("Decal") or obj:IsA("Texture") then
				obj.Transparency = 0.5
			elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire")
				or obj:IsA("Smoke") or obj:IsA("Sparkles") then
				obj.Enabled = false
			elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
				obj.Enabled = false
			elseif obj:IsA("SelectionBox") then
				obj:Destroy()
			end
		end)
	end

	-- second pass of Evora's enableAntiLag loop (decals fully hidden, parts outside your character)
	local function antiLagSecondPass(obj)
		pcall(function()
			if obj:IsA("ParticleEmitter") then
				obj.Enabled = false
			elseif obj:IsA("Decal") then
				if isProtected(obj) then return end
				obj.Transparency = 1
			elseif obj:IsA("BasePart") then
				local char = LocalPlayer.Character
				if char and obj:IsDescendantOf(char) then return end
				if isProtected(obj) then return end
				flattenPart(obj)
			end
		end)
	end

	local function antiLagStop()
		if not antiLag.on then return end
		antiLag.on = false
		antiLag.gen += 1
		if antiLag.cancelWalk then antiLag.cancelWalk() antiLag.cancelWalk = nil end
		if antiLag.conn then antiLag.conn:Disconnect() antiLag.conn = nil end
		pcall(function() setNoAnimations(false) end)
		pcall(function()
			if _G.__WindDefLightBrightness then Lighting.Brightness = _G.__WindDefLightBrightness end
			if _G.__WindDefLightClock then Lighting.ClockTime = _G.__WindDefLightClock end
			if _G.__WindDefLightAmbient then Lighting.OutdoorAmbient = _G.__WindDefLightAmbient end
			Lighting.ExposureCompensation = 0
			Lighting.GlobalShadows = true
		end)
	end

	local function antiLagStart()
		if antiLag.on then return end
		antiLag.on = true
		antiLag.gen += 1
		local gen = antiLag.gen

		_G.__WindDefLightBrightness = _G.__WindDefLightBrightness or Lighting.Brightness
		_G.__WindDefLightClock = _G.__WindDefLightClock or Lighting.ClockTime
		_G.__WindDefLightAmbient = _G.__WindDefLightAmbient or Lighting.OutdoorAmbient

		pcall(function()
			settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
			settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Disabled
		end)
		pcall(function()
			Lighting.GlobalShadows = false
			Lighting.FogEnd = 1e10
			Lighting.FogStart = 0
			Lighting.Brightness = 1
			Lighting.EnvironmentDiffuseScale = 0
			Lighting.EnvironmentSpecularScale = 0
			Lighting.ShadowSoftness = 0
			Lighting.ExposureCompensation = 0
		end)
		pcall(function() Lighting.Technology = Enum.Technology.Compatibility end)
		for _, e in ipairs(Lighting:GetChildren()) do
			pcall(function()
				if isPostEffect(e) then e.Enabled = false end
			end)
		end

		antiLag.cancelWalk = walkBatched({ workspace }, function(obj)
			antiLagDerender(obj)
			antiLagSecondPass(obj)
		end, function() return antiLag.on and gen == antiLag.gen end)

		pcall(function()
			workspace.Terrain.WaterWaveSize = 0
			workspace.Terrain.WaterWaveSpeed = 0
			workspace.Terrain.WaterReflectance = 0
			workspace.Terrain.WaterTransparency = 0
			workspace.Terrain.Decoration = false
		end)

		if antiLag.conn then antiLag.conn:Disconnect() end
		antiLag.conn = workspace.DescendantAdded:Connect(function(obj)
			if not antiLag.on then return end
			if obj:IsA("Sky") or obj:IsA("Atmosphere") or obj:IsA("Clouds") then return end
			antiLagDerender(obj)
		end)

		setNoAnimations(true)
	end

	-- ====================================================================== Low Graphics (Evora Optimizer)
	local opt = {
		active = false, gen = 0, mode = OPTIMIZER_MODE, cancelWalk = nil,
		conns = {}, savedLight = {}, terrain = nil, decalUntil = 0, flagToken = 0,
	}

	local function optimizerMode()
		local m = _G.__WindOptimizerMode
		if m == "Normal" or m == "Ultra" then return m end
		return OPTIMIZER_MODE == "Normal" and "Normal" or "Ultra"
	end

	local function optimizeObject(obj) -- Evora Optimizer per-instance rule
		pcall(function()
			if isProtected(obj) then return end
			local char = LocalPlayer.Character
			if char and (obj == char or obj:IsDescendantOf(char)) then return end
			if obj:IsDescendantOf(Lighting) then return end
			if obj:IsA("Sky") or obj:IsA("Atmosphere") or obj:IsA("ColorCorrectionEffect") or obj:IsA("BloomEffect")
				or obj:IsA("BlurEffect") or obj:IsA("Sparkles") or obj:IsA("PostEffect") then
				return
			end
			if opt.mode ~= "Ultra" then
				if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") then
					obj.Enabled = false
				end
				if tick() <= opt.decalUntil and (obj:IsA("Decal") or obj:IsA("Texture")) then
					obj.Transparency = 1
				end
				return
			end
			if obj:IsA("Accessory") or obj:IsA("Hat") or obj:IsA("Clothing") or obj:IsA("Shirt") or obj:IsA("Pants")
				or obj:IsA("ShirtGraphic") then
				obj:Destroy()
			elseif obj:IsA("BasePart") then
				obj.Material = Enum.Material.Plastic
				obj.Reflectance = 0
				obj.CastShadow = false
			elseif obj:IsA("Decal") or obj:IsA("Texture") then
				obj.Transparency = 1
			elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire")
				or obj:IsA("Smoke") or obj:IsA("Sparkles") then
				obj.Enabled = false
			elseif obj:IsA("AnimationController") or obj:IsA("Animator") then
				for _, track in ipairs(obj:GetPlayingAnimationTracks()) do
					pcall(function() track:Stop(0) end)
				end
			end
		end)
	end

	local function optimizerStartWalk(gen)
		if opt.cancelWalk then opt.cancelWalk() end
		-- Evora also walked Lighting in Normal mode, but its rule skips everything under Lighting, so only workspace here
		opt.cancelWalk = walkBatched({ workspace }, optimizeObject, function() return opt.active and gen == opt.gen end)
	end

	local function optimizerApplyLighting()
		if opt.savedLight.Brightness == nil then
			opt.savedLight.Brightness = Lighting.Brightness
			opt.savedLight.ClockTime = Lighting.ClockTime
			opt.savedLight.OutdoorAmbient = Lighting.OutdoorAmbient
		end
		if opt.terrain == nil then
			local t = workspace:FindFirstChildOfClass("Terrain")
			if t then
				opt.terrain = {
					terrain = t, Decoration = t.Decoration, WaterWaveSize = t.WaterWaveSize,
					WaterWaveSpeed = t.WaterWaveSpeed, WaterReflectance = t.WaterReflectance,
				}
			end
		end
		if opt.mode == "Normal" then
			pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
			pcall(function()
				Lighting.GlobalShadows = false
				Lighting.EnvironmentDiffuseScale = 0
				Lighting.EnvironmentSpecularScale = 0
			end)
		else
			pcall(function()
				Lighting.GlobalShadows = false
				Lighting.FogEnd = 10000000000
				Lighting.Brightness = 1
				Lighting.EnvironmentDiffuseScale = 0
				Lighting.EnvironmentSpecularScale = 0
			end)
		end
		local t = opt.terrain and opt.terrain.terrain
		if t then
			pcall(function()
				t.Decoration = false
				t.WaterWaveSize = 0
				t.WaterWaveSpeed = 0
				t.WaterReflectance = 0
			end)
		end
		for _, child in ipairs(Lighting:GetChildren()) do
			if child:IsA("PostEffect") then pcall(function() child.Enabled = false end) end
		end
	end

	local function optimizerRestoreLighting()
		pcall(function()
			if opt.savedLight.Brightness ~= nil then
				Lighting.Brightness = opt.savedLight.Brightness
				Lighting.ClockTime = opt.savedLight.ClockTime
				Lighting.OutdoorAmbient = opt.savedLight.OutdoorAmbient
			end
			Lighting.ExposureCompensation = 0
			Lighting.GlobalShadows = true
			Lighting.FogEnd = 100000
			Lighting.EnvironmentDiffuseScale = 1
			Lighting.EnvironmentSpecularScale = 1
		end)
		local saved = opt.terrain
		if saved and saved.terrain then
			pcall(function()
				saved.terrain.Decoration = saved.Decoration
				saved.terrain.WaterWaveSize = saved.WaterWaveSize
				saved.terrain.WaterWaveSpeed = saved.WaterWaveSpeed
				saved.terrain.WaterReflectance = saved.WaterReflectance
			end)
		end
	end

	local function optimizerApplyFFlags(token)
		local env = (type(getgenv) == "function" and getgenv()) or _G
		local setf = rawget(env, "setfflag") or rawget(_G, "set_fflag")
		local getf = rawget(env, "getfflag") or rawget(_G, "get_fflag")
		if type(setf) ~= "function" then return end
		for i, pair in ipairs(OPTIMIZER_FFLAGS) do
			if not opt.active or token ~= opt.flagToken then return end
			local shouldSet = true
			if type(getf) == "function" then
				local ok, value = pcall(getf, pair[1])
				shouldSet = ok and value ~= nil
			end
			if shouldSet then pcall(setf, pair[1], pair[2]) end
			if i % 8 == 0 then RunService.Heartbeat:Wait() end
		end
	end

	local function optimizerStop()
		if not opt.active then return end
		opt.active = false
		opt.gen += 1
		opt.flagToken += 1
		if opt.cancelWalk then opt.cancelWalk() opt.cancelWalk = nil end
		for _, c in ipairs(opt.conns) do pcall(function() c:Disconnect() end) end
		opt.conns = {}
		optimizerRestoreLighting()
	end

	local function optimizerStart()
		if opt.active then return end
		opt.active = true
		opt.gen += 1
		local gen = opt.gen
		opt.mode = optimizerMode()
		if opt.mode == "Normal" then
			opt.decalUntil = tick() + 1
			opt.flagToken += 1
			local token = opt.flagToken
			task.spawn(optimizerApplyFFlags, token)
		end
		optimizerApplyLighting()
		optimizerStartWalk(gen)
		opt.conns[#opt.conns + 1] = workspace.DescendantAdded:Connect(function(obj)
			if opt.active and gen == opt.gen then optimizeObject(obj) end
		end)
		opt.conns[#opt.conns + 1] = LocalPlayer.CharacterAdded:Connect(function()
			task.delay(0.5, function()
				if opt.active and gen == opt.gen then optimizerStartWalk(gen) end
			end)
		end)
		task.spawn(function()
			while opt.active and gen == opt.gen do
				task.wait(20)
				if opt.active and gen == opt.gen then optimizerStartWalk(gen) end
			end
		end)
	end

	-- ---------------------------------------------------------------- wiring
	if _G.__WindGraphics and _G.__WindGraphics.Destroy then
		pcall(_G.__WindGraphics.Destroy) -- re-execute: drop the previous instance
	end
	_G.__WindGraphics = {
		Destroy = function()
			antiLagStop()
			optimizerStop()
		end,
	}

	local function bind(pill, label, onFn, offFn)
		if not pill then
			warn("[WIND] " .. label .. ": toggle pill missing, feature not wired")
			return
		end
		local function apply()
			if pillOn(pill) then onFn() else offFn() end
		end
		pill:GetAttributeChangedSignal("WaveToggleOn"):Connect(apply)
		apply()
	end
	bind(pillAntiLag, "Anti Lag", antiLagStart, antiLagStop)
	bind(pillLowGfx, "Low Graphics", optimizerStart, optimizerStop)
end

-- ==========================================================================
-- ADDED: VISUALS ported from Vx7
--   "ESP + Tracers" (WaveTogglePill_15) -> Vx7 Player ESP (Highlight + 2D box) AND Vx7 ESP Line, one switch for both.
--   "FOV" (WaveTogglePill_19) + slider (Frame_72..75, TextButton_32, TextLabel_43) -> Vx7 Camera Fov
--       (FieldOfView capped at 120 + camera pulled back by value / original FOV, same as Vx7 fn82).
--   "Stretch Rez" (WaveTogglePill_21) -> Vx7 Stretched Rez (camera Y scaled by 0.7, FieldOfView 100).
--   "Headless" (WaveTogglePill_20) and "Korblox" (TextButton_34) -> from ace_duel (see their sections below).
--   Config: the toggles are stored by the generic capture below; the FOV slider value and the Korblox mode go through
--           G.VisualsCtl (state.visuals), so autosave / Save Config / Load / Reset Config include it.
-- ==========================================================================
do
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	local lp = Players.LocalPlayer

	local ESP_COLOR = Color3.fromRGB(184, 36, 61) -- Wind accent (Vx7 used its theme colour)
	local ESP_GUI_NAME = "WindESP"
	local FOV_MIN, FOV_MAX, FOV_DEFAULT = 70, 200, 70
	local STRETCH_FOV = 100 -- Vx7 default resFov
	local STRETCH_Y = 0.7 -- Vx7 Y scale
	local CAMERA_STEP_NAME = "WIND_CameraFx"

	local function bindPill(pill, label, onFn, offFn)
		if not pill then
			warn("[WIND] " .. label .. ": toggle pill missing, feature not wired")
			return
		end
		local function apply()
			local ok, err = pcall(function()
				if pillOn(pill) then onFn() else offFn() end
			end)
			if not ok then warn("[WIND] " .. label .. ": " .. tostring(err)) end
		end
		pill:GetAttributeChangedSignal("WaveToggleOn"):Connect(apply)
		apply()
	end

	-- ------------------------------------------------------------------
	-- ESP Player (Highlight outline only, the 2D box was removed) + ESP Line (tracer), from Vx7
	-- ------------------------------------------------------------------
	local esp = { on = false, players = {}, gui = nil, stepConn = nil, addConn = nil, remConn = nil, repairAcc = 0 }

	local function espDestroy(inst)
		if inst then pcall(function() inst:Destroy() end) end
	end

	local function espClearPlayer(plr)
		local d = esp.players[plr]
		if not d then return end
		espDestroy(d.highlight)
		espDestroy(d.line)
		esp.players[plr] = nil
	end

	local function espEnsureGui()
		if esp.gui and esp.gui.Parent then return esp.gui end
		local pg = lp:FindFirstChildOfClass("PlayerGui")
		if not pg then return nil end
		espDestroy(pg:FindFirstChild(ESP_GUI_NAME)) -- leftover from a previous execution
		local sg = Instance.new("ScreenGui")
		sg.Name = ESP_GUI_NAME
		sg.ResetOnSpawn = false
		sg.IgnoreGuiInset = true
		sg.DisplayOrder = 998
		sg.ZIndexBehavior = Enum.ZIndexBehavior.Global
		sg.Parent = pg
		esp.gui = sg
		return sg
	end

	local function espEnsurePlayer(plr)
		if plr == lp then return end
		local sg = espEnsureGui()
		if not sg then return end
		local d = esp.players[plr]
		if not d then
			d = {}
			esp.players[plr] = d
		end
		if not d.line or not d.line.Parent then
			local line = Instance.new("Frame")
			line.AnchorPoint = Vector2.new(0.5, 0.5)
			line.BackgroundColor3 = ESP_COLOR
			line.BorderSizePixel = 0
			line.Visible = false
			line.ZIndex = 1
			line.Parent = sg
			d.line = line
		end
		local char = plr.Character
		if char then
			if not d.highlight or d.highlight.Parent ~= char then
				espDestroy(d.highlight)
				local h = Instance.new("Highlight")
				h.Name = "WindESPHighlight"
				h.Adornee = char
				h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				h.FillTransparency = 1 -- outline only (no fill), like the reference screenshot
				h.OutlineTransparency = 0
				h.FillColor = ESP_COLOR
				h.OutlineColor = ESP_COLOR
				h.Parent = char
				d.highlight = h
			end
		elseif d.highlight then
			espDestroy(d.highlight)
			d.highlight = nil
		end
	end

	local function espUpdate(dt)
		if not esp.on then return end
		local cam = workspace.CurrentCamera
		if not cam then return end

		esp.repairAcc += dt
		if esp.repairAcc >= 0.5 then -- picks up respawns, late joiners and deleted frames
			esp.repairAcc = 0
			for _, plr in ipairs(Players:GetPlayers()) do
				pcall(espEnsurePlayer, plr)
			end
		end

		local vp = cam.ViewportSize
		local origin = Vector2.new(vp.X / 2, vp.Y) -- bottom centre, used when your own character is not on screen
		local myChar = lp.Character
		local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
		if myRoot then
			local mp = cam:WorldToViewportPoint(myRoot.Position)
			if mp.Z > 0 then origin = Vector2.new(mp.X, mp.Y) end
		end

		for plr, d in pairs(esp.players) do
			local line = d.line
			if line then
				local char = plr.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if char and hum and root and hum.Health > 0 then
					-- tracer line (Vx7: mirrored when the target is behind the camera)
					local rp = cam:WorldToViewportPoint(root.Position)
					local tx, ty = rp.X, rp.Y
					if rp.Z < 0 then
						tx, ty = vp.X - tx, vp.Y - ty
					end
					local dx, dy = tx - origin.X, ty - origin.Y
					local len = math.sqrt(dx * dx + dy * dy)
					if len == len and len < 100000 then
						line.Position = UDim2.fromOffset((origin.X + tx) * 0.5, (origin.Y + ty) * 0.5)
						line.Size = UDim2.fromOffset(math.max(len, 1), 2)
						line.Rotation = math.deg(math.atan2(dy, dx))
						line.Visible = true
					else
						line.Visible = false
					end
				else
					line.Visible = false
				end
			end
		end
	end

	local function espStart()
		if esp.on then return end
		esp.on = true
		esp.repairAcc = 0
		espEnsureGui()
		for _, plr in ipairs(Players:GetPlayers()) do
			pcall(espEnsurePlayer, plr)
		end
		esp.addConn = Players.PlayerAdded:Connect(function(plr)
			pcall(espEnsurePlayer, plr)
		end)
		esp.remConn = Players.PlayerRemoving:Connect(espClearPlayer)
		esp.stepConn = RunService.RenderStepped:Connect(espUpdate)
	end

	local function espStop()
		esp.on = false
		for _, key in ipairs({ "stepConn", "addConn", "remConn" }) do
			local c = esp[key]
			if c then pcall(function() c:Disconnect() end) end
			esp[key] = nil
		end
		local list = {}
		for plr in pairs(esp.players) do list[#list + 1] = plr end
		for _, plr in ipairs(list) do espClearPlayer(plr) end
		espDestroy(esp.gui)
		esp.gui = nil
	end

	bindPill(G.WaveTogglePill_15, "ESP + Tracers", espStart, espStop)

	-- ------------------------------------------------------------------
	-- Camera FOV + Stretch Rez (one render step for both)
	-- ------------------------------------------------------------------
	local camFx = { fovOn = false, stretchOn = false, fovValue = FOV_DEFAULT, bound = false, saved = nil }

	local function camStep()
		local c = workspace.CurrentCamera
		if not c then return end
		if camFx.fovOn then
			local base = camFx.saved or 70
			c.FieldOfView = math.min(camFx.fovValue, 120)
			local focusPos, camPos = c.Focus.Position, c.CFrame.Position
			local diff = focusPos - camPos
			local mag = diff.Magnitude
			if mag > 0.001 then
				c.CFrame = CFrame.new(focusPos - diff.Unit * mag * (camFx.fovValue / base), focusPos)
			end
		end
		if camFx.stretchOn then
			c.CFrame = c.CFrame * CFrame.new(0, 0, 0, 1, 0, 0, 0, STRETCH_Y, 0, 0, 0, 1)
			if not camFx.fovOn then
				c.FieldOfView = STRETCH_FOV -- when FOV is also on, the FOV slider keeps priority
			end
		end
	end

	local function camRefresh()
		local want = camFx.fovOn or camFx.stretchOn
		if want and not camFx.bound then
			local c = workspace.CurrentCamera
			camFx.saved = c and c.FieldOfView or 70
			RunService:BindToRenderStep(CAMERA_STEP_NAME, Enum.RenderPriority.Camera.Value + 1, camStep)
			camFx.bound = true
		elseif not want and camFx.bound then
			pcall(function() RunService:UnbindFromRenderStep(CAMERA_STEP_NAME) end)
			camFx.bound = false
			local c = workspace.CurrentCamera
			if c and camFx.saved then c.FieldOfView = camFx.saved end -- back to what the game had before
			camFx.saved = nil
		end
	end

	bindPill(G.WaveTogglePill_19, "FOV", function()
		camFx.fovOn = true
		camRefresh()
	end, function()
		camFx.fovOn = false
		camRefresh()
	end)

	bindPill(G.WaveTogglePill_21, "Stretch Rez", function()
		camFx.stretchOn = true
		camRefresh()
	end, function()
		camFx.stretchOn = false
		camRefresh()
	end)

	-- ------------------------------------------------------------------
	-- FOV slider (UI existed in Wind but had no handlers)
	-- ------------------------------------------------------------------
	local track, fill, thumb, valueLabel, hit = G.Frame_73, G.Frame_74, G.Frame_75, G.TextLabel_43, G.TextButton_32

	local function setFov(v)
		v = tonumber(v)
		if not v or v ~= v then return end
		v = math.clamp(math.floor(v + 0.5), FOV_MIN, FOV_MAX)
		camFx.fovValue = v
		local r = (v - FOV_MIN) / (FOV_MAX - FOV_MIN)
		if fill then fill.Size = UDim2.new(r, 0, 1, 0) end
		if thumb then thumb.Position = UDim2.new(r, -6, 0.5, -6) end
		if valueLabel then valueLabel.Text = tostring(v) end
	end

	if track and hit then
		local dragging, dragInput = false, nil
		local page = G.WavePage_Visuals

		local function fromX(x)
			local w = track.AbsoluteSize.X
			if w <= 0 then return end
			local r = math.clamp((x - track.AbsolutePosition.X) / w, 0, 1)
			setFov(FOV_MIN + r * (FOV_MAX - FOV_MIN))
		end

		local function stopDrag()
			dragging, dragInput = false, nil
			if page then page.ScrollingEnabled = true end
		end

		hit.InputBegan:Connect(function(input)
			local t = input.UserInputType
			if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
				dragging, dragInput = true, input
				if page then page.ScrollingEnabled = false end -- keep the page from scrolling while the slider is dragged
				fromX(input.Position.X)
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if not dragging then return end
			if input.UserInputType == Enum.UserInputType.MouseMovement or input == dragInput then
				fromX(input.Position.X)
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if dragging and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseButton1) then
				stopDrag()
			end
		end)
	else
		warn("[WIND] FOV slider: track (Frame_73) or hit button (TextButton_32) missing, slider not wired")
	end

	setFov(FOV_DEFAULT)

	-- ------------------------------------------------------------------
	-- Headless (WaveTogglePill_20) -- from ace_duel "COSMETICS / Headless"
	--   client-side only: head + its decals/parts get Transparency and LocalTransparencyModifier = 1
	-- ------------------------------------------------------------------
	local headless = { on = false }

	local function headlessApply(char)
		char = char or lp.Character
		local head = char and char:FindFirstChild("Head")
		if not head then return end
		local t = headless.on and 1 or 0
		head.Transparency = t
		head.LocalTransparencyModifier = t
		for _, child in ipairs(head:GetChildren()) do
			if child:IsA("Decal") or child:IsA("Texture") then
				child.Transparency = t
			elseif child:IsA("BasePart") then
				child.Transparency = t
				child.LocalTransparencyModifier = t
			end
		end
	end

	local function headlessWatch(char)
		task.spawn(function()
			char:WaitForChild("Head", 10)
			for _ = 1, 40 do -- the game's own character scripts may reset the head right after spawn
				if not char.Parent then break end
				if headless.on then headlessApply(char) end
				task.wait(0.25)
			end
		end)
		char.DescendantAdded:Connect(function()
			if headless.on then task.defer(headlessApply, char) end
		end)
	end

	if lp.Character then headlessWatch(lp.Character) end
	lp.CharacterAdded:Connect(headlessWatch)

	bindPill(G.WaveTogglePill_20, "Headless", function()
		headless.on = true
		headlessApply()
	end, function()
		headless.on = false
		headlessApply()
	end)

	-- ------------------------------------------------------------------
	-- Korblox (button TextButton_34: Off -> Left -> Right -> Both) -- from ace_duel "_RaVeKorblox*"
	--   R15 only (needs LeftUpperLeg / RightUpperLeg); the leg meshes come from game:GetObjects (executor function).
	--   ace_duel constants resolved from its L1.v52 table: scale 1,1,1 / offset identity / CanQuery false /
	--   Massless true / equip sound removed after 3 s.
	-- ------------------------------------------------------------------
	local KORBLOX_ORDER = { "Off", "Left", "Right", "Both" }
	local KORBLOX_ASSETS = {
		["Left Leg"] = {
			id = "rbxassetid://139607673",
			target = "LeftUpperLeg",
			hide = { "LeftUpperLeg", "LeftLowerLeg", "LeftFoot" },
			audio = "rbxassetid://87998522263554",
			name = "Korblox_LeftLeg",
		},
		["Right Leg"] = {
			id = "rbxassetid://139607718",
			target = "RightUpperLeg",
			hide = { "RightUpperLeg", "RightLowerLeg", "RightFoot" },
			audio = "rbxassetid://135315310485417",
			name = "Korblox_RightLeg",
		},
	}
	local korblox = { mode = "Off", gen = 0 }
	local korbloxBtn = G.TextButton_34

	local function korbloxClear()
		local char = lp.Character
		if not char then return end
		espDestroy(char:FindFirstChild("Korblox_LeftLeg"))
		espDestroy(char:FindFirstChild("Korblox_RightLeg"))
		for _, n in ipairs({ "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot" }) do
			local p = char:FindFirstChild(n)
			if p and p:IsA("BasePart") then
				p.Transparency = 0
				p.LocalTransparencyModifier = 0
			end
		end
	end

	local function korbloxAttach(key, gen)
		local spec = KORBLOX_ASSETS[key]
		local char = lp.Character
		if not spec or not char then return false end
		local target = char:FindFirstChild(spec.target)
		if not target then return false end -- R6 character: no *UpperLeg parts
		local ok, result = pcall(function()
			return game:GetObjects(spec.id)
		end)
		if not ok or type(result) ~= "table" or #result == 0 then
			warn("[WIND] Korblox: could not load " .. spec.id .. " (game:GetObjects failed)")
			return false
		end
		local obj = result[1]
		-- GetObjects yields: drop the result when the mode changed or the character was replaced meanwhile
		if gen ~= korblox.gen or lp.Character ~= char or not target.Parent then
			espDestroy(obj)
			return false
		end
		local mesh = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
		if not mesh then
			espDestroy(obj)
			return false
		end
		espDestroy(char:FindFirstChild(spec.name))
		for _, n in ipairs(spec.hide) do
			local p = char:FindFirstChild(n)
			if p and p:IsA("BasePart") then p.Transparency = 1 end
		end
		obj.Name = spec.name
		mesh.CanCollide = false
		mesh.CanTouch = false
		mesh.CanQuery = false
		mesh.Massless = true
		mesh.CFrame = target.CFrame
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = target
		weld.Part1 = mesh
		weld.Parent = mesh
		obj.Parent = char
		local sound = Instance.new("Sound")
		sound.SoundId = spec.audio
		sound.Volume = 0.5
		sound.Parent = mesh
		sound:Play()
		game:GetService("Debris"):AddItem(sound, 3)
		return true
	end

	local function korbloxApply(mode)
		if mode ~= "Left" and mode ~= "Right" and mode ~= "Both" then mode = "Off" end
		korblox.mode = mode
		korblox.gen += 1
		local gen = korblox.gen
		if korbloxBtn then korbloxBtn.Text = mode end
		korbloxClear()
		task.spawn(function()
			if mode == "Left" or mode == "Both" then
				pcall(korbloxAttach, "Left Leg", gen)
			end
			if mode == "Right" or mode == "Both" then
				pcall(korbloxAttach, "Right Leg", gen)
			end
		end)
	end

	if korbloxBtn then
		korbloxBtn.Text = korblox.mode
		korbloxBtn.MouseButton1Click:Connect(function()
			local idx = table.find(KORBLOX_ORDER, korblox.mode) or 1
			korbloxApply(KORBLOX_ORDER[idx % #KORBLOX_ORDER + 1])
		end)
	else
		warn("[WIND] Korblox: button (TextButton_34) missing, feature not wired")
	end

	lp.CharacterAdded:Connect(function()
		task.wait(0.6)
		if korblox.mode ~= "Off" then
			korbloxApply(korblox.mode)
		end
	end)

	-- read by captureState / applyState in the config section below
	G.VisualsCtl = {
		getState = function()
			return { fov = camFx.fovValue, korblox = korblox.mode }
		end,
		setState = function(s)
			if type(s) ~= "table" then return end
			if type(s.fov) == "number" then
				setFov(s.fov)
			end
			if type(s.korblox) == "string" and table.find(KORBLOX_ORDER, s.korblox) and s.korblox ~= korblox.mode then
				korbloxApply(s.korblox)
			end
		end,
	}
end

