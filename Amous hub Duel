-- ========== SHOW PANEL ==========
-- ON : box behind the mobile buttons; while the UI is unlocked, dragging the box or any button moves the whole panel.
-- OFF: box hidden; every button moves on its own again.
do
	local PANEL_PAD = 14 -- box padding around the buttons, in panel units (default layout gives exactly the 154x290 panel)

	local function updatePanelBox()
		local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
		for _, pair in ipairs(stackDragPairs) do
			local p, sz = pair[1].Position, pair[1].Size
			minX = math.min(minX, p.X.Offset)
			minY = math.min(minY, p.Y.Offset)
			maxX = math.max(maxX, p.X.Offset + sz.X.Offset)
			maxY = math.max(maxY, p.Y.Offset + sz.Y.Offset)
		end
		if minX == math.huge then return end
		G.StackPanelBox.Position = UDim2.fromOffset(minX - PANEL_PAD, minY - PANEL_PAD)
		G.StackPanelBox.Size = UDim2.fromOffset(maxX - minX + PANEL_PAD * 2, maxY - minY + PANEL_PAD * 2)
	end

	local function refreshPanel()
		local locked = G.WaveTogglePill_35:GetAttribute("WaveToggleOn") == true
		stackPanelOn = G.WaveTogglePill_ShowPanel:GetAttribute("WaveToggleOn") == true
		G.StackPanelBox.Visible = stackPanelOn
		-- only catches touches while it can actually be dragged, so a locked panel never blocks the game
		G.StackPanelBox.Active = stackPanelOn and not locked
		if stackPanelOn then updatePanelBox() end
	end

	for _, pair in ipairs(stackDragPairs) do
		pair[1]:GetPropertyChangedSignal("Position"):Connect(function()
			if stackPanelOn then updatePanelBox() end
		end)
		pair[1]:GetPropertyChangedSignal("Size"):Connect(function()
			if stackPanelOn then updatePanelBox() end
		end)
	end
	G.WaveTogglePill_ShowPanel:GetAttributeChangedSignal("WaveToggleOn"):Connect(refreshPanel)
	G.WaveTogglePill_35:GetAttributeChangedSignal("WaveToggleOn"):Connect(refreshPanel)

	local panelHandles, panelMarks = { G.StackPanelBox }, {}
	for _, pair in ipairs(stackDragPairs) do
		table.insert(panelHandles, pair[1])
		table.insert(panelHandles, pair[2])
		table.insert(panelMarks, pair[1])
	end
	makeDraggable(G.MobileStackPanel, panelHandles, function() return stackPanelOn end, panelMarks)

	refreshPanel()
