    -- Two columns on every tab: first half of the rows in the left column, the rest in the right one
    local function splitPageIntoColumns(page)
        local items = {}
        for _, c in ipairs(page:GetChildren()) do
            if c:IsA("GuiObject") then items[#items + 1] = c end
        end
        if #items == 0 then return end
        table.sort(items, function(a, b) return a.LayoutOrder < b.LayoutOrder end)

        local holder = Instance.new("Frame")
        holder.Name = "Columns"
        holder.Size = UDim2.new(1, 0, 0, 0)
        holder.AutomaticSize = Enum.AutomaticSize.Y
        holder.BackgroundTransparency = 1
        holder.BorderSizePixel = 0
        holder.LayoutOrder = 1
        holder.ZIndex = 6
        local hl = Instance.new("UIListLayout", holder)
        hl.FillDirection = Enum.FillDirection.Horizontal
        hl.SortOrder = Enum.SortOrder.LayoutOrder
        hl.VerticalAlignment = Enum.VerticalAlignment.Top
        hl.Padding = UDim.new(0, 6)

        local function mkColumn(name, order)
            local col = Instance.new("Frame")
            col.Name = name
            col.Size = UDim2.new(0.5, -3, 0, 0)
            col.AutomaticSize = Enum.AutomaticSize.Y
            col.BackgroundTransparency = 1
            col.BorderSizePixel = 0
            col.LayoutOrder = order
            col.ZIndex = 6
            local cl = Instance.new("UIListLayout", col)
            cl.SortOrder = Enum.SortOrder.LayoutOrder
            cl.Padding = UDim.new(0, 6)
            cl.HorizontalAlignment = Enum.HorizontalAlignment.Center
            col.Parent = holder
            return col
        end
        local left = mkColumn("ColLeft", 1)
        local right = mkColumn("ColRight", 2)

        local heights, total = {}, 0
        for i, it in ipairs(items) do
            heights[i] = it.Size.Y.Offset + 6
            total = total + heights[i]
        end
        local splitAt, bestScore, acc = #items, math.huge, 0
        for k = 1, #items - 1 do
            acc = acc + heights[k]
            if items[k].Name ~= "SectionHeader" then
                local score = math.abs(acc - total / 2)
                if items[k + 1].Name ~= "SectionHeader" then score = score + 40 end
                if score < bestScore then bestScore = score; splitAt = k end
            end
        end

        for i, it in ipairs(items) do
            it.Parent = (i <= splitAt) and left or right
        end
        holder.Parent = page
    end
    for _, pg in pairs(contentPages) do
        pcall(splitPageIntoColumns, pg)
    end

