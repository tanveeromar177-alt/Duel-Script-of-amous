function paintFloatingBtn(btnFrame, active)
    if not btnFrame then return end
    local bg = btnFrame:FindFirstChild("BtnGrad")
    local label = btnFrame:FindFirstChild("TextLabel") or btnFrame:FindFirstChildWhichIsA("TextLabel")
    local stroke = btnFrame:FindFirstChildOfClass("UIStroke")

    local BTN_ON_TRANSPARENCY  = 0.03
    local BTN_OFF_TRANSPARENCY = 0.03
    local BTN_OFF_COLOR = Color3.fromRGB(27, 29, 26) -- sampled from reference image (RAL 7021 black grey)

    if active then
        -- ON: white background (semi-transparent), black text
        btnFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        btnFrame.BackgroundTransparency = BTN_ON_TRANSPARENCY
        if bg then
            bg.Enabled = false
        end
        if label then
            label.TextColor3 = Color3.fromRGB(0, 0, 0)
            label.TextStrokeTransparency = 1
        end
        if stroke then
            stroke.Color = Color3.fromRGB(255, 255, 255)
            stroke.Thickness = 1.5
            stroke.Transparency = 0
        end
    else
        -- OFF: light gray background (semi-transparent), white text
        btnFrame.BackgroundColor3 = BTN_OFF_COLOR
        btnFrame.BackgroundTransparency = BTN_OFF_TRANSPARENCY
