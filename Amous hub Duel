-- ═══════════════════════════════════════════════════════════════
-- BAT AIMBOT (Bubble Hub) — ported from Bubble Hub's final "Cypher" aimbot
-- Chases the nearest living player with ping-compensated prediction, turns
-- the character with angular velocity and swings the bat when in range.
-- Replaces the old Bat Bypass module. The hub-side names (enableBatV2,
-- disableBatV2, toggleBatV2, autoBatV2Enabled, KB.BatV2, floating button)
-- are kept so the GUI, keybind, config and safe-mode code keep working.
-- Not ported (Bubble-only systems that Haze does not have): TP Bat marker
-- chase and the auto-drop-before-start step.
-- ═══════════════════════════════════════════════════════════════
do
    local previous = _G.HazeBubbleBatAimbot
    if type(previous) == "table" and type(previous.Stop) == "function" then
        pcall(previous.Stop)
    end

    local Bat = { Enabled = false, Connection = nil }
    _G.HazeBubbleBatAimbot = Bat

    -- Same values as Bubble Hub (CypherAimbotApproachSpeed = 55, clamp 1..120)
    local CFG = {
        ApproachSpeed                   = 55,
        ACTIVATE_DISTANCE               = 13,
        MIN_FOLLOW_DISTANCE             = 1,
        PREDICTION_TIME                 = 0.22,
        PREDICT_AHEAD                   = 3,
        MAX_VELOCITY_CHANGE             = 150,
        VELOCITY_SMOOTHING              = 0.2,
        MAX_HORIZONTAL_VELOCITY         = 80,
        SERVER_TICKRATE                 = 1 / 60,
        MIN_PING_COMPENSATION           = 0.03,
        MAX_PING_COMPENSATION           = 0.25,
        ACCELERATION_PREDICTION_WEIGHT  = 0.3,
        DIRECTION_CHANGE_DETECTION_TIME = 0.12,
        QUICK_DIRECTION_CHANGE_MULTIPLIER = 1.5,
        GRAVITY                         = 196.2,
        AIR_CONTROL_FACTOR              = 0.8,
        MIN_AIRBORNE_TIME               = 0.08,
    }
    Bat.Config = CFG

    local S = {
        targetPlayer          = nil,
        lastTargetPos         = nil,
        targetVelocity        = Vector3.zero,
        smoothedVelocity      = Vector3.zero,
        accelerationHistory   = {},
        aerialVelocityHistory = {},
        previousDirection     = nil,
        lastDirectionChangeTime = 0,
        airborneTime          = 0,
        lastActivationTime    = 0,
        currentPing           = 0.1,
        realPingMs            = 0,
    }

    local function average(list)
        if #list == 0 then return Vector3.zero end
        local total = Vector3.zero
        for _, v in ipairs(list) do total += v end
        return total / #list
    end

    local function push(list, value, maximum)
        table.insert(list, value)
        if #list > maximum then table.remove(list, 1) end
    end

    local function resetTarget()
        S.targetPlayer          = nil
        S.lastTargetPos         = nil
        S.targetVelocity        = Vector3.zero
        S.smoothedVelocity      = Vector3.zero
        S.accelerationHistory   = {}
        S.aerialVelocityHistory = {}
        S.previousDirection     = nil
        S.airborneTime          = 0
    end

    local function findBat()
        local char = LP.Character
        if not char then return nil end
        local equipped = char:FindFirstChildOfClass("Tool")
        if equipped then
            local n = equipped.Name:lower()
            if n:find("bat", 1, true) or n:find("slap", 1, true) then return equipped end
        end
        local backpack = LP:FindFirstChildOfClass("Backpack")
        if backpack then
            for _, tool in ipairs(backpack:GetChildren()) do
                if tool:IsA("Tool") then
                    local n = tool.Name:lower()
                    if n:find("bat", 1, true) or n:find("slap", 1, true) then return tool end
                end
            end
        end
        return nil
    end
    Bat.FindBat = findBat

    local function nearestTarget(root)
        local nearest, nearestDistance = nil, math.huge
        for _, candidate in ipairs(Players:GetPlayers()) do
            if candidate ~= LP and candidate.Character then
                local targetRoot = candidate.Character:FindFirstChild("HumanoidRootPart")
                local targetHum  = candidate.Character:FindFirstChildOfClass("Humanoid")
                if targetRoot and targetHum and targetHum.Health > 0 then
                    local distance = (root.Position - targetRoot.Position).Magnitude
                    if distance < nearestDistance then
                        nearest, nearestDistance = candidate, distance
                    end
                end
            end
        end
        return nearest
    end

    local function rotateRoot(root, direction)
        if direction.Magnitude < 0.01 then return end
        local axis  = root.CFrame.LookVector:Cross(direction.Unit)
        local angle = math.asin(math.clamp(axis.Magnitude, -1, 1))
        root.AssemblyAngularVelocity = axis.Magnitude > 0.01
            and axis.Unit * angle * 80
            or  Vector3.zero
    end

    local function samplePing()
        local ok, value = pcall(function()
            return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        if ok and type(value) == "number" then S.realPingMs = math.floor(value) end
        S.currentPing = math.clamp(S.realPingMs / 1000, CFG.MIN_PING_COMPENSATION, CFG.MAX_PING_COMPENSATION)
    end

    task.spawn(function()
        while _G.HazeBubbleBatAimbot == Bat do
            pcall(samplePing)
            task.wait(0.5)
        end
    end)

    function Bat.Stop()
        Bat.Enabled = false
        if Bat.Connection then
            Bat.Connection:Disconnect()
            Bat.Connection = nil
        end
        local char = LP.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if humanoid then humanoid.AutoRotate = true end
        if root then root.AssemblyAngularVelocity = Vector3.zero end
        resetTarget()
        S.lastActivationTime = 0
    end

    function Bat.Start(character)
        character = character or LP.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not root then return false end

        Bat.Stop()
        Bat.Enabled = true
        humanoid.AutoRotate = false

        local startBat = findBat()
        if startBat and startBat.Parent ~= character then
            pcall(humanoid.EquipTool, humanoid, startBat)
        end

        Bat.Connection = RunService.RenderStepped:Connect(function(dt)
            if not Bat.Enabled then Bat.Stop() return end

            local char = LP.Character
            local myRoot = char and char:FindFirstChild("HumanoidRootPart")
            local myHum  = char and char:FindFirstChildOfClass("Humanoid")
            if not myRoot or not myHum or myHum.Health <= 0 then return end

            myHum.AutoRotate = false

            local tool = char:FindFirstChildOfClass("Tool") or findBat()
            if tool and tool.Parent ~= char then
                pcall(myHum.EquipTool, myHum, tool)
            end

            S.targetPlayer = nearestTarget(myRoot)
            local targetChar = S.targetPlayer and S.targetPlayer.Character
            local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
            local targetHum  = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
            if not targetRoot or not targetHum or targetHum.Health <= 0 then
                resetTarget()
                return
            end

            local targetPos = targetRoot.Position
            local safeDt = math.max(dt, 1 / 240)

            if S.lastTargetPos then
                local rawVelocity = (targetPos - S.lastTargetPos) / safeDt
                local velocityDelta = rawVelocity - S.targetVelocity
                if velocityDelta.Magnitude > CFG.MAX_VELOCITY_CHANGE then
                    rawVelocity = S.targetVelocity + velocityDelta.Unit * CFG.MAX_VELOCITY_CHANGE
                end
                local horizontal = Vector3.new(rawVelocity.X, 0, rawVelocity.Z)
                if horizontal.Magnitude > CFG.MAX_HORIZONTAL_VELOCITY then
                    horizontal = horizontal.Unit * CFG.MAX_HORIZONTAL_VELOCITY
                    rawVelocity = Vector3.new(horizontal.X, rawVelocity.Y, horizontal.Z)
                end
                push(S.accelerationHistory, (rawVelocity - S.targetVelocity) / safeDt, 4)
                S.targetVelocity = rawVelocity
                S.smoothedVelocity = S.smoothedVelocity:Lerp(rawVelocity, CFG.VELOCITY_SMOOTHING)
            end
            S.lastTargetPos = targetPos

            local airborne = targetHum.FloorMaterial == Enum.Material.Air
            S.airborneTime = airborne and (S.airborneTime + safeDt) or 0
            if airborne and S.airborneTime >= CFG.MIN_AIRBORNE_TIME then
                push(S.aerialVelocityHistory, S.targetVelocity, 6)
            elseif not airborne then
                S.aerialVelocityHistory = {}
            end

            local predictionVelocity = S.smoothedVelocity
            if airborne and #S.aerialVelocityHistory > 0 then
                local aerial = average(S.aerialVelocityHistory)
                predictionVelocity = Vector3.new(aerial.X, S.targetVelocity.Y, aerial.Z) * CFG.AIR_CONTROL_FACTOR
            end

            local quickTurn = false
            local horizontalVelocity = Vector3.new(S.targetVelocity.X, 0, S.targetVelocity.Z)
            if horizontalVelocity.Magnitude > 5 then
                local direction = horizontalVelocity.Unit
                if S.previousDirection and S.previousDirection:Dot(direction) < 0.5 then
                    quickTurn = tick() - S.lastDirectionChangeTime < CFG.DIRECTION_CHANGE_DETECTION_TIME
                    S.lastDirectionChangeTime = tick()
                end
                S.previousDirection = direction
            end

            local delay = S.currentPing + CFG.SERVER_TICKRATE
            if quickTurn then delay = delay * CFG.QUICK_DIRECTION_CHANGE_MULTIPLIER end

            local predicted = targetPos
                + predictionVelocity * delay
                + average(S.accelerationHistory) * CFG.ACCELERATION_PREDICTION_WEIGHT * (delay * delay * 0.5)

            local predictionTime = CFG.PREDICTION_TIME * 1.1
            if airborne then
                predicted = predicted + predictionVelocity * predictionTime
                    + Vector3.new(0, -0.5 * CFG.GRAVITY * predictionTime * predictionTime, 0)
            else
                predicted = predicted + predictionVelocity * predictionTime
            end

            local flat = Vector3.new(predictionVelocity.X, 0, predictionVelocity.Z)
            if flat.Magnitude > 1 then
                predicted = predicted + flat.Unit * CFG.PREDICT_AHEAD
            end

            local toTarget = predicted - myRoot.Position
            rotateRoot(myRoot, toTarget)

            if (targetPos - myRoot.Position).Magnitude <= CFG.ACTIVATE_DISTANCE
            and tick() - S.lastActivationTime >= 0.3 then
                if tool then pcall(tool.Activate, tool) end
                S.lastActivationTime = tick()
            end

            if toTarget.Magnitude > CFG.MIN_FOLLOW_DISTANCE then
                local speed = math.clamp(tonumber(CFG.ApproachSpeed) or 55, 1, 120)
                myRoot.AssemblyLinearVelocity = toTarget.Unit * speed
            else
                myRoot.AssemblyLinearVelocity = Vector3.new(0, myRoot.AssemblyLinearVelocity.Y * 0.5, 0)
            end
        end)
        return true
    end

