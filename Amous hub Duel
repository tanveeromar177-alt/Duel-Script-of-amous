	local OBJ_NAME = "WindSky"
	local DEFAULT_MODE = "blue"
	local LIGHT_PROPS = { "Ambient", "Brightness", "ClockTime", "FogColor", "FogEnd", "GlobalShadows", "EnvironmentDiffuseScale", "EnvironmentSpecularScale", "OutdoorAmbient" }

	local pill = G.WaveTogglePill_Sky
	local prevBtn, nextBtn, nameLbl = G.TextButton_SkyPrev, G.TextButton_SkyNext, G.TextLabel_SkyName

	local sky = { mode = DEFAULT_MODE, on = false, snap = nil, objs = {}, cc = nil }

	local function displayName(m)
		if m == "day" then return "Day" end
		if m == "blue" then return "Blue" end
		if m == "night" then return "Night" end
		return m
	end

	local function c3(t) return Color3.fromRGB(t[1], t[2], t[3]) end

	local function set(obj, prop, value) -- one bad property must not stop the rest of the theme
		local ok, err = pcall(function() obj[prop] = value end)
		if not ok then warn("[WIND] Sky: could not set " .. obj.ClassName .. "." .. prop .. ": " .. tostring(err)) end
	end

	local function destroyObj(o)
		if o then pcall(function() o:Destroy() end) end
	end

	local function clearObjs()
		destroyObj(sky.cc)
		sky.cc = nil
		for _, o in ipairs(sky.objs) do destroyObj(o) end
		sky.objs = {}
	end

	-- objects left behind by a previous execution of this script
	for _, parent in ipairs({ Lighting, workspace:FindFirstChildOfClass("Terrain") }) do
		if parent then
			for _, ch in ipairs(parent:GetChildren()) do
				if ch.Name == OBJ_NAME then destroyObj(ch) end
			end
		end
	end

	local function snapshotLighting()
		if sky.snap then return end
		local s = {}
		for _, p in ipairs(LIGHT_PROPS) do
			local ok, v = pcall(function() return Lighting[p] end)
			if ok then s[p] = v end
		end
		sky.snap = s
	end

	local function restoreLighting()
		if not sky.snap then return end
		for p, v in pairs(sky.snap) do
			pcall(function() Lighting[p] = v end)
		end
	end

	local function applyMode(mode)
		clearObjs()
		snapshotLighting()
		restoreLighting()

		local pre = PRESETS[mode]
		if pre and not pre.kind then
			-- colour preset (Evora: Lighting values + Sky + Atmosphere + Clouds)
			set(Lighting, "FogEnd", 100000)
			set(Lighting, "GlobalShadows", true)
			set(Lighting, "ClockTime", pre.clock or 14)
			set(Lighting, "Brightness", pre.brightness or 2)
			if pre.outAmb then set(Lighting, "OutdoorAmbient", c3(pre.outAmb)) end
			if pre.ambient then set(Lighting, "Ambient", c3(pre.ambient)) end

			if pre.sky then
				local sk = Instance.new("Sky")
				sk.Name = OBJ_NAME
				if pre.sky.stars then set(sk, "StarCount", math.clamp(pre.sky.stars, 0, 5000)) end
				if pre.sky.moon then set(sk, "MoonAngularSize", pre.sky.moon) end
				if pre.sky.sun then set(sk, "SunAngularSize", pre.sky.sun) end
				if pre.sky.moonTex then set(sk, "MoonTextureId", "rbxasset://sky/moon.jpg") end
				sk.Parent = Lighting
				table.insert(sky.objs, sk)
			end

			if pre.atm then
				local at = Instance.new("Atmosphere")
				at.Name = OBJ_NAME
				set(at, "Density", pre.atm.dens or 0.3)
				set(at, "Color", c3(pre.atm.color))
				set(at, "Decay", c3(pre.atm.decay))
				set(at, "Glare", pre.atm.glare or 1)
				set(at, "Haze", pre.atm.haze or 1)
				at.Parent = Lighting
				table.insert(sky.objs, at)
			end

			local terrain = workspace:FindFirstChildOfClass("Terrain")
			if pre.clouds and terrain then
				local cl = Instance.new("Clouds")
				cl.Name = OBJ_NAME
				set(cl, "Cover", pre.clouds.cover or 0.5)
				set(cl, "Density", pre.clouds.dens or 0.5)
				set(cl, "Color", c3(pre.clouds.color))
				cl.Parent = terrain
				table.insert(sky.objs, cl)
			end
			return
		end

		-- classic modes (Evora: ColorCorrectionEffect)
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Name = OBJ_NAME
		cc.Parent = Lighting
		sky.cc = cc
		if mode == "blue" then
			set(Lighting, "Ambient", Color3.fromRGB(30, 60, 120))
			set(Lighting, "FogColor", Color3.fromRGB(40, 80, 160))
			set(cc, "TintColor", Color3.fromRGB(140, 180, 255))
			set(cc, "Saturation", 0.4)
			set(cc, "Contrast", 0.1)
		elseif mode == "night" then
			set(Lighting, "ClockTime", 0)
			set(Lighting, "Brightness", 0.2)
			set(Lighting, "Ambient", Color3.fromRGB(20, 20, 35))
			set(cc, "TintColor", Color3.fromRGB(180, 180, 220))
			set(cc, "Saturation", -0.2)
			set(cc, "Contrast", 0.1)
		elseif mode == "day" then
			set(Lighting, "ClockTime", 14)
			set(Lighting, "Brightness", 2)
			set(Lighting, "Ambient", Color3.fromRGB(140, 140, 140))
			set(cc, "TintColor", Color3.fromRGB(255, 255, 255))
			set(cc, "Saturation", 0.1)
			set(cc, "Contrast", 0)
		end
	end

	local function skyEnable()
		sky.on = true
		applyMode(sky.mode)
	end

	local function skyDisable()
		sky.on = false
		clearObjs()
		restoreLighting()
		sky.snap = nil
	end

	local function setMode(mode)
		if type(mode) ~= "string" or not table.find(ORDER, mode) then return false end
		sky.mode = mode
		if nameLbl then nameLbl.Text = displayName(mode) end
		if sky.on then applyMode(mode) end
		return true
	end

	local function stepMode(d)
		local idx = table.find(ORDER, sky.mode) or 1
		idx = (idx - 1 + d) % #ORDER + 1
		setMode(ORDER[idx])
		if not sky.on and pill then
			setToggleVisual(pill, true) -- the attribute signal below calls skyEnable
		end
	end

	if nameLbl then nameLbl.Text = displayName(sky.mode) end

	if pill then
		pill:GetAttributeChangedSignal("WaveToggleOn"):Connect(function()
			local want = pill:GetAttribute("WaveToggleOn") == true
			if want and not sky.on then
				skyEnable()
			elseif not want and sky.on then
				skyDisable()
			end
		end)
	else
		warn("[WIND] Sky Changer: toggle pill (WaveTogglePill_Sky) missing, feature not wired")
	end

	if prevBtn and nextBtn then
		prevBtn.MouseButton1Click:Connect(function() stepMode(-1) end)
		nextBtn.MouseButton1Click:Connect(function() stepMode(1) end)
	else
		warn("[WIND] Sky Changer: arrow buttons missing, theme row not wired")
	end

	-- Anti Lag (WaveTogglePill_13) and Low Graphics (WaveTogglePill_14) write Lighting values: put the theme back afterwards
	for _, p in ipairs({ G.WaveTogglePill_13, G.WaveTogglePill_14 }) do
		if p then
			p:GetAttributeChangedSignal("WaveToggleOn"):Connect(function()
				task.delay(0.6, function()
					if sky.on then applyMode(sky.mode) end
				end)
			end)
		end
	end

	-- config: the chosen theme rides along with the other visuals values (G.VisualsCtl is created in the Visuals section above)
	if G.VisualsCtl then
		local prevGet, prevSet = G.VisualsCtl.getState, G.VisualsCtl.setState
		G.VisualsCtl.getState = function()
			local s = prevGet and prevGet() or {}
			s.sky = sky.mode
			return s
		end
		G.VisualsCtl.setState = function(s)
			if prevSet then prevSet(s) end
			if type(s) == "table" and type(s.sky) == "string" then setMode(s.sky) end
		end
	else
		warn("[WIND] Sky Changer: G.VisualsCtl missing, the sky theme will not be saved in the config")
	end
end

