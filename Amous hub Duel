-- ADDED: X-RAY BASE (Visuals page, below "ESP + Tracers")
--   Taken from Ambitious (ambitious_hub.txt, "X-RAY" section / setXRay), same logic and same numbers:
--     * every plot in workspace.Plots: the folders Base, PlotSign, FriendPanel, Cash, Laser, Decorations, Skin, Unlock,
--       Purchases, plus in AnimalPodiums: each podium's Claim, Base.Decorations and every Model except "Decorations"
--     * parts / GUI objects there get transparency moved 50 % of the way to 1 (alpha 0.5); parts that are already fully
--       transparent are left alone
--     * new objects that appear later (DescendantAdded / ChildAdded, new plots) get the same treatment
--     * switching OFF puts every touched object back to its ORIGINAL transparency (strong snapshot table, as in Ambitious)
--   Differences from Ambitious (on purpose): state lives in locals of this block instead of _G._AmbitiousXRay*, so Wind and
--   Ambitious do not share or clear each other's data; the toggle is Wind's own (G.WaveTogglePill_XrayBase), saved by the
--   generic toggle capture, so autosave / Save Config / Load / Reset Config include it.
--   Ambitious' separate "Brainrot X-Ray" (its second toggle) is NOT part of this.
-- ==========================================================================
do
	local FOLDERS = { "Base", "PlotSign", "FriendPanel", "Cash", "Laser", "Decorations", "Skin", "Unlock", "Purchases" }
	local ALPHA = 0.5

	local pill = G.WaveTogglePill_XrayBase
	local xr = { loopId = 0, orig = {}, conns = {} }

	local function setTargetTransparency(instance, alpha, loopId)
		if not instance then return end
		if loopId and loopId ~= xr.loopId then return end
		local function apply(obj)
			if obj:IsA("BasePart") then
				if xr.orig[obj] == nil then xr.orig[obj] = obj.Transparency end
				local orig = xr.orig[obj]
				if orig < 1 then
					local target = orig + (1 - orig) * alpha
					if math.abs(obj.Transparency - target) > 0.01 then obj.Transparency = target end
				end
			elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
				if xr.orig[obj] == nil then xr.orig[obj] = { text = obj.TextTransparency, bg = obj.BackgroundTransparency } end
				local orig = xr.orig[obj]
				if orig.text < 1 then
					local target = orig.text + (1 - orig.text) * alpha
					if math.abs(obj.TextTransparency - target) > 0.01 then obj.TextTransparency = target end
				end
				if orig.bg < 1 then
					local target = orig.bg + (1 - orig.bg) * alpha
					if math.abs(obj.BackgroundTransparency - target) > 0.01 then obj.BackgroundTransparency = target end
				end
			elseif obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
				if xr.orig[obj] == nil then xr.orig[obj] = obj.BackgroundTransparency end
				local orig = xr.orig[obj]
				if orig < 1 then
					local target = orig + (1 - orig) * alpha
					if math.abs(obj.BackgroundTransparency - target) > 0.01 then obj.BackgroundTransparency = target end
				end
			elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
				if xr.orig[obj] == nil then xr.orig[obj] = { img = obj.ImageTransparency, bg = obj.BackgroundTransparency } end
				local orig = xr.orig[obj]
				if orig.img < 1 then
					local target = orig.img + (1 - orig.img) * alpha
					if math.abs(obj.ImageTransparency - target) > 0.01 then obj.ImageTransparency = target end
				end
				if orig.bg < 1 then
					local target = orig.bg + (1 - orig.bg) * alpha
					if math.abs(obj.BackgroundTransparency - target) > 0.01 then obj.BackgroundTransparency = target end
				end
			end
		end
		apply(instance)
		for i, child in ipairs(instance:GetDescendants()) do
			apply(child)
			if i % 300 == 0 then -- spread the first pass over several frames
				task.wait()
				if loopId and loopId ~= xr.loopId then return end
			end
		end
	end

	local function trackSubtree(root, alpha, loopId)
		if not root then return end
		if loopId ~= xr.loopId then return end
		setTargetTransparency(root, alpha, loopId)
		if loopId ~= xr.loopId then return end
		table.insert(xr.conns, root.DescendantAdded:Connect(function(obj)
			if loopId ~= xr.loopId then return end
			setTargetTransparency(obj, alpha, loopId)
		end))
	end

	local function processPlot(plot, alpha, loopId)
		if not plot then return end
		if loopId ~= xr.loopId then return end
		for _, fname in ipairs(FOLDERS) do
			if loopId ~= xr.loopId then return end
			trackSubtree(plot:FindFirstChild(fname), alpha, loopId)
		end
		if loopId ~= xr.loopId then return end
		table.insert(xr.conns, plot.ChildAdded:Connect(function(child)
			if loopId ~= xr.loopId then return end
			for _, fname in ipairs(FOLDERS) do
				if child.Name == fname then
					trackSubtree(child, alpha, loopId)
					break
				end
			end
		end))
		local podiums = plot:FindFirstChild("AnimalPodiums")
		if podiums then
			local function processPodium(podium)
				for _, child in ipairs(podium:GetChildren()) do
					if child.Name == "Claim" then
						trackSubtree(child, alpha, loopId)
					elseif child.Name == "Base" then
						trackSubtree(child:FindFirstChild("Decorations"), alpha, loopId)
					elseif child:IsA("Model") and child.Name ~= "Decorations" then
						trackSubtree(child, alpha, loopId)
					end
				end
			end
			for _, podium in ipairs(podiums:GetChildren()) do
				processPodium(podium)
			end
			table.insert(xr.conns, podiums.ChildAdded:Connect(function(podium)
				if loopId ~= xr.loopId then return end
				task.wait(0.1)
				if loopId ~= xr.loopId then return end
				processPodium(podium)
			end))
		end
	end

	local function applyToAllPlots(alpha, loopId)
		local plots = workspace:FindFirstChild("Plots")
		if not plots then return end
		for _, plot in ipairs(plots:GetChildren()) do
			if loopId ~= xr.loopId then return end
			processPlot(plot, alpha, loopId)
			task.wait()
		end
		table.insert(xr.conns, plots.ChildAdded:Connect(function(plot)
			if loopId ~= xr.loopId then return end
			task.wait(0.2)
			processPlot(plot, alpha, loopId)
		end))
	end

	local function setXRay(enabled)
		for _, conn in ipairs(xr.conns) do
			if typeof(conn) == "RBXScriptConnection" then conn:Disconnect() end
		end
		xr.conns = {}
		xr.loopId += 1
		local currentLoopId = xr.loopId
		if enabled then
			task.spawn(function()
				while currentLoopId == xr.loopId and not workspace:FindFirstChild("Plots") do
					task.wait(0.5)
				end
				if currentLoopId ~= xr.loopId then return end
				local ok, err = pcall(applyToAllPlots, ALPHA, currentLoopId)
				if not ok then warn("[WIND] X-Ray Base: " .. tostring(err)) end
			end)
		else
			local snapshot = xr.orig
			xr.orig = {}
			for obj, orig in pairs(snapshot) do
				pcall(function()
					if obj:IsA("BasePart") then
						obj.Transparency = orig
					elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
						obj.TextTransparency = orig.text
						obj.BackgroundTransparency = orig.bg
					elseif obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
						obj.BackgroundTransparency = orig
					elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
						obj.ImageTransparency = orig.img
						obj.BackgroundTransparency = orig.bg
					end
				end)
			end
		end
	end

	if pill then
		local function apply()
			local ok, err = pcall(setXRay, pill:GetAttribute("WaveToggleOn") == true)
			if not ok then warn("[WIND] X-Ray Base: " .. tostring(err)) end
		end
		pill:GetAttributeChangedSignal("WaveToggleOn"):Connect(apply)
		apply()
	else
		warn("[WIND] X-Ray Base: toggle pill (WaveTogglePill_XrayBase) missing, feature not wired")
	end
end

