local INF_JUMP_DEFAULT_POWER = 55 -- same value Akatsuki used
local INF_JUMP_COOLDOWN = 0.08
local infJumpHold = true -- Akatsuki "hold" mode only: keep Space/jump pressed to keep boosting
local infJumpConn
local infJumpLast = 0
local infJumpPrevDown = false

local function getJumpPower()
	local n = tonumber(G.TextBox_5.Text)
	if not n or n ~= n or math.abs(n) == math.huge then
		n = INF_JUMP_DEFAULT_POWER
	end
	return math.clamp(n, 1, 200)
end

local function stopInfJump()
	if infJumpConn then
		infJumpConn:Disconnect()
		infJumpConn = nil
	end
	infJumpPrevDown = false
end

local function startInfJump()
	stopInfJump()
	infJumpConn = RunService.Heartbeat:Connect(function()
		pcall(function()
			local char = LocalPlayer.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if not hum or not root or hum.Health <= 0 or UserInputService:GetFocusedTextBox() then
				infJumpPrevDown = false
				return
			end
			local down = UserInputService:IsKeyDown(Enum.KeyCode.Space)
				or UserInputService:IsKeyDown(Enum.KeyCode.ButtonA)
				or hum.Jump == true
			local fire
			if infJumpHold then
				fire = down
			else
				fire = down and not infJumpPrevDown -- Tap: rising edge only (also covers the mobile jump button)
			end
			infJumpPrevDown = down
			local now = tick()
			if fire and now - infJumpLast >= INF_JUMP_COOLDOWN then
				infJumpLast = now
				local v = root.Velocity
				root.Velocity = Vector3.new(v.X, getJumpPower(), v.Z)
			end
		end)
	end)
end

