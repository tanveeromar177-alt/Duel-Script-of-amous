-- ═══════════════════════════════════════════════════════════════
-- SPEED SYSTEM (ported from the Misty script)
-- VlonESpeed profile + PreSimulation velocity mover + velocity spoof.
-- `CarrySystem` below is only a thin adapter so the GUI / keybinds / settings
-- keep working; all speed logic lives in the controller.
-- ═══════════════════════════════════════════════════════════════
local CarrySystem
do
    local LPH_NO_VIRTUALIZE = function(f) return f end
    local WALK_SPEED = 16

    local Speed = {
        Normal = NS, Carry = CS, LaggerNormal = LAGGER_SPEED, LaggerCarry = LAGGER_CARRY_SPEED,
        PingLagger = 70, Family = "normal", Carrying = false, Enabled = true, Gate = nil,
    }

    local LEGACY_NAMES = {
        "VlonEHorizontalVelocity", "VlonEHorizontalAttachment", "AdaptSpeedLinearVelocity", "AdaptSpeedForce",
        "AdaptSpeedAttachment", "CandySpeedLinearVelocity", "CandySpeedAttachment", "CandyStepLinearVelocity",
        "CandyStepAttachment", "CandyRoofGuardLinearVelocity", "CandyRoofGuardAttachment",
        "CandyCollisionGuardLinearVelocity", "CandyCollisionGuardAttachment", "VilonHorizontalMoveVelocity",
        "VilonHorizontalMoveAttachment", "VilonPathLinearVelocity", "VilonPathAttachment", "CarryBoostLV",
    }

    local humanoid, root
    local connections = {}
    local ownedRoot = nil
    local sessionToken = {}

    local SpoofState = _G._HazeSpeedSpoofState
    if type(SpoofState) ~= "table" then
        SpoofState = { active = false, velocity = Vector3.zero }
        _G._HazeSpeedSpoofState = SpoofState
    end
    SpoofState.active = false
    SpoofState.velocity = Vector3.zero

    local function currentSpeed()
        if Speed.Family == "lagger" then
            return Speed.Carrying and Speed.LaggerCarry or Speed.LaggerNormal
        elseif Speed.Family == "pinglagger" then
            return Speed.PingLagger
        end
        return Speed.Carrying and Speed.Carry or Speed.Normal
    end

    local function alive(candidate)
        if not (candidate and candidate.Parent and candidate.Parent == LP.Character) then return false end
        local hum = candidate.Parent:FindFirstChildOfClass("Humanoid")
        return hum ~= nil and hum.Health > 0 and hum:GetState() ~= Enum.HumanoidStateType.Dead
    end

    local function clearLegacy(candidate)
        if not candidate then
            local char = LP.Character
            candidate = char and char:FindFirstChild("HumanoidRootPart")
        end
        if not candidate then return end
        for _, name in ipairs(LEGACY_NAMES) do
            local object = candidate:FindFirstChild(name)
            if object then pcall(function() object:Destroy() end) end
        end
    end

    local spoofRandom = Random.new()

    local function speedSpoofRelease()
        SpoofState.active = false
        -- keep reporting a natural walking velocity instead of the real one (never leak the boosted value)
        local r = root
        if r and r.Parent then
            local okv, v = pcall(function() return r.AssemblyLinearVelocity end)
            if okv and v then
                local flat = Vector3.new(v.X, 0, v.Z)
                if flat.Magnitude > WALK_SPEED then flat = flat.Unit * WALK_SPEED end
                SpoofState.velocity = Vector3.new(flat.X, v.Y, flat.Z)
                return
            end
        end
        SpoofState.velocity = Vector3.zero
    end

    local function clear(candidate)
        candidate = candidate or root
        speedSpoofRelease()
        ownedRoot = nil
        clearLegacy(candidate)
    end

    local function isSpoofedRead(self, key)
        if key ~= "AssemblyLinearVelocity" and key ~= "Velocity" then return false end
        if typeof(self) ~= "Instance" then return false end
        local char = LP.Character
        if not char then return false end
        if not self:IsA("BasePart") then return false end
        local nm = self.Name
        if nm ~= "HumanoidRootPart" and nm ~= "Torso" and nm ~= "UpperTorso" then return false end
        return self:IsDescendantOf(char)
    end

    -- Velocity spoof: other scripts reading our root velocity get the fake (walk-speed) value
    if not _G._HazeSpeedSpoofHooked and newcclosure and checkcaller then
        if getrawmetatable and setreadonly then
            local installed = pcall(function()
                local mt = getrawmetatable(game)
                setreadonly(mt, false)
                local oldIndex, oldNewIndex = mt.__index, mt.__newindex
                mt.__index = newcclosure(LPH_NO_VIRTUALIZE(function(self, key)
                    if not checkcaller() then
                        local good, mine = pcall(isSpoofedRead, self, key)
                        if good and mine then return SpoofState.velocity end
                    end
                    return oldIndex(self, key)
                end))
                mt.__newindex = newcclosure(LPH_NO_VIRTUALIZE(function(self, key, value)
                    if not checkcaller() then
                        local good, mine = pcall(isSpoofedRead, self, key)
                        if good and mine then
                            SpoofState.velocity = value
                            return
                        end
                    end
                    return oldNewIndex(self, key, value)
                end))
                setreadonly(mt, true)
            end)
            _G._HazeSpeedSpoofHooked = installed
        elseif hookmetamethod then
            local oldIndex, oldNewIndex
            local okI = pcall(function()
                oldIndex = hookmetamethod(game, "__index", newcclosure(LPH_NO_VIRTUALIZE(function(self, key)
                    if not checkcaller() then
                        local good, mine = pcall(isSpoofedRead, self, key)
                        if good and mine then return SpoofState.velocity end
                    end
                    return oldIndex(self, key)
                end)))
            end)
            local okN = pcall(function()
                oldNewIndex = hookmetamethod(game, "__newindex", newcclosure(LPH_NO_VIRTUALIZE(function(self, key, value)
                    if not checkcaller() then
                        local good, mine = pcall(isSpoofedRead, self, key)
                        if good and mine then
                            SpoofState.velocity = value
                            return
                        end
                    end
                    return oldNewIndex(self, key, value)
                end)))
            end)
            if (okI and oldIndex) or (okN and oldNewIndex) then _G._HazeSpeedSpoofHooked = true end
        end
    end

    local function speedSpoofDrive(hum, rt)
        if rt ~= ownedRoot then
            ownedRoot = rt
            clearLegacy(rt)
            pcall(function() rt:SetNetworkOwner(LP) end)
        end
        local direction = hum.MoveDirection
        direction = Vector3.new(direction.X, 0, direction.Z)
        local vertical = rt.AssemblyLinearVelocity.Y
        if direction.Magnitude <= 0.05 then
            SpoofState.velocity = Vector3.new(0, vertical, 0)
            SpoofState.active = true
            return
        end
        local speed = math.clamp(tonumber(currentSpeed()) or 0, 0, 10000)
        if speed <= 0 then
            speedSpoofRelease()
            return
        end
        local unit = direction.Unit
        local fake = tonumber(_G._HazeFakeSpeed) or WALK_SPEED
        local jx, jz = spoofRandom:NextNumber(-0.003, 0.003), spoofRandom:NextNumber(-0.003, 0.003)
        SpoofState.velocity = Vector3.new(unit.X * fake + jx, vertical, unit.Z * fake + jz)
        SpoofState.active = true
        rt.AssemblyLinearVelocity = Vector3.new(unit.X * speed + jx, vertical, unit.Z * speed + jz)
        _G._HazeLiveSpeed = { v = speed, t = os.clock() }
    end

    local function attach(newCharacter)
        humanoid = newCharacter:WaitForChild("Humanoid", 5) or newCharacter:FindFirstChildOfClass("Humanoid")
        root = newCharacter:WaitForChild("HumanoidRootPart", 5)
        ownedRoot = nil
        speedSpoofRelease()
        clearLegacy(root)
    end

    local function speedAllowed()
        if not Speed.Enabled then return false end
        if Speed.Gate then
            local ok, allowed = pcall(Speed.Gate)
            if ok and not allowed then return false end
        end
        return true
    end

    local preSimulationStep = LPH_NO_VIRTUALIZE(function()
        if _G._HazeSpeedControllerSession ~= sessionToken then return end
        if not (humanoid and root and alive(root)) then
            speedSpoofRelease()
            return
        end
        if humanoid.Health <= 0 then
            speedSpoofRelease()
            return
        end
        if not speedAllowed() then
            speedSpoofRelease()
            return
        end
        local humState = humanoid:GetState()
        if humanoid.PlatformStand
           or humState == Enum.HumanoidStateType.Physics
           or humState == Enum.HumanoidStateType.Ragdoll
           or humState == Enum.HumanoidStateType.FallingDown then
            speedSpoofRelease()
            return
        end
        speedSpoofDrive(humanoid, root)
    end)

    local function disconnectAll()
        for name, connection in pairs(connections) do
            pcall(function() connection:Disconnect() end)
            connections[name] = nil
        end
    end

    function Speed:SetProfile(family, carrying)
        if family ~= "normal" and family ~= "lagger" and family ~= "pinglagger" then return false end
        self.Family = family
        self.Carrying = carrying == true
        return true
    end
    function Speed:SetEnabled(enabled)
        self.Enabled = enabled == true
        if not self.Enabled then clear() end
    end
    function Speed:GetSpeed() return currentSpeed() end
    function Speed:Start()
        if connections.PreSimulation then return end
        _G._HazeSpeedControllerSession = sessionToken
        if RunService.PreSimulation then
            connections.PreSimulation = RunService.PreSimulation:Connect(preSimulationStep)
        else
            connections.PreSimulation = RunService.Stepped:Connect(function() preSimulationStep() end)
        end
    end
    function Speed:Stop()
        disconnectAll()
        clear()
    end

    LP.CharacterAdded:Connect(function(newCharacter) task.defer(attach, newCharacter) end)
    if LP.Character then task.spawn(attach, LP.Character) end
    _G.VlonESpeedLogic = Speed

    -- ───────────────────────────────────────────────────────────
    -- Auto carry (Bubble Hub logic)
    -- Bubble Hub's "Auto Carry Speed": while the toggle is on and the game has
    -- set the player attribute "Stealing" to true, the carry speed is used;
    -- when the attribute goes away, the normal speed comes back. No proximity
    -- scan, no latch and no grace timer, the attribute is read every frame.
    -- ───────────────────────────────────────────────────────────
    local manualCarry = false
    local laggerMode = 0
    local softEnabled = false
    local running = false
    local softRadius = 10        -- only stored/saved for old configs, no longer used
    local softStealSpeed = 30    -- only stored/saved for old configs, no longer used
    local auto = { active = false, conn = nil }

    local function syncProfile()
        local autoCarry = auto.active
        if laggerMode == 2 then Speed:SetProfile("lagger", true)
        elseif laggerMode == 1 then Speed:SetProfile("lagger", autoCarry)
        else Speed:SetProfile("normal", manualCarry or autoCarry) end
    end

    local function isStealing()
        return LP:GetAttribute("Stealing") == true
    end

    local function autoStep()
        local stealing = isStealing()
        if stealing ~= auto.active then
            auto.active = stealing
            syncProfile()
        end
    end

    local function refreshAuto()
        if running and softEnabled then
            if not auto.conn then
                auto.conn = RunService.RenderStepped:Connect(autoStep)
            end
        else
            if auto.conn then
                auto.conn:Disconnect()
                auto.conn = nil
            end
            if auto.active then
                auto.active = false
                syncProfile()
            end
        end
    end

    LP.CharacterAdded:Connect(function()
        if auto.active then
            auto.active = false
            syncProfile()
        end
    end)

    -- Adapter: same fields and methods the old CarrySystem exposed.
    local getters = {
        normalSpeed      = function() return Speed.Normal end,
        carrySpeed       = function() return Speed.Carry end,
        laggerSpeed      = function() return Speed.LaggerNormal end,
        laggerCarrySpeed = function() return Speed.LaggerCarry end,
        speedToggled     = function() return manualCarry end,
        laggerMode       = function() return laggerMode end,
        softStealEnabled = function() return softEnabled end,
        softStealRadius  = function() return softRadius end,
        softStealSpeed   = function() return softStealSpeed end,
    }
    local setters = {
        normalSpeed      = function(v) Speed.Normal = v end,
        carrySpeed       = function(v) Speed.Carry = v end,
        laggerSpeed      = function(v) Speed.LaggerNormal = v end,
        laggerCarrySpeed = function(v) Speed.LaggerCarry = v end,
        speedToggled     = function(v) manualCarry = v == true; syncProfile() end,
        laggerMode       = function(v) laggerMode = (v == 1 or v == 2) and v or 0; syncProfile() end,
        softStealEnabled = function(v) softEnabled = v == true; refreshAuto() end,
        softStealRadius  = function(v) softRadius = v end,
        softStealSpeed   = function(v) softStealSpeed = v end,
    }

    CarrySystem = setmetatable({}, {
        __index = function(_, k)
            local g = getters[k]
            if g then return g() end
            return nil
        end,
        __newindex = function(t, k, v)
            local s = setters[k]
            if s then s(v) else rawset(t, k, v) end
        end,
    })

    function CarrySystem:isCarrying() return isStealing() end
    function CarrySystem:getActiveSpeed() return Speed:GetSpeed() end
    function CarrySystem:getCurrentSpeed() return Speed:GetSpeed() end
    function CarrySystem:getStatus()
        local name
        if Speed.Family == "lagger" then
            name = Speed.Carrying and "LAGGER CARRY" or "LAGGER"
        elseif auto.active then
            name = "AUTO CARRY"
        elseif Speed.Carrying then
            name = "CARRY"
        else
            name = "NORMAL"
        end
        return name, Speed:GetSpeed()
    end
    function CarrySystem:start()
        running = true
        Speed:Start()
        refreshAuto()
    end
    function CarrySystem:stop()
        running = false
        refreshAuto()
    end
    function CarrySystem:isRunning() return running end

    function CarrySystem:setNormalSpeed(v) Speed.Normal = _clamp(v, 1, 500) end
    function CarrySystem:setCarrySpeed(v) Speed.Carry = _clamp(v, 1, 500) end
    function CarrySystem:setLaggerSpeed(v) Speed.LaggerNormal = _clamp(v, 0.1, 500) end
    function CarrySystem:setLaggerCarrySpeed(v) Speed.LaggerCarry = _clamp(v, 0.1, 500) end
    function CarrySystem:setSoftStealSpeed(v) softStealSpeed = _clamp(v, 1, 500) end
    function CarrySystem:setSoftStealRadius(v) softRadius = _clamp(v, 1, 200) end
    function CarrySystem:toggleCarryMode() manualCarry = not manualCarry; syncProfile() end
    function CarrySystem:setLaggerMode(mode)
        if mode == 0 or mode == 1 or mode == 2 then laggerMode = mode; syncProfile() end
    end
    function CarrySystem:toggleLaggerMode()
        laggerMode = (laggerMode + 1) % 3
        syncProfile()
    end
    function CarrySystem:setSoftStealEnabled(enabled)
        softEnabled = enabled == true
        refreshAuto()
    end
    function CarrySystem:toggleSoftSteal() self:setSoftStealEnabled(not softEnabled) end

    -- The mover pauses while another feature drives the character itself
    Speed.Gate = function()
        return not (autoBatEnabled or autoBatV2Enabled or batDesyncTpEnabled
                    or autoLeftEnabled or autoRightEnabled or dropActive)
    end
    Speed:Start()
end


