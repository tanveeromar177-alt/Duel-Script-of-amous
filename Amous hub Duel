-- XRAY BASE (Ambitious-style plot transparency)
-- ═══════════════════════════════════════════════════════════════
local XrayBase = (function()
    local FOLDERS = {
        "Base", "PlotSign", "FriendPanel", "Cash", "Laser",
        "Decorations", "Skin", "Unlock", "Purchases"
    }
    local origTrans = {}
    local conns = {}
    local loopId = 0
    local ALPHA = 0.5

    local function setTargetTransparency(instance, alphaPercent, id)
        if not instance then return end
        if id and id ~= loopId then return end
        local function apply(obj)
            if obj:IsA("BasePart") then
                if origTrans[obj] == nil then origTrans[obj] = obj.Transparency end
                local orig = origTrans[obj]
                if type(orig) == "number" and orig < 1 then
                    local target = orig + (1 - orig) * alphaPercent
                    if math.abs(obj.Transparency - target) > 0.01 then
                        obj.Transparency = target
                    end
                end
            elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
                if origTrans[obj] == nil then
                    origTrans[obj] = { text = obj.TextTransparency, bg = obj.BackgroundTransparency }
                end
                local orig = origTrans[obj]
                if orig.text < 1 then
                    local target = orig.text + (1 - orig.text) * alphaPercent
                    if math.abs(obj.TextTransparency - target) > 0.01 then obj.TextTransparency = target end
                end
                if orig.bg < 1 then
                    local target = orig.bg + (1 - orig.bg) * alphaPercent
                    if math.abs(obj.BackgroundTransparency - target) > 0.01 then obj.BackgroundTransparency = target end
                end
            elseif obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
                if origTrans[obj] == nil then origTrans[obj] = obj.BackgroundTransparency end
                local orig = origTrans[obj]
                if type(orig) == "number" and orig < 1 then
                    local target = orig + (1 - orig) * alphaPercent
                    if math.abs(obj.BackgroundTransparency - target) > 0.01 then obj.BackgroundTransparency = target end
                end
            elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
                if origTrans[obj] == nil then
                    origTrans[obj] = { img = obj.ImageTransparency, bg = obj.BackgroundTransparency }
                end
                local orig = origTrans[obj]
                if orig.img < 1 then
                    local target = orig.img + (1 - orig.img) * alphaPercent
                    if math.abs(obj.ImageTransparency - target) > 0.01 then obj.ImageTransparency = target end
                end
                if orig.bg < 1 then
                    local target = orig.bg + (1 - orig.bg) * alphaPercent
                    if math.abs(obj.BackgroundTransparency - target) > 0.01 then obj.BackgroundTransparency = target end
                end
            end
        end
        apply(instance)
        local descendants = instance:GetDescendants()
        for i, child in ipairs(descendants) do
            apply(child)
            if i % 300 == 0 then
                task.wait()
                if id and id ~= loopId then return end
            end
        end
    end

    local function trackSubtree(root, alphaPercent, id)
        if not root then return end
        if id ~= loopId then return end
        setTargetTransparency(root, alphaPercent, id)
        if id ~= loopId then return end
        table.insert(conns, root.DescendantAdded:Connect(function(obj)
            if id ~= loopId then return end
            setTargetTransparency(obj, alphaPercent, id)
        end))
    end

    local function processPlot(plot, alphaPercent, id)
        if not plot then return end
        if id ~= loopId then return end
        for _, fname in ipairs(FOLDERS) do
            if id ~= loopId then return end
            trackSubtree(plot:FindFirstChild(fname), alphaPercent, id)
        end
        if id ~= loopId then return end
        table.insert(conns, plot.ChildAdded:Connect(function(child)
            if id ~= loopId then return end
            for _, fname in ipairs(FOLDERS) do
                if child.Name == fname then
                    trackSubtree(child, alphaPercent, id)
                    break
                end
            end
        end))
        local animalPodiums = plot:FindFirstChild("AnimalPodiums")
        if animalPodiums then
            local function processPodium(podium)
                for _, child in ipairs(podium:GetChildren()) do
                    if child.Name == "Claim" then
                        trackSubtree(child, alphaPercent, id)
                    elseif child.Name == "Base" then
                        trackSubtree(child:FindFirstChild("Decorations"), alphaPercent, id)
                    elseif child:IsA("Model") and child.Name ~= "Decorations" then
                        trackSubtree(child, alphaPercent, id)
                    end
                end
            end
            for _, podium in ipairs(animalPodiums:GetChildren()) do
                processPodium(podium)
            end
            table.insert(conns, animalPodiums.ChildAdded:Connect(function(podium)
                if id ~= loopId then return end
                task.wait(0.1)
                if id ~= loopId then return end
                processPodium(podium)
            end))
        end
    end

    local function applyToAllPlots(alphaPercent, id)
        local plotsFolder = workspace:FindFirstChild("Plots")
        if not plotsFolder then return end
        for _, plot in ipairs(plotsFolder:GetChildren()) do
            if id ~= loopId then return end
            processPlot(plot, alphaPercent, id)
            task.wait()
        end
        table.insert(conns, plotsFolder.ChildAdded:Connect(function(plot)
            if id ~= loopId then return end
            task.wait(0.2)
            processPlot(plot, alphaPercent, id)
        end))
    end

    local function setEnabled(enabled)
        for _, conn in ipairs(conns) do
            if typeof(conn) == "RBXScriptConnection" then pcall(function() conn:Disconnect() end) end
        end
        conns = {}
        loopId = loopId + 1
        local currentLoopId = loopId
        xrayBaseEnabled = enabled and true or false
        if enabled then
            task.spawn(function()
                while currentLoopId == loopId and not workspace:FindFirstChild("Plots") do
                    task.wait(0.5)
                end
                if currentLoopId ~= loopId then return end
                pcall(applyToAllPlots, ALPHA, currentLoopId)
            end)
        else
            local snapshot = origTrans
            origTrans = {}
            for obj, orig in pairs(snapshot) do
                pcall(function()
                    if obj:IsA("BasePart") then
                        obj.Transparency = orig
                    elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
                        obj.TextTransparency = orig.text
                        obj.BackgroundTransparency = orig.bg
                    elseif obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
                        obj.BackgroundTransparency = orig
                    elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
                        obj.ImageTransparency = orig.img
                        obj.BackgroundTransparency = orig.bg
                    end
                end)
            end
        end
        if setXrayBaseVisual then setXrayBaseVisual(xrayBaseEnabled) end
    end

    return { SetEnabled = setEnabled }
end)()
_G.HazeXrayBase = XrayBase

