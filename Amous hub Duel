-- Restore = a real TAP on the mini icon, built the Vx7 way (Vx7 "MinimizedFrame": InputBegan on the mini only
-- records the press, the release is read from the global UserInputService.InputEnded, and a press that moved more than
-- a few pixels is never a tap). The look of the mini button is unchanged.
-- Why the old version still opened the GUI while you pushed the movement joystick: it only ignored a press when
-- makeDraggable had flagged it as a drag, and that flag is never set while "Lock UI" is on, so a finger that began on
-- the mini area and then travelled with the joystick counted as a tap on release; a stale press could also survive.
-- A press now counts as a tap only if ALL of these hold (checked on the exact InputObject that began on the mini):
--   * it is released within MINI_TAP_MAX_SECONDS (holding the joystick is always longer),
--   * the finger moved at most MINI_TAP_SLOP pixels between press and release (joystick travel is far more),
--   * it was not turned into a drag by makeDraggable.
-- Other fingers (the joystick) can never open or cancel it, and the pending press is dropped whenever the state changes.
G.MINI_TAP_SLOP = 10
G.MINI_TAP_MAX_SECONDS = 0.6
do
	local miniPress = nil -- { input = InputObject, pos = Vector2, t = os.clock() } for the press that began on the mini
	local function isPointer(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
	end
	local function screenPos(input)
		return Vector2.new(input.Position.X, input.Position.Y)
	end
	local function onMiniBegan(input)
		if not isPointer(input) then return end
		if not isMinimized then
			miniPress = nil
			return
		end
		miniPress = { input = input, pos = screenPos(input), t = os.clock() }
	end
	for _, handle in ipairs({ G.WaveMiniRestoreButton }) do
		handle.InputBegan:Connect(onMiniBegan)
	end
	UserInputService.InputEnded:Connect(function(input)
		local press = miniPress
		if not press or input ~= press.input then return end -- another finger (movement joystick) ended: ignore
		miniPress = nil
		if not isMinimized then return end
		if dragMoved[G.WaveMiniRestoreButton] then return end
		if os.clock() - press.t > G.MINI_TAP_MAX_SECONDS then return end
		if (screenPos(input) - press.pos).Magnitude > G.MINI_TAP_SLOP then return end
		setMinimized(false)
	end)
	-- any hide / show of the main GUI drops a pending press
	G.MainOuter:GetPropertyChangedSignal("Visible"):Connect(function()
		miniPress = nil
	end)
end

