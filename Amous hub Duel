				local n = 0
				if ok and type(res) == "table" and res[1] then
					local ok2, got = pcall(install, res[1])
					if ok2 then n = got end
				end
				if n > 0 then okCount += 1 else table.insert(failed, item.kind) end
			end
			if my ~= token then return end
			local t = def.label .. ": " .. okCount .. "/" .. total .. " applied"
			if #failed > 0 then t = t .. " (failed: " .. table.concat(failed, ", ") .. ")" end
			setStatus(t)
		end)
	end

