local function looksLikeImage(body)
	if type(body) ~= "string" or #body < MIN_AUDIO_BYTES then return false end
	return body:sub(1, 3) == "\255\216\255" or body:sub(1, 4) == "\137PNG"
end
local function loadCover(s)
	if not s.coverUrl or s.cover then return end
	local ok, err = pcall(function()
		local cached = false
		if isfile(s.coverFile) then
			cached = (type(readfile) ~= "function") or looksLikeImage(readfile(s.coverFile))
		end
		if not cached then
			local body = game:HttpGet(s.coverUrl)
			if not looksLikeImage(body) then
				error("not a JPEG/PNG (" .. (type(body) == "string" and #body or 0) .. " bytes)")
			end
			writefile(s.coverFile, body)
		end
		local asset = getcustomasset(s.coverFile)
		if type(asset) ~= "string" or asset == "" then error("getcustomasset returned nothing") end
		s.cover = asset
	end)
	if closed then return end
	if ok and s.cover then
		if current == s then updateNow() end
		refresh()
	else
		warn("[Volt] Cover failed for " .. s.title .. ": " .. tostring(err))
	end
end
if CAN_DOWNLOAD then
	for _, s in ipairs(SONGS) do task.spawn(loadCover, s) end
