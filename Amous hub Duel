-- HAZE ANTI PACKET (ported from "Volt Anti Packet", renamed, black/grey theme)
-- Open() shows the panel, Close() removes it and stops the detector.
-- ═══════════════════════════════════════════════════════════════
HazeAntiPacket = (function()
    local StatsSvc = game:GetService("Stats")

    local gui, main, toggleBtn, mainStroke, btnStroke = nil, nil, nil, nil, nil
    local enabled = false
    local blocked = 0
    local lastPing = 0
    local fireScore = 0
    local lastCheck = os.clock()
    local logicConn = nil
    local uiConns = {}

    local COL_BG        = Color3.fromRGB(20, 20, 24)
    local COL_TITLE     = Color3.fromRGB(230, 230, 230)
    local COL_STROKE_OFF = Color3.fromRGB(80, 80, 90)
    local COL_STROKE_ON  = Color3.fromRGB(170, 170, 180)
    local COL_BTN_OFF   = Color3.fromRGB(36, 36, 42)
    local COL_BTN_ON    = Color3.fromRGB(70, 70, 78)
    local COL_TXT_OFF   = Color3.fromRGB(190, 190, 198)
    local COL_TXT_ON    = Color3.fromRGB(255, 255, 255)

    local function updateButton()
        if not toggleBtn then return end
        if enabled then
            toggleBtn.Text = "DISABLE"
            toggleBtn.BackgroundColor3 = COL_BTN_ON
            toggleBtn.TextColor3 = COL_TXT_ON
            btnStroke.Color = COL_STROKE_ON
            mainStroke.Color = COL_STROKE_ON
        else
            toggleBtn.Text = "ACTIVE"
            toggleBtn.BackgroundColor3 = COL_BTN_OFF
            toggleBtn.TextColor3 = COL_TXT_OFF
            btnStroke.Color = COL_STROKE_OFF
            mainStroke.Color = COL_STROKE_OFF
        end
    end

    local function onBlock(reason)
        if not enabled then return end
        blocked = blocked + 1
        print("[Haze]", reason, "| Total:", blocked)
    end

    local function startLogic()
        if logicConn then return end
        lastPing, fireScore, lastCheck = 0, 0, os.clock()
        logicConn = RunService.Heartbeat:Connect(function()
            if not enabled then return end
            local now = os.clock()

            pcall(function()
                local pingItem = StatsSvc.Network.ServerStatsItem:FindFirstChild("Data Ping")
                if pingItem then
                    local ping = pingItem:GetValue()
                    if ping and lastPing > 0 and ping > lastPing + 45 then
                        onBlock("Ping spike")
                    end
                    lastPing = ping or lastPing
                end
            end)

            fireScore = fireScore + 1
            if now - lastCheck >= 0.4 then
                if fireScore > 10 then
                    onBlock("High activity")
                end
                fireScore = 0
                lastCheck = now
            end
        end)
    end

    local function stopLogic()
        if logicConn then
            logicConn:Disconnect()
            logicConn = nil
        end
        fireScore = 0
    end

    local function isOpen()
        return gui ~= nil and gui.Parent ~= nil
    end

    local function close()
        enabled = false
        stopLogic()
        for _, c in ipairs(uiConns) do pcall(function() c:Disconnect() end) end
        uiConns = {}
        if gui then pcall(function() gui:Destroy() end) end
        gui, main, toggleBtn, mainStroke, btnStroke = nil, nil, nil, nil, nil
    end

    local function open()
        if isOpen() then return end
        close() -- clean any half-dead leftovers

        gui = Instance.new("ScreenGui")
        gui.Name = "HazeAntiPacket"
        gui.ResetOnSpawn = false
        gui.IgnoreGuiInset = true
        gui.DisplayOrder = 999
        gui:SetAttribute("HazeOwned", true)
        pcall(function() if syn and syn.protect_gui then syn.protect_gui(gui) end end)
        local okParent = pcall(function() gui.Parent = game:GetService("CoreGui") end)
        if not okParent or not gui.Parent then gui.Parent = LP:WaitForChild("PlayerGui") end

        main = Instance.new("Frame")
        main.Size = UDim2.new(0, 190, 0, 95)
        main.Position = UDim2.new(0.5, -95, 0.2, 0)
        main.BackgroundColor3 = COL_BG
        main.BorderSizePixel = 0
        main.Active = true
        main.Parent = gui
        Instance.new("UICorner", main).CornerRadius = UDim.new(0, 10)

        mainStroke = Instance.new("UIStroke")
        mainStroke.Color = COL_STROKE_OFF
        mainStroke.Thickness = 1.4
        mainStroke.Parent = main

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(1, -16, 0, 28)
        title.Position = UDim2.new(0, 8, 0, 8)
        title.BackgroundTransparency = 1
        title.Text = "Haze Anti Packet"
        title.Font = Enum.Font.GothamBold
        title.TextSize = 14
        title.TextColor3 = COL_TITLE
        title.TextXAlignment = Enum.TextXAlignment.Center
        title.Parent = main

        toggleBtn = Instance.new("TextButton")
        toggleBtn.Size = UDim2.new(1, -20, 0, 34)
        toggleBtn.Position = UDim2.new(0, 10, 0, 46)
        toggleBtn.BackgroundColor3 = COL_BTN_OFF
        toggleBtn.Text = "ACTIVE"
        toggleBtn.Font = Enum.Font.GothamBold
        toggleBtn.TextSize = 13
        toggleBtn.TextColor3 = COL_TXT_OFF
        toggleBtn.AutoButtonColor = false
        toggleBtn.Parent = main
        Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 8)

        btnStroke = Instance.new("UIStroke")
        btnStroke.Color = COL_STROKE_OFF
        btnStroke.Thickness = 1.2
        btnStroke.Parent = toggleBtn

        -- drag by the title
        local dragging = false
        local dragStart, startPos
        title.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = main.Position
            end
        end)
        uiConns[#uiConns + 1] = UIS.InputChanged:Connect(function(input)
            if dragging and main and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
        uiConns[#uiConns + 1] = UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        toggleBtn.MouseButton1Click:Connect(function()
            enabled = not enabled
            if enabled then
                startLogic()
                print("[Haze] ACTIVE")
            else
                stopLogic()
                print("[Haze] DISABLED")
            end
            updateButton()
        end)

        updateButton()
        print("[Haze Anti Packet] Loaded")
    end

    return { Open = open, Close = close, IsOpen = isOpen }
end)()


-- ═══════════════════════════════════════════════════════════════
-- HAZE SPEED BYPASS (embedded GUI)
-- ═══════════════════════════════════════════════════════════════
HazeSpeedBypass = (function()
    local activated, keybind, waitingForKey = false, Enum.KeyCode.E, false
    local power, lagAmount, lagConn = 97000, 0.12, nil
    local sideOpen, isLocked = false, false
    local gui, main, side, toggleBtn, powerDisplay

    local function applyPower(val)
        power = math.clamp(val, 10000, 500000)
        local t = (power - 10000) / 490000
        lagAmount = t * 0.2
    end
