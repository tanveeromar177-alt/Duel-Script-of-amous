	-- Applies each setting on its own, so one bad value can never abort the others.
	function Store.applySimple(saved)
		local applied = 0
		for _, m in ipairs(SIMPLE) do
			local val = saved[m[1]]
			if val ~= nil then
				pcall(function()
					local kind = type(val)
					local cur = Config[m[2]]
					if kind ~= "boolean" and kind ~= "string" and kind ~= "number" then
						return
					end
					if cur ~= nil and type(cur) ~= kind then
						return
					end
					if kind == "number" then
						if val ~= val or val == math.huge or val == -math.huge then
							return
						end
						if m[3] then
							val = math.clamp(val, m[3], m[4])
						end
					end
					Config[m[2]] = val
					applied = applied + 1
				end)
			end
		end
		return applied
	end
end

