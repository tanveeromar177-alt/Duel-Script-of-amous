	local skinChoice = { Bat = OFF, Medusa = OFF } -- skin key per category, or OFF
	local function anyOn() return skinChoice.Bat ~= OFF or skinChoice.Medusa ~= OFF end

	local function catOf(inst)
		if not inst:IsA("Tool") then return nil end
		local n = inst.Name:lower()
		if n:find("bat") or n:find("slap") then return "Bat" end
		if n:find("medusa") then return "Medusa" end
		return nil
	end

	local function isReplica(d)
		return d.Name == "LocalReplica" or d:FindFirstAncestor("LocalReplica") ~= nil
	end

	local tracked = setmetatable({}, { __mode = "k" }) -- [tool] = entry
	local hooked = setmetatable({}, { __mode = "k" })  -- a Sound is hooked only once

	-- ---------- skin: hide the real graphics, weld a replica ----------
	local function buildReplica(handle, key)
		local old = handle:FindFirstChild("LocalReplica")
		if old then old:Destroy() end
		local data = SKINS[key]

		local m = Instance.new("Model")
		m.Name = "LocalReplica"

		local p = Instance.new("Part")
		p.Name = "MainPart"
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.Size = Vector3.new(1, 1, 1)
		p.Transparency = 0
		p.Anchored = false
		p.Parent = m

		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.FileMesh
		mesh.MeshId = data.mesh
		mesh.TextureId = data.tex
		mesh.Scale = data.scale
		mesh.Parent = p

		local w = Instance.new("Motor6D")
		w.Part0 = handle
		w.Part1 = p
		w.C0 = data.c0
		w.Parent = p

		m.Parent = handle
	end

	local function hideNode(entry, d)
		if isReplica(d) then return end
		if not (d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture")) then return end
		if entry.hidden[d] == nil then
			local ok, v = pcall(function() return d.Transparency end)
			if not ok then return end
			entry.hidden[d] = v
			local okc, conn = pcall(function()
				return d:GetPropertyChangedSignal("Transparency"):Connect(function()
					-- the game wrote a new value: put the hidden one back
					if entry.skinOn and d.Transparency ~= 1 then d.Transparency = 1 end
				end)
			end)
			if okc and conn then entry.guards[d] = conn end
		end
		if d.Transparency ~= 1 then pcall(function() d.Transparency = 1 end) end
	end

	local function removeSkin(tool, entry)
		entry.skinOn = false
		local handle = tool:FindFirstChild("Handle")
		local rep = handle and handle:FindFirstChild("LocalReplica")
		if rep then pcall(function() rep:Destroy() end) end
		entry.replicaKey = nil
		for d, orig in pairs(entry.hidden) do
			local g = entry.guards[d]
			if g then pcall(function() g:Disconnect() end) end
			if d.Parent then pcall(function() d.Transparency = orig end) end
		end
		entry.hidden, entry.guards = {}, {}
	end

	-- ---------- sound: mute the tool's own sounds, play the custom one ----------
	local function playCustom(entry)
		local cs = entry.sound
		if not cs or not cs.Parent then return end
		local d = entry.data
		if entry.timer then
			pcall(task.cancel, entry.timer)
			entry.timer = nil
		end
		pcall(function()
			cs:Stop()
			cs.TimePosition = d.skip or 0
			cs.Volume = 1
			cs:Play()
		end)
		if d.doublePlay and d.delay then
			entry.timer = task.delay(d.delay, function()
				entry.timer = nil
				if entry.sound ~= cs or not cs.Parent then return end
				pcall(function()
					cs:Stop()
					cs.TimePosition = d.skip or 0
					cs.Volume = 1
					cs:Play()
				end)
			end)
		end
	end

	local function hookSound(entry, snd)
		if not snd:IsA("Sound") or snd.Name == "CustomSound" then return end
		if hooked[snd] or entry.muted[snd] ~= nil then return end
		entry.muted[snd] = snd.Volume
		hooked[snd] = true

		local function trigger()
			if not entry.sound then return end
			if snd.Playing or snd.TimePosition > 0 then
				pcall(function()
					snd.Volume = 0
					snd:Stop()
				end)
				playCustom(entry)
			end
		end
		local c1 = snd:GetPropertyChangedSignal("Playing"):Connect(trigger)
		local c2 = snd:GetPropertyChangedSignal("TimePosition"):Connect(trigger)
		local c3
		c3 = snd.AncestryChanged:Connect(function(_, parent)
			if parent then return end
			pcall(function() c1:Disconnect() end)
			pcall(function() c2:Disconnect() end)
			pcall(function() c3:Disconnect() end)
			hooked[snd] = nil
			entry.muted[snd] = nil
			if entry.timer then
				pcall(task.cancel, entry.timer)
				entry.timer = nil
			end
		end)
		table.insert(entry.sconns, c1)
		table.insert(entry.sconns, c2)
		table.insert(entry.sconns, c3)
		if snd.Playing then trigger() end
	end

	local function removeSound(entry)
		if entry.timer then
			pcall(task.cancel, entry.timer)
			entry.timer = nil
		end
		for _, c in ipairs(entry.sconns) do pcall(function() c:Disconnect() end) end
		entry.sconns = {}
		local cs = entry.sound
		entry.sound = nil
		if cs then pcall(function() cs:Destroy() end) end
		for snd, vol in pairs(entry.muted) do
			hooked[snd] = nil
			if snd and snd.Parent then pcall(function() snd.Volume = vol end) end
		end
		entry.muted = {}
	end

	local function ensureSound(tool, entry, handle)
		local data = SOUNDS[entry.cat]
		if not data then return end
		if entry.sound and entry.sound.Parent == handle then return end
		removeSound(entry)
		local old = handle:FindFirstChild("CustomSound")
		if old then pcall(function() old:Destroy() end) end

		local cs = Instance.new("Sound")
		cs.Name = "CustomSound"
		cs.SoundId = data.id
		cs.Volume = 1
		cs.Looped = false
		cs.RollOffMode = Enum.RollOffMode.Inverse
		cs.MaxDistance = 1000
		cs.MinDistance = 1000
		cs.Parent = handle
		entry.sound = cs
		entry.data = data
		for _, d in ipairs(tool:GetDescendants()) do hookSound(entry, d) end
	end

	-- ---------- per-tool sync ----------
	local function syncTool(tool, entry)
		local key = skinChoice[entry.cat]
		local def = SKINS[key]
		if not def then -- OFF: real tool and real sounds come back
			if entry.skinOn then removeSkin(tool, entry) end
			if entry.sound then removeSound(entry) end
			return
		end
		local handle = tool:FindFirstChild("Handle")
		if not handle then return end -- DescendantAdded below calls this again when the Handle shows up
		entry.skinOn = true
		local rep = handle:FindFirstChild("LocalReplica")
		local mainPart = rep and rep:FindFirstChild("MainPart")
		local motor = mainPart and mainPart:FindFirstChildOfClass("Motor6D")
		if entry.replicaKey ~= key or not rep or not mainPart or not motor or motor.Part0 ~= handle then
			buildReplica(handle, key)
			entry.replicaKey = key
			for _, d in ipairs(tool:GetDescendants()) do hideNode(entry, d) end
		end
		ensureSound(tool, entry, handle)
	end

	local function teardown(tool)
		local entry = tracked[tool]
		if not entry then return end
		for _, c in ipairs(entry.conns) do pcall(function() c:Disconnect() end) end
		pcall(removeSkin, tool, entry)
		pcall(removeSound, entry)
		tracked[tool] = nil
	end

	local function register(tool)
		local cat = catOf(tool)
		if not cat then return end
		local entry = tracked[tool]
		if not entry then
			entry = { cat = cat, conns = {}, sconns = {}, hidden = {}, guards = {}, muted = {}, skinOn = false }
			tracked[tool] = entry
			table.insert(entry.conns, tool.DescendantAdded:Connect(function(d)
				task.defer(function()
					if tracked[tool] ~= entry then return end
					if d.Name == "Handle" and d.Parent == tool then syncTool(tool, entry) end
					if entry.skinOn then hideNode(entry, d) end
					if entry.sound then hookSound(entry, d) end
				end)
			end))
			table.insert(entry.conns, tool.AncestryChanged:Connect(function(_, parent)
				if not parent then teardown(tool) end
			end))
		end
		syncTool(tool, entry)
	end

	local function scanContainer(container)
		if not container then return end
		for _, child in ipairs(container:GetChildren()) do
			local cat = catOf(child)
			if cat and skinChoice[cat] ~= OFF then register(child) end
		end
	end

	local function refreshAll()
		for tool, entry in pairs(tracked) do
			if not tool.Parent or skinChoice[entry.cat] == OFF then
				if tool.Parent then
					syncTool(tool, entry)
				end
				if not tool.Parent or skinChoice[entry.cat] == OFF then teardown(tool) end
			else
				syncTool(tool, entry)
			end
		end
		scanContainer(lp:FindFirstChildOfClass("Backpack"))
		scanContainer(lp.Character)
	end

	local watchers = setmetatable({}, { __mode = "k" })
	local function watch(container)
		if not container or watchers[container] then return end
		watchers[container] = container.ChildAdded:Connect(function(child)
			local cat = catOf(child)
			if cat and skinChoice[cat] ~= OFF then register(child) end
		end)
	end
	local function watchAll()
		watch(lp:FindFirstChildOfClass("Backpack"))
		watch(lp.Character)
	end
	watchAll()

	lp.ChildAdded:Connect(function(child)
		if child:IsA("Backpack") then watch(child) end
	end)
	lp.CharacterAdded:Connect(function(char)
		for tool in pairs(tracked) do teardown(tool) end
		watch(char)
		task.delay(0.6, function()
			watchAll()
			if anyOn() then pcall(refreshAll) end
		end)
	end)

	-- watchdog: replica gone / Handle replaced / transparency written back by the game
	task.spawn(function()
		local n = 0
		while true do
			task.wait(0.4)
			if anyOn() then
				n += 1
				pcall(function()
					watchAll()
					scanContainer(lp:FindFirstChildOfClass("Backpack"))
					scanContainer(lp.Character)
					for tool, entry in pairs(tracked) do
						if not tool.Parent then
							teardown(tool)
						else
							syncTool(tool, entry)
							if n % 5 == 0 and entry.skinOn then
								for _, d in ipairs(tool:GetDescendants()) do hideNode(entry, d) end
							end
						end
					end
				end)
			end
		end
	end)

