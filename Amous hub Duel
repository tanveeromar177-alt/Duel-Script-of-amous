local function start()
    if conn then return end
    local char = LP.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root or humanoid.Health <= 0 then
        return
    end

    enabled = true
    prevAutoRotate = humanoid.AutoRotate
    humanoid.AutoRotate = false

    local bat = findBat()
    if bat and bat.Parent ~= char and not char:FindFirstChildOfClass("Tool") then
        pcall(function() humanoid:EquipTool(bat) end)
    end

    conn = RunService.RenderStepped:Connect(function(dt)
        if not enabled then stop(); return end

        local currentChar = LP.Character
        local currentRoot = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
        local currentHum  = currentChar and currentChar:FindFirstChildOfClass("Humanoid")
        if not currentRoot or not currentHum or currentHum.Health <= 0 then return end
        currentHum.AutoRotate = false
        root, humanoid = currentRoot, currentHum

        local equipped = currentChar:FindFirstChildOfClass("Tool")
        bat = (equipped and isBatTool(equipped)) and equipped or nil
        if not bat then
            bat = findBat()
            if bat and bat.Parent ~= currentChar then
                pcall(function() currentHum:EquipTool(bat) end)
                equipped = currentChar:FindFirstChildOfClass("Tool")
                bat = (equipped and isBatTool(equipped)) and equipped or nil
            end
        end

        local plr, targetRoot = selectTarget(root)
        if not targetRoot then
            root.AssemblyLinearVelocity = Vector3.new(
                root.AssemblyLinearVelocity.X * 0.7,
                root.AssemblyLinearVelocity.Y,
                root.AssemblyLinearVelocity.Z * 0.7
            )
            root.AssemblyAngularVelocity = Vector3.zero
            return
        end

        local now       = tick()
        local targetPos = targetRoot.Position
        local targetCF  = targetRoot.CFrame
        local liveDist  = (targetPos - root.Position).Magnitude
        local liveVel   = targetRoot.AssemblyLinearVelocity
        local safeDt    = math.max(dt, 1/240)

        local rawVel = liveVel
        if lastTargetPos then
            local measured = (targetPos - lastTargetPos) / safeDt
            if measured.Magnitude > MAX_PREDICT then
                measured = measured.Unit * MAX_PREDICT
            end

            local spoofed = false
            if liveVel.Magnitude > SPOOF_VEL_ABS then
                if measured.Magnitude < liveVel.Magnitude * SPOOF_RATIO then
                    spoofed = true
                end
            end
            if spoofed then
                rawVel = measured
            else
                rawVel = measured:Lerp(liveVel, LIVE_BLEND)
            end

            if rawVel.Magnitude > MAX_PREDICT then
                rawVel = rawVel.Unit * MAX_PREDICT
            end
            push(accelHistory, (rawVel - targetVelocity) / safeDt, 6)
            push(velocityHistory, rawVel, 12)
            targetVelocity = rawVel
            smoothedVelocity = smoothedVelocity:Lerp(rawVel, SAMPLE_LERP)
        else
            targetVelocity = liveVel
            smoothedVelocity = liveVel
        end
        lastTargetPos = targetPos

        local predictedVelocity = smoothedVelocity
        if #velocityHistory > 2 then
            predictedVelocity = avg(velocityHistory):Lerp(smoothedVelocity, 0.45)
        end

        local horizVel = Vector3.new(predictedVelocity.X, 0, predictedVelocity.Z)
        if horizVel.Magnitude > 2.5 then
            previousDirection = horizVel.Unit
        end

        local predT = math.clamp(horizVel.Magnitude / 125, PREDICT_MIN, PREDICT_MAX)
        predT = math.clamp(predT + currentPing * 0.5, PREDICT_MIN, PREDICT_MAX + 0.08)
        local accel = avg(accelHistory)
        local predicted = targetPos
            + predictedVelocity * predT
            + accel * 0.35 * (predT * predT * 0.5)

        local frontDir
        if horizVel.Magnitude > 2.0 then
            frontDir = horizVel.Unit
        else
            local look = Vector3.new(targetCF.LookVector.X, 0, targetCF.LookVector.Z)
            if look.Magnitude > 0.1 then
                frontDir = look.Unit
            else
                local to = Vector3.new(predicted.X - root.Position.X, 0, predicted.Z - root.Position.Z)
                frontDir = to.Magnitude > 0.1 and to.Unit or Vector3.new(0, 0, -1)
            end
        end

        local seat
        if BYPASS_STANDOFF then
            local aimPoint = predicted + frontDir * FRONT_LEAD + Vector3.new(0, SEAT_Y, 0)
            local toAim = aimPoint - root.Position
            local unit = toAim.Magnitude > 0.01 and toAim.Unit or Vector3.zero
            seat = aimPoint - unit * STANDOFF_DIST + Vector3.new(0, STANDOFF_HEIGHT, 0)
        else
            local close    = liveDist < CLOSE_DIST
            local frontLead = close and FRONT_LEAD_CLOSE or FRONT_LEAD
            local seatY     = close and SEAT_Y_CLOSE     or SEAT_Y
            local toBody    = Vector3.new(predicted.X - root.Position.X, 0, predicted.Z - root.Position.Z)
            local bodyPull  = toBody.Magnitude > 0.1 and toBody.Unit * BODY_PULL or Vector3.zero
            seat = predicted + frontDir * frontLead + bodyPull + Vector3.new(0, seatY, 0)
        end

        local chaseDelta = seat - root.Position
        local chaseFlat  = Vector3.new(chaseDelta.X, 0, chaseDelta.Z)

        local faceDelta
        if horizVel.Magnitude > 2.5 then
            faceDelta = (predicted + frontDir * PATH_LOOK + Vector3.new(0, 1.2, 0)) - root.Position
        else
            faceDelta = chaseDelta
        end
        local faceFlat = Vector3.new(faceDelta.X, 0, faceDelta.Z)
        if faceFlat.Magnitude > 0.08 then
            local yawError = (math.deg(math.atan2(-faceFlat.X, -faceFlat.Z)) - root.Orientation.Y + 180) % 360 - 180
            local pitchError = (math.deg(math.atan2(faceDelta.Y, math.max(faceFlat.Magnitude, 0.01))) - root.Orientation.X + 180) % 360 - 180
            local yaw   = math.clamp(math.rad(yawError)   * ROT_YAW_GAIN,   -ROT_YAW_MAX,   ROT_YAW_MAX)
            local pitch = math.clamp(math.rad(pitchError) * ROT_PITCH_GAIN, -ROT_PITCH_MAX, ROT_PITCH_MAX)
            local facingYaw = math.rad(root.Orientation.Y)
            local facing    = Vector3.new(math.cos(facingYaw), 0, -math.sin(facingYaw))
            root.AssemblyAngularVelocity = Vector3.new(0, yaw, 0) + facing * pitch
        else
            root.AssemblyAngularVelocity = Vector3.zero
        end

        local matchVel = horizVel
        if matchVel.Magnitude > SPEED then matchVel = matchVel.Unit * SPEED end
        local toward
        if chaseFlat.Magnitude > 0.2 then
            toward = chaseFlat.Unit * SPEED
        else
            toward = frontDir * SPEED
        end
        local horizontal = toward:Lerp(matchVel, 0.32)
        if horizontal.Magnitude > 0.05 then
            if chaseFlat.Magnitude > 0.2 then
                horizontal = horizontal.Unit * SPEED
            elseif horizontal.Magnitude > SPEED then
                horizontal = horizontal.Unit * SPEED
            end
        end

        local verticalY
        if math.abs(chaseDelta.Y) > 0.12 then
            verticalY = math.clamp(math.sign(chaseDelta.Y) * SPEED + predictedVelocity.Y * VERT_MATCH, -SPEED, SPEED)
        else
            verticalY = predictedVelocity.Y * VERT_MATCH - 1.2
        end

        intendedVelocity = Vector3.new(horizontal.X, verticalY, horizontal.Z)
        root.AssemblyLinearVelocity = intendedVelocity

        if chaseFlat.Magnitude > 0.3 then
            pcall(function() humanoid:Move(chaseFlat.Unit, false) end)
        end

        if bat and bat.Parent == currentChar and liveDist <= ACTIVATE_DISTANCE
            and (now - lastActivationTime) >= SWING_COOLDOWN then
            pcall(function() bat:Activate() end)
            pcall(function()
                for _, d in ipairs(bat:GetDescendants()) do
                    if d:IsA("RemoteEvent") then
                        pcall(function() d:FireServer() end)
                        break
                    end
                end
            end)
            lastActivationTime = now
        end

        local curVel   = root.AssemblyLinearVelocity
        local horizMag = math.sqrt(curVel.X * curVel.X + curVel.Z * curVel.Z)

        if horizMag > FLING_CLAMP then
            root.AssemblyLinearVelocity = intendedVelocity
            root.AssemblyAngularVelocity = Vector3.zero
            wasFlung = true
            flingHoldLeft = FLING_HOLD_FRAMES
            flingRecoveries = flingRecoveries + 1
        elseif wasFlung then
            if flingHoldLeft > 0 then
                root.AssemblyLinearVelocity = intendedVelocity
                flingHoldLeft = flingHoldLeft - 1
            else
                wasFlung = false
            end
        end

        _G._aimbotTarget = targetRoot
        _G._aimbotTargetPlr = plr
    end)
end

