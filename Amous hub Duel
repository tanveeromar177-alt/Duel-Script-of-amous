local subtitles = {
	Explore = "Catbox songs: download first, then play",
	Playlist = "Songs you added",
	Downloads = "Ready to play offline",
	Artists = "Sorted by artist",
	History = "Recently played",
}
local function getView()
	local out = {}
	local source = known
	if tab == "History" then source = history end
	local q = norm(query)
	for _, s in ipairs(source) do
		local ok = true
		if tab == "Playlist" and not s.inPlaylist then ok = false end
		if tab == "Downloads" and not s.downloaded then ok = false end
		if q ~= "" and not norm(s.title):find(q, 1, true) then ok = false end
		if ok then table.insert(out, s) end
	end
	if tab == "Artists" then
		table.sort(out, function(a, b)
			if a.artist == b.artist then return a.title < b.title end
			return a.artist < b.artist
		end)
	end
	return out
end
function refresh()
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("Frame") then c:Destroy() end
	end
	rowRefs = {}
	local view = getView()
	titleLbl.Text = tab
	if norm(query) ~= "" then
		subLbl.Text = "Results for \"" .. query .. "\""
	else
		subLbl.Text = subtitles[tab]
	end
	countLbl.Text = #view .. " TRACKS"
	if #view == 0 then
		local empty = make("Frame", { Size = UDim2.new(1, 0, 0, 120), BackgroundTransparency = 1 }, list)
		make("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
			Text = (norm(query) ~= "") and "No songs match your search" or "Nothing here yet", Font = FONT, TextSize = 13, TextColor3 = C.sub,
		}, empty)
		return
	end
	for i, s in ipairs(view) do
