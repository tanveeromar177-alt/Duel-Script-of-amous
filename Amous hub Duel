	end
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if backpack then
		for _, child in ipairs(backpack:GetChildren()) do
			if child:IsA("Tool") and isMedusaTool(child) then return child end
		end
	end
	return nil
end

local function medusaTrigger()
	if not pillOn(G.WaveTogglePill_27) or medusaBusy then return end
	if tick() - medusaLastUse < MEDUSA_COOLDOWN then return end
	local char = LocalPlayer.Character
	if not char then return end
	medusaBusy = true
	local ok = pcall(function()
		local tool = findMedusaTool()
