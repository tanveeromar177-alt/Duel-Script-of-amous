-- ==========================================================================
-- ADDED: CONFIG AUTOSAVE + SHARE / IMPORT + LAYOUT PERSISTENCE
--   There is no "Save Config" button any more: everything saves itself. "Share Config" / "Import Config" (Interface page)
--   are ported from the Vx7 "Share Config" panel: a WINDCFG1:<json> code (copied to the clipboard) with the scopes
--   FULL (settings + binds) / CONFIG (no keybinds) / KEYBINDS (binds only); importing applies the code and autosaves it.
--   Saved: every toggle, every textbox,
--          UI Size, Mobile Button Size, position of the main window, the steal bar
--          and each mobile button. A hidden autosave ("_autosave") is written ~1s after
--          any change and loaded on start, so positions survive a re-execute.
--   Storage: executor file API (writefile/readfile/...) in WindHub/configs/_autosave.json,
--            falls back to memory (getgenv) when the executor has no file API.
-- ==========================================================================
local HttpService = game:GetService("HttpService")

local CONFIG_DIR = "WindHub"
local CONFIG_SUBDIR = "WindHub/configs"
local AUTOSAVE_NAME = "_autosave"
local CONFIG_VERSION = 1

local envOk, executorEnv = pcall(function() return getgenv() end)
if not envOk or type(executorEnv) ~= "table" then executorEnv = _G end
executorEnv.__WindConfigStore = executorEnv.__WindConfigStore or {}
local memStore = executorEnv.__WindConfigStore

local hasFs = type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"

local function ensureDirs()
	if type(isfolder) == "function" and type(makefolder) == "function" then
		pcall(function()
			if not isfolder(CONFIG_DIR) then makefolder(CONFIG_DIR) end
			if not isfolder(CONFIG_SUBDIR) then makefolder(CONFIG_SUBDIR) end
		end)
	end
end

local function configPath(name)
	return CONFIG_SUBDIR .. "/" .. name .. ".json"
end

local function writeConfig(name, tbl)
	local okEnc, json = pcall(HttpService.JSONEncode, HttpService, tbl)
	if not okEnc then return false end
	if hasFs then
		ensureDirs()
		local okW = pcall(writefile, configPath(name), json)
		if okW then return true end
	end
	memStore[name] = json
	return not hasFs -- with a file API a failed write is a real failure; memory-only mode counts as saved
end

local function readConfig(name)
	local raw
	if hasFs then
		local okE, exists = pcall(isfile, configPath(name))
		if okE and exists then
			local okR, data = pcall(readfile, configPath(name))
			if okR then raw = data end
		end
	end
	raw = raw or memStore[name]
	if type(raw) ~= "string" then return nil end
	local okD, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
	if okD and type(decoded) == "table" then return decoded end
	return nil
end

