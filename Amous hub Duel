		local surface = s * 0.55
		local luma = 0.299 * accent.R + 0.587 * accent.G + 0.114 * accent.B
		return {
			bg = hsv(surface, 0.07),
			top = hsv(surface, 0.10),
			side = hsv(surface, 0.085),
			panel = hsv(surface * 0.9, 0.15),
			hover = hsv(surface * 0.8, 0.23),
			border = hsv(surface * 0.8, 0.36),
			accent = accent,
			accent2 = accent2,
			fill = accent,
