-- SPIN ON STEAL (Mist/Candy style fixed Y-axis spin while holding)
-- ═══════════════════════════════════════════════════════════════
local SpinOnSteal = (function()
    local state = {
        enabled = false,
        autoOnSteal = false,
        autoStarted = false,
        conn = nil,
        angle = 0,
        speed = 50,
    }

    local function startSpin()
        if state.conn then return end
        state.angle = 0
        state.conn = RunService.Heartbeat:Connect(function(dt)
            if not state.enabled then return end
            local char = LP.Character
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then pcall(function() hum.AutoRotate = false end) end
            local step = state.speed * (type(dt) == "number" and dt or (1 / 60)) * 60
            state.angle = (state.angle + step) % 360
            local pos = root.Position
            root.CFrame = CFrame.new(pos) * CFrame.Angles(0, math.rad(state.angle), 0)
            pcall(function() root.AssemblyAngularVelocity = Vector3.zero end)
        end)
    end

    local function stopSpin()
        if state.conn then
            state.conn:Disconnect()
            state.conn = nil
        end
        local char = LP.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then pcall(function() hum.AutoRotate = true end) end
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then pcall(function() root.AssemblyAngularVelocity = Vector3.zero end) end
        end
    end

    local function setSpin(on)
        state.enabled = on and true or false
        if state.enabled then startSpin() else stopSpin() end
        return state.enabled
    end

    local function isHoldingForSpin()
        local char = LP.Character
        if not char then return false end
        -- Attribute checks (player + character)
        for _, holder in ipairs({ "Stealing", "Carrying", "IsCarrying", "HoldingBrainrot", "HasBrainrot", "StealHold" }) do
            local ok1, value1 = pcall(function() return LP:GetAttribute(holder) end)
            if ok1 and value1 == true then return true end
            local ok2, value2 = pcall(function() return char:GetAttribute(holder) end)
            if ok2 and value2 == true then return true end
        end
        -- Tool / object name heuristics
        for _, child in ipairs(char:GetChildren()) do
            local lower = string.lower(child.Name)
            if lower:find("brainrot", 1, true) or lower:find("animal", 1, true)
                or lower:find("stolen", 1, true) or lower:find("carry", 1, true)
                or lower:find("steal", 1, true) then
                return true
            end
        end
        -- WalkSpeed carry heuristic (common in these games)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.WalkSpeed > 0 and hum.WalkSpeed <= 25 and hum.WalkSpeed ~= 16 then
            return true
        end
        return false
    end

    local function setAutoOnSteal(on)
        state.autoOnSteal = on and true or false
        spinOnStealEnabled = state.autoOnSteal
        if not state.autoOnSteal and state.autoStarted then
            state.autoStarted = false
            setSpin(false)
        end
        if setSpinOnStealVisual then setSpinOnStealVisual(state.autoOnSteal) end
        return state.autoOnSteal
    end

    -- Watch loop: start spin when holding, stop when not
    task.spawn(function()
        local wasHolding = false
        while true do
            task.wait(0.08)
            if state.autoOnSteal then
                local holding = isHoldingForSpin()
                if holding and not wasHolding then
                    wasHolding = true
                    if not state.enabled then
                        state.autoStarted = true
                        setSpin(true)
                    end
                elseif not holding and wasHolding then
                    wasHolding = false
                    if state.autoStarted then
                        state.autoStarted = false
                        setSpin(false)
                    end
                end
            else
                wasHolding = false
                if state.autoStarted then
                    state.autoStarted = false
                    if state.enabled then setSpin(false) end
                end
            end
        end
    end)

    LP.CharacterAdded:Connect(function()
        if state.enabled then
            -- restart spin connection after respawn if still active
            stopSpin()
            if state.autoOnSteal or state.enabled then
                task.defer(function()
                    if state.enabled then startSpin() end
                end)
            end
        end
    end)

    return {
        SetEnabled = setAutoOnSteal,
        SetSpin = setSpin,
        Stop = function()
            state.autoOnSteal = false
            state.autoStarted = false
            setSpin(false)
        end,
        IsEnabled = function() return state.autoOnSteal end,
    }
end)()
_G.HazeSpinOnSteal = SpinOnSteal

