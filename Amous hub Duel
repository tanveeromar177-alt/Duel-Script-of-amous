do
    print("[IR] 1. inicio")

    if _G.InstaResetLoaded then
        print("[IR] ya cargado")
    else
        _G.InstaResetLoaded = true

        local resetCooldown          = false
        local resetThread            = nil
        local currentResetChar       = nil
        local resetSuccessful        = false
        local stopResetSequence      = false
        local cameraLocked           = false
        local lockedCameraCFrame     = nil
        local _lastInstaResetRequest = 0

        print("[IR] 2. servicios OK, LP =", LP and LP.Name)

        local function instaResetFast()
            if resetCooldown then return end
            resetCooldown     = true
            resetSuccessful   = false
            stopResetSequence = false
            cameraLocked      = false

            local character = LP.Character
            if not character then resetCooldown = false return end
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if not humanoid then resetCooldown = false return end

            local cam = workspace.CurrentCamera
            if cam then
                lockedCameraCFrame = cam.CFrame
                cameraLocked       = true
                cam.CFrame         = lockedCameraCFrame
            end

            currentResetChar = character
            local isRespawning = false

            resetThread = task.spawn(function()
                local attempts          = 0
                local maxAttempts       = 40
                local originalHipHeight = humanoid.HipHeight

                while character and character.Parent and humanoid and humanoid.Health > 0
                      and not isRespawning and not stopResetSequence do
                    if LP.Character ~= character then
                        isRespawning = true
                        break
                    end
                    pcall(function()
                        humanoid.HipHeight  = 1e30
                        humanoid.AutoRotate = true
                        local rootPart = character:FindFirstChild("HumanoidRootPart")
                        if rootPart then rootPart.CanCollide = false end
                        for _, part in ipairs(character:GetChildren()) do
                            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                                part.CanCollide = false
                            end
                        end
                    end)

                    if not character or not character.Parent or not humanoid
                       or humanoid.Health <= 0 or LP.Character ~= character then
                        resetSuccessful = true
                        break
                    end

                    attempts = attempts + 1
                    if attempts >= maxAttempts then break end
                    task.wait(0.05)
                end

                if not resetSuccessful then
                    if character and character.Parent and humanoid
                       and humanoid.Health > 0 and not isRespawning then
                        pcall(function() humanoid.Health = 0 end)
                        task.wait(0.1)
                        if not character.Parent or humanoid.Health <= 0 then
                            resetSuccessful = true
                        end
                    end
                end

                if not resetSuccessful and character and character.Parent and humanoid then
                    pcall(function()
                        humanoid.HipHeight = originalHipHeight
                        local rootPart = character:FindFirstChild("HumanoidRootPart")
                        if rootPart then rootPart.CanCollide = true end
                        for _, part in ipairs(character:GetChildren()) do
                            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                                part.CanCollide = true
                            end
                        end
                    end)
                end

                cameraLocked      = false
                resetCooldown     = false
                resetThread       = nil
                currentResetChar  = nil
                stopResetSequence = false
            end)
        end

        local function instaReset()
            local now = os.clock()
            if now - _lastInstaResetRequest < 0.75 then return end
            _lastInstaResetRequest = now
            instaResetFast()
        end

        print("[IR] 3. función lista")

        LP.CharacterAdded:Connect(function()
            stopResetSequence = true
            if resetThread then pcall(task.cancel, resetThread); resetThread = nil end
            resetCooldown    = false
            currentResetChar = nil
            cameraLocked     = false
        end)

        task.spawn(function()
            while true do
                task.wait(0.016)
                local cam = workspace.CurrentCamera
                if cameraLocked and lockedCameraCFrame and cam then
                    cam.CFrame = lockedCameraCFrame
                end
            end
        end)

        print("[IR] 4. loop cámara iniciado")

        _G.InstaReset = { Trigger = instaReset }
    end
end

-- AUTO FONT PACK DATA (TrueType, v2). Each pack is a real .ttf, written to disk at runtime
-- together with a Roblox font-family .json (Font.new needs the family file, not the raw font).
local HAZE_FONT_PACKS = {
  Grape  = { file = "Haze_Grape_Squishy_v2.ttf", family = "Haze Grape Squishy", data = [[]] },
  Matcha = { file = "Haze_Matcha_Boom_v2.ttf",   family = "Haze Matcha Boom",   data = [[]] },
  Spicy  = { file = "Haze_Spicy_Sale_v2.ttf",    family = "Haze Spicy Sale",    data = [[]] },
}

-- ═══════════════════════════════════════════════════════════════
-- CUSTOM FONTS (Grape / Matcha / Spicy + Normal)
-- currentCustomFont is a GLOBAL on purpose: saveAllSettings() earlier in this file reads it,
-- and as a local declared down here it was invisible there (config always saved "Normal").
-- Everything else lives inside the do-block to stay under the 200-locals limit.
-- ═══════════════════════════════════════════════════════════════
currentCustomFont = "Normal" -- Normal | Grape | Matcha | Spicy
local customFontFace = nil   -- active Font object, nil when Normal
local setFontSelectorVisual = nil
local applyFontToInstance

do
    local HttpService = game:GetService("HttpService")
    local TextService = game:GetService("TextService")
    local FONT_DIR = "HazeFonts"
    local TEXT_CLASS = { TextLabel = true, TextButton = true, TextBox = true }

    local packCache = {}                              -- name -> { face, family, bytes, verified }
    local origFace = setmetatable({}, { __mode = "k" }) -- inst -> FontFace before we touched it
    local hooked = setmetatable({}, { __mode = "k" })   -- inst -> true (property hooks installed)
    local applying = {}                               -- inst -> true while WE write FontFace
    local watchConns = {}
    local activeFace, activeFamily = nil, nil
    local generation = 0

    local function log(...) print("[HAZE FONT]", ...) end

    -- ── base64 ────────────────────────────────────────────────
    local B64 = {}
    do
        local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
        for i = 1, #alphabet do B64[string.byte(alphabet, i)] = i - 1 end
    end

    local function b64decode(data)
        data = (string.gsub(data, "[^%w%+/]", ""))
        local out, n, len, i = {}, 0, #data, 1
        while i + 3 <= len do
            local a, b, c, d = string.byte(data, i, i + 3)
            local v = B64[a] * 262144 + B64[b] * 4096 + B64[c] * 64 + B64[d]
            n = n + 1
            out[n] = string.char(math.floor(v / 65536), math.floor(v / 256) % 256, v % 256)
            i = i + 4
        end
        local rest = len - i + 1
        if rest == 2 then
            local a, b = string.byte(data, i, i + 1)
            n = n + 1
            out[n] = string.char(B64[a] * 4 + math.floor(B64[b] / 16))
        elseif rest == 3 then
            local a, b, c = string.byte(data, i, i + 2)
            local v = B64[a] * 1024 + B64[b] * 16 + math.floor(B64[c] / 4)
            n = n + 1
            out[n] = string.char(math.floor(v / 256), v % 256)
        end
        return table.concat(out)
    end

    local function looksLikeTTF(raw)
        return type(raw) == "string" and #raw > 1000 and string.sub(raw, 1, 4) == "\0\1\0\0"
    end

    local function decodeFont(data)
        local clean = (string.gsub(data, "%s", ""))
        local attempts = {
            function() return crypt.base64decode(clean) end,
            function() return crypt.base64.decode(clean) end,
            function() return base64_decode(clean) end,
            function() return b64decode(clean) end,
        }
        for _, fn in ipairs(attempts) do
            local ok, raw = pcall(fn)
            if ok and looksLikeTTF(raw) then return raw end
        end
        return nil
    end

    -- ── font file -> family json -> Font object ───────────────
    local function verifyFace(rec, label)
        if rec.verified then return end
        rec.verified = true
        task.spawn(function()
            local ok, res = pcall(function()
                local p = Instance.new("GetTextBoundsParams")
                p.Text = "Haze Hub 123"
                p.Font = rec.face
                p.Size = 24
                p.Width = 10000
                return TextService:GetTextBoundsAsync(p)
            end)
            if ok then
                log(label, "engine loaded the font OK (test text width " .. tostring(res.X) .. ")")
            else
                warn("[HAZE FONT] " .. label .. " engine could NOT load the font: " .. tostring(res))
            end
        end)
    end

    local function loadPack(name)
        if packCache[name] then return packCache[name] end
        local entry = HAZE_FONT_PACKS[name]
        if not entry then return nil, "unknown font pack" end
        if type(writefile) ~= "function" or type(getcustomasset) ~= "function" then
            return nil, "this executor has no writefile/getcustomasset"
        end
        local raw = decodeFont(entry.data)
        if not raw then return nil, "embedded font data did not decode to a TrueType file" end

        local prefix = ""
        pcall(function()
            if type(isfolder) == "function" and type(makefolder) == "function" then
                if not isfolder(FONT_DIR) then makefolder(FONT_DIR) end
                prefix = FONT_DIR .. "/"
            end
        end)
        local fontPath = prefix .. entry.file
        local jsonPath = prefix .. (string.gsub(entry.file, "%.ttf$", "")) .. ".json"

        local ok, err = pcall(writefile, fontPath, raw)
        if not ok then return nil, "writefile(font) failed: " .. tostring(err) end
        local okA, fontAsset = pcall(getcustomasset, fontPath)
        if not okA or type(fontAsset) ~= "string" or fontAsset == "" then
            return nil, "getcustomasset(font) failed: " .. tostring(fontAsset)
        end

        local json = HttpService:JSONEncode({
            name = entry.family,
            faces = { { name = "Regular", weight = 400, style = "normal", assetId = fontAsset } },
        })
        ok, err = pcall(writefile, jsonPath, json)
        if not ok then return nil, "writefile(family json) failed: " .. tostring(err) end
        local okB, famAsset = pcall(getcustomasset, jsonPath)
        if not okB or type(famAsset) ~= "string" or famAsset == "" then
            return nil, "getcustomasset(family json) failed: " .. tostring(famAsset)
        end

        local okF, face = pcall(Font.new, famAsset, Enum.FontWeight.Regular, Enum.FontStyle.Normal)
        if not okF then return nil, "Font.new failed: " .. tostring(face) end

        local rec = { face = face, family = famAsset, bytes = #raw, verified = false }
        packCache[name] = rec
        log(name, "written", #raw, "bytes;", "family asset =", famAsset)
        return rec
    end

    -- ── applying / restoring ──────────────────────────────────
    local function getClass(x) return x.ClassName end
    local function readFace(x) return x.FontFace end
    local function writeFace(x, f) x.FontFace = f end

    local function classOf(x)
        local ok, c = pcall(getClass, x)
        if ok then return c end
        return nil
    end

    local function setFace(inst, f)
        applying[inst] = true
        pcall(writeFace, inst, f)
        applying[inst] = nil
    end

    local function hook(inst)
        if hooked[inst] then return end
        hooked[inst] = true
        local function onChanged()
            local face = activeFace
            if not face or applying[inst] then return end
            local ok, cur = pcall(readFace, inst)
            if not ok or cur.Family == activeFamily then return end
            origFace[inst] = cur -- the game/hub changed the font itself: remember it as the new original
            setFace(inst, face)
        end
        pcall(function()
            inst:GetPropertyChangedSignal("FontFace"):Connect(onChanged)
            inst:GetPropertyChangedSignal("Font"):Connect(onChanged)
        end)
    end

    applyFontToInstance = function(inst, face)
        if not inst or not TEXT_CLASS[classOf(inst)] then return end
        if face then
            local ok, cur = pcall(readFace, inst)
            if not ok then return end
            if origFace[inst] == nil and cur.Family ~= face.Family then origFace[inst] = cur end
            hook(inst)
            if cur.Family ~= face.Family then setFace(inst, face) end
        else
            local o = origFace[inst]
            if o ~= nil then
                setFace(inst, o)
                origFace[inst] = nil
            end
        end
    end

    local function restoreAll()
        for inst, o in pairs(origFace) do
            setFace(inst, o)
            origFace[inst] = nil
        end
    end

    -- ── roots + live watching ─────────────────────────────────
    -- Roblox's own CoreGui (topbar, chat, menus) is deliberately NOT touched: restyling it garbled the
    -- topbar/chat. Inside CoreGui only ScreenGuis marked HazeOwned (the hub's own) get the font.
    local CoreGuiSvc = nil
    pcall(function() CoreGuiSvc = game:GetService("CoreGui") end)

    local function isOwnedGui(g)
        local ok, v = pcall(function() return g:GetAttribute("HazeOwned") == true end)
        return ok and v == true
    end

    local function collectRoots()
        local roots = {}
        local function add(r)
            if not r or r == CoreGuiSvc then return end
            for _, e in ipairs(roots) do
                if e == r or r:IsDescendantOf(e) then return end
            end
            roots[#roots + 1] = r
        end
        pcall(function() if type(gethui) == "function" then add(gethui()) end end)
        pcall(function() add(LP:FindFirstChildOfClass("PlayerGui") or LP:WaitForChild("PlayerGui", 3)) end)
        add(workspace) -- BillboardGui / SurfaceGui text placed in the map
        return roots
    end

    local function onAdded(obj)
        local face = activeFace
        if face and TEXT_CLASS[classOf(obj)] then applyFontToInstance(obj, face) end
    end

    local function disconnectWatchers()
        for _, c in ipairs(watchConns) do pcall(function() c:Disconnect() end) end
        watchConns = {}
    end

    local function scanTree(root, face, gen)
        local ok, desc = pcall(root.GetDescendants, root)
        if not ok then return end
        for i = 1, #desc do
            if gen ~= generation then return end
            applyFontToInstance(desc[i], face)
            if i % 600 == 0 then task.wait() end
        end
    end

    function applyCustomFont(name)
        if name ~= "Grape" and name ~= "Matcha" and name ~= "Spicy" then name = "Normal" end
        generation = generation + 1
        local gen = generation
        disconnectWatchers()

        local rec
        if name ~= "Normal" then
            local err
            rec, err = loadPack(name)
            if not rec then
                warn("[HAZE FONT] could not load '" .. name .. "': " .. tostring(err) .. " -> staying on Normal")
                name = "Normal"
            end
        end

        if name == "Normal" then
            currentCustomFont = "Normal"
            customFontFace = nil
            activeFace, activeFamily = nil, nil
            restoreAll()
        else
            currentCustomFont = name
            customFontFace = rec.face
            activeFace = rec.face
            activeFamily = rec.face.Family
            verifyFace(rec, name)
            task.spawn(function()
                local roots = collectRoots()
                if gen ~= generation then return end
                local function watch(r)
                    local ok, conn = pcall(function() return r.DescendantAdded:Connect(onAdded) end)
                    if ok and conn then watchConns[#watchConns + 1] = conn end
                end
                local owned = {}
                if CoreGuiSvc then
                    for _, ch in ipairs(CoreGuiSvc:GetChildren()) do
                        if isOwnedGui(ch) then owned[#owned + 1] = ch end
                    end
                    local ok, conn = pcall(function()
                        return CoreGuiSvc.ChildAdded:Connect(function(ch)
                            if gen ~= generation or not isOwnedGui(ch) then return end
                            watch(ch)
                            task.spawn(scanTree, ch, rec.face, gen)
                        end)
                    end)
                    if ok and conn then watchConns[#watchConns + 1] = conn end
                end
                for _, g in ipairs(owned) do watch(g) end
                for _, r in ipairs(roots) do watch(r) end
                for _, g in ipairs(owned) do
                    scanTree(g, rec.face, gen)
                    if gen ~= generation then return end
                end
                for _, r in ipairs(roots) do
                    scanTree(r, rec.face, gen)
                    if gen ~= generation then return end
                end
                log(name, "applied to", #owned, "hub gui(s) +", #roots, "root(s)")
            end)
        end

        if setFontSelectorVisual then setFontSelectorVisual(currentCustomFont) end
    end
end

_G.HazeApplyCustomFont = applyCustomFont

