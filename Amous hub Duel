		positions = {},
		scales = { ui = currentScale, buttons = buttonScale },
		binds = { tpDown = keyBinds.tpDown, drop = keyBinds.drop, speed = keyBinds.speed, aimbot = keyBinds.aimbot, autoLeft = keyBinds.autoLeft, autoRight = keyBinds.autoRight, batTp = keyBinds.batTp, spinbot = keyBinds.spinbot },
		speed = speedCtl.getState and speedCtl.getState() or nil,
		aim = aimCtl.getState and aimCtl.getState() or nil,
		visuals = G.VisualsCtl and G.VisualsCtl.getState and G.VisualsCtl.getState() or nil,
	}
	for key, inst in pairs(G) do
		if typeof(inst) == "Instance" then
			if inst:IsA("Frame") and key:match("^WaveTogglePill") then
				state.toggles[key] = inst:GetAttribute("WaveToggleOn") == true
			elseif inst:IsA("TextBox") then
				state.texts[key] = inst.Text
			end
		end
	end
	for _, entry in ipairs(trackedFrames) do
		state.positions[entry[1]] = udim2ToTable(entry[2].Position)
	end
	return state
end

local loadingState = false

local function applyState(state)
	if type(state) ~= "table" then return false end
	loadingState = true
	local ok = pcall(function()
		-- 1) textboxes
		if type(state.texts) == "table" then
			for key, text in pairs(state.texts) do
				local box = G[key]
				if type(key) == "string" and typeof(box) == "Instance" and box:IsA("TextBox")
					and type(text) == "string" and #text <= 64 then
					box.Text = text
				end
			end
		end

		-- 2) scales (set raw: saved button positions already match the saved button scale)
		if type(state.scales) == "table" then
			local ui, btn = state.scales.ui, state.scales.buttons
			if type(ui) == "number" and ui == ui and math.abs(ui) ~= math.huge then
				currentScale = math.clamp(ui, SIZE_MIN, SIZE_MAX)
			end
			if type(btn) == "number" and btn == btn and math.abs(btn) ~= math.huge then
				buttonScale = math.clamp(btn, SIZE_MIN, SIZE_MAX)
			end
			G.UIScale.Scale = currentScale
			G.WAVEButtonScale.Scale = buttonScale
			G.TextBox_12.Text = sizeText(currentScale)
			G.TextBox_13.Text = sizeText(buttonScale)
		end

		-- 3) positions
		if type(state.positions) == "table" then
			for _, entry in ipairs(trackedFrames) do
				local pos = tableToUDim2(state.positions[entry[1]])
				if pos then entry[2].Position = pos end
			end
		end

		-- 4) key binds
		if type(state.binds) == "table" then
			for name, key in pairs(state.binds) do
				if bindButtons[name] and validKeyName(key) then
					keyBinds[name] = key
					bindButtons[name].Text = key
				end
			end
		end

		-- 4b) speed mode + lagger mode
		if type(state.speed) == "table" and speedCtl.setState then
			speedCtl.setState(state.speed)
		end

		-- 4c) bat aimbot mode + per-mode speeds (older configs have none: the restored boxes then feed the active mode)
		if type(state.aim) == "table" and aimCtl.setState then
			aimCtl.setState(state.aim)
		elseif aimCtl.syncFromBoxes then
			aimCtl.syncFromBoxes()
		end

		-- 4d) visuals: FOV slider value, set before the toggles so FOV starts with the saved value
		if type(state.visuals) == "table" and G.VisualsCtl and G.VisualsCtl.setState then
			G.VisualsCtl.setState(state.visuals)
		end

		-- 5) toggles last, so features read the final textbox values
		if type(state.toggles) == "table" then
			for key, on in pairs(state.toggles) do
				local pill = G[key]
				if type(key) == "string" and key:match("^WaveTogglePill") and typeof(pill) == "Instance"
					and pill:IsA("Frame") and type(on) == "boolean" then
					setToggleVisual(pill, on)
				end
			end
		end
	end)
	loadingState = false
	return ok
end

local defaultState = captureState() -- factory layout/values, used by "Reset Config"

-- keeps a restored layout from landing off-screen (e.g. config saved on a bigger screen)
local function rescueOffscreenFrames()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local vs = cam.ViewportSize
	if vs.X <= 0 or vs.Y <= 0 then return end
	for _, entry in ipairs(trackedFrames) do
		local frame = entry[2]
		local size, pos = frame.AbsoluteSize, frame.AbsolutePosition
		if size.X > 0 and size.Y > 0 then
			local cx, cy = pos.X + size.X / 2, pos.Y + size.Y / 2
			if cx < 0 or cx > vs.X or cy < 0 or cy > vs.Y then
				local fallback = tableToUDim2(defaultState.positions[entry[1]])
				if fallback then frame.Position = fallback end
			end
		end
	end
end

-- ---------- layout (positions saved instantly after every drag) ----------
local LAYOUT_NAME = "_layout"

local function saveLayoutNow()
	if loadingState then return end
	local positions = {}
	for _, entry in ipairs(trackedFrames) do
		positions[entry[1]] = udim2ToTable(entry[2].Position)
	end
	writeConfig(LAYOUT_NAME, { version = CONFIG_VERSION, positions = positions })
end
G.OnLayoutChanged = saveLayoutNow

-- ---------- autosave ----------
local autosaveQueued = false
local lastAutosaveJson

local function runAutosave()
	if loadingState then return end
	saveLayoutNow()
	local okEnc, json = pcall(HttpService.JSONEncode, HttpService, captureState())
	if not okEnc or json == lastAutosaveJson then return end
	if writeConfig(AUTOSAVE_NAME, captureState()) then
		lastAutosaveJson = json
	end
end

local function scheduleAutosave()
	if loadingState or autosaveQueued then return end
	autosaveQueued = true
	task.delay(1, function()
		autosaveQueued = false
		runAutosave()
	end)
end

-- restore last session
do
	local saved = readConfig(AUTOSAVE_NAME)
	if saved then applyState(saved) end
	local layout = readConfig(LAYOUT_NAME) -- newer than the autosave positions, so it wins
	if layout and type(layout.positions) == "table" then
		loadingState = true
		for _, entry in ipairs(trackedFrames) do
			local pos = tableToUDim2(layout.positions[entry[1]])
			if pos then entry[2].Position = pos end
		end
		loadingState = false
	end
	task.delay(1.5, rescueOffscreenFrames)
	local okEnc, json = pcall(HttpService.JSONEncode, HttpService, captureState())
	if okEnc then lastAutosaveJson = json end
end

for key, inst in pairs(G) do
	if typeof(inst) == "Instance" then
		if inst:IsA("Frame") and key:match("^WaveTogglePill") then
			inst:GetAttributeChangedSignal("WaveToggleOn"):Connect(scheduleAutosave)
		elseif inst:IsA("TextBox") then
			inst.FocusLost:Connect(scheduleAutosave)
		end
	end
end
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		scheduleAutosave() -- drag ended / tap finished
	end
end)

-- ---------- Share Config / Import Config (ported from Vx7 "Share Config") ----------
bindChangedHook = scheduleAutosave

G.TextButton_59.MouseButton1Click:Connect(function() -- Reset Config
	applyState(defaultState)
	task.delay(0.2, rescueOffscreenFrames)
	scheduleAutosave()
end)

do
	local SHARE_PREFIX = "WINDCFG1:"
	local MAX_CODE_LENGTH = 300000
	local PANEL_HEIGHT = 172
	local SCOPES = {
		{ "full", "FULL", "Settings + binds" },
		{ "config", "CONFIG", "No keybinds" },
		{ "keybinds", "KEYBINDS", "Binds only" },
	}
	local SCOPE_DONE = { full = "Full config", config = "Config only", keybinds = "Keybinds only" }
	-- Vx7 clears the toggles that drive your character when a config is imported (batAimbotToggled, batTpEnabled, lagger...).
	-- Same here: an imported code never switches Bat Aimbot / Bat TP / Lagger on by itself.
	local IMPORT_FORCE_OFF = { "WaveTogglePill_22", "WaveTogglePill_BatTP", "WaveTogglePill_Spinbot" }

	local panel = G.Frame_SharePanel
	local COLOR_TEXT = Color3.fromRGB(185, 195, 215)
	local COLOR_OK = Color3.fromRGB(151, 224, 174)
	local COLOR_WARN = Color3.fromRGB(225, 195, 125)
	local COLOR_ERR = Color3.fromRGB(235, 115, 115)

	local function addCorner(inst, r)
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, r)
		c.Parent = inst
	end

	local function makeLabel(text, pos, size, textSize, color, align)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Position = pos
		l.Size = size
		l.ZIndex = 9
		l.FontFace = G.SpicyFont
		l.Text = text
		l.TextColor3 = color
		l.TextSize = textSize
		l.TextXAlignment = align or Enum.TextXAlignment.Left
		l.Parent = panel
		return l
	end

	local titleLabel = makeLabel("", UDim2.new(0, 8, 0, 5), UDim2.new(1, -16, 0, 16), 11, Color3.fromRGB(225, 230, 240))
	local hintLabel = makeLabel("", UDim2.new(0, 8, 0, 21), UDim2.new(1, -16, 0, 12), 9, Color3.fromRGB(144, 56, 71))

	-- scope buttons (share mode only)
	local scopeRow = Instance.new("Frame")
	scopeRow.BackgroundTransparency = 1
	scopeRow.Position = UDim2.new(0, 6, 0, 38)
	scopeRow.Size = UDim2.new(1, -12, 0, 32)
	scopeRow.ZIndex = 9
	scopeRow.Parent = panel
	local scopeLayout = Instance.new("UIListLayout")
	scopeLayout.FillDirection = Enum.FillDirection.Horizontal
	scopeLayout.SortOrder = Enum.SortOrder.LayoutOrder
	scopeLayout.Padding = UDim.new(0, 4)
	scopeLayout.Parent = scopeRow

	local scope = "full"
	local scopeButtons = {}
	local function refreshScopeButtons()
		for key, btn in pairs(scopeButtons) do
			local on = key == scope
			btn.BackgroundColor3 = on and Color3.fromRGB(128, 16, 35) or Color3.fromRGB(55, 12, 19)
			btn.TextColor3 = on and Color3.fromRGB(240, 245, 255) or Color3.fromRGB(144, 56, 71)
		end
	end
	for i, info in ipairs(SCOPES) do
		local b = Instance.new("TextButton")
		b.LayoutOrder = i
		b.Size = UDim2.new(1 / 3, -3, 1, 0)
		b.BorderSizePixel = 0
		b.AutoButtonColor = false
		b.ZIndex = 10
		b.FontFace = G.SpicyFont
		b.Text = info[2] .. "\n" .. info[3]
		b.TextWrapped = true
		b.TextSize = 9
		b.Parent = scopeRow
		addCorner(b, 4)
		scopeButtons[info[1]] = b
		b.MouseButton1Click:Connect(function()
			scope = info[1]
			refreshScopeButtons()
		end)
	end
	refreshScopeButtons()

	-- code box: a local on purpose (NOT stored in G, so the generic config capture never saves the pasted code)
	local codeBox = Instance.new("TextBox")
	codeBox.BackgroundColor3 = Color3.fromRGB(20, 3, 7)
	codeBox.BorderSizePixel = 0
	codeBox.Position = UDim2.new(0, 6, 0, 76)
	codeBox.Size = UDim2.new(1, -12, 0, 52)
	codeBox.ZIndex = 9
	codeBox.ClearTextOnFocus = false
	codeBox.MultiLine = true
	codeBox.TextWrapped = true
	codeBox.Font = Enum.Font.Code
	codeBox.Text = ""
	codeBox.PlaceholderText = "Paste a WINDCFG1 code here"
	codeBox.TextColor3 = Color3.fromRGB(220, 225, 235)
	codeBox.PlaceholderColor3 = Color3.fromRGB(100, 28, 40)
	codeBox.TextSize = 9
	codeBox.TextXAlignment = Enum.TextXAlignment.Left
	codeBox.TextYAlignment = Enum.TextYAlignment.Top
	codeBox.Parent = panel
	addCorner(codeBox, 4)

	local actionButton = Instance.new("TextButton")
	actionButton.BackgroundColor3 = Color3.fromRGB(128, 16, 35)
	actionButton.BorderSizePixel = 0
	actionButton.Position = UDim2.new(0, 6, 0, 134)
	actionButton.Size = UDim2.new(1, -12, 0, 24)
	actionButton.ZIndex = 9
	actionButton.FontFace = G.SpicyFont
	actionButton.TextColor3 = Color3.fromRGB(240, 245, 255)
	actionButton.TextSize = 11
	actionButton.Parent = panel
	addCorner(actionButton, 4)

	local statusLabel = makeLabel("", UDim2.new(0, 6, 0, 158), UDim2.new(1, -12, 0, 12), 9, COLOR_TEXT, Enum.TextXAlignment.Center)

	local function setStatus(text, color)
		statusLabel.Text = text
		statusLabel.TextColor3 = color or COLOR_TEXT
	end

	-- ---------- share ----------
	local function buildShareState(chosen)
		local state = captureState()
		state.positions = nil -- window / button layout belongs to this screen; every device keeps its own
		if chosen == "config" then
			state.binds = nil
		elseif chosen == "keybinds" then
			state = { version = state.version, binds = state.binds }
		end
		state._windShareScope = chosen
		return state
	end

	local function doShare()
		local okEnc, json = pcall(HttpService.JSONEncode, HttpService, buildShareState(scope))
		if not okEnc then
			setStatus("Could not create the config code", COLOR_ERR)
			return
		end
		local code = SHARE_PREFIX .. json
		codeBox.Text = code
		local copier = setclipboard or toclipboard
		local copied = type(copier) == "function" and (pcall(copier, code))
		if copied then
			setStatus(SCOPE_DONE[scope] .. " copied to clipboard", COLOR_OK)
		else
			setStatus("Code ready - copy it from the box", COLOR_WARN)
		end
	end

	-- ---------- import ----------
	local function trim(str)
		return (str:gsub("^%s+", ""):gsub("%s+$", ""))
	end

	local function doImport()
		local raw = trim(tostring(codeBox.Text or ""))
		if #raw == 0 or #raw > MAX_CODE_LENGTH then
			setStatus("Invalid config code", COLOR_ERR)
			return
		end
		if raw:sub(1, #SHARE_PREFIX) == SHARE_PREFIX then raw = raw:sub(#SHARE_PREFIX + 1) end
		local okDec, data = pcall(HttpService.JSONDecode, HttpService, raw)
		if not okDec or type(data) ~= "table" then
			setStatus("Invalid config code", COLOR_ERR)
			return
		end
		local known = false
		for _, key in ipairs({ "toggles", "texts", "binds", "scales", "speed", "aim", "visuals" }) do
			if type(data[key]) == "table" then known = true break end
		end
		if not known then
			setStatus("Invalid config code", COLOR_ERR)
			return
		end

		local importScope = data._windShareScope
		if importScope ~= "config" and importScope ~= "keybinds" then importScope = "full" end
		data._windShareScope = nil
		data.positions = nil -- never move windows from a shared code
		if importScope == "keybinds" then
			data = { version = data.version, binds = data.binds }
		else
			if importScope == "config" then data.binds = nil end
			-- the imported settings must not switch on anything that moves your character
			if type(data.toggles) == "table" then
				for _, key in ipairs(IMPORT_FORCE_OFF) do
					if data.toggles[key] ~= nil then data.toggles[key] = false end
				end
			end
			if type(data.speed) == "table" then data.speed.lagger = 0 end
		end

		if not applyState(data) then
			setStatus("Could not apply this config", COLOR_ERR)
			return
		end
		task.delay(0.2, rescueOffscreenFrames)
		scheduleAutosave() -- the imported state becomes the autosaved state
		setStatus(({
			full = "Full config applied",
			config = "Config applied without changing keybinds",
			keybinds = "Keybinds applied without changing config",
		})[importScope], COLOR_OK)
	end

	-- ---------- panel open / close ----------
	local mode = nil -- nil = closed, "share" or "import"
	local function setMode(newMode)
		mode = newMode
		panel.Visible = mode ~= nil
		panel.Size = UDim2.new(1, 0, 0, mode and PANEL_HEIGHT or 0)
		G.TextButton_ShareConfig.Text = mode == "share" and "Close Share" or "Share Config"
		G.TextButton_ImportConfig.Text = mode == "import" and "Close Import" or "Import Config"
		if mode == "share" then
			titleLabel.Text = "SHARE CONFIG"
			hintLabel.Text = "Select what to copy, then press COPY CODE"
			scopeRow.Visible = true
			codeBox.Text = ""
			codeBox.PlaceholderText = "Your WINDCFG1 code appears here"
			actionButton.Text = "COPY CODE"
			setStatus("")
		elseif mode == "import" then
			titleLabel.Text = "IMPORT CONFIG"
			hintLabel.Text = "Paste a code, then press APPLY CODE"
			scopeRow.Visible = false
			codeBox.Text = ""
			codeBox.PlaceholderText = "Paste a WINDCFG1 code here"
			actionButton.Text = "APPLY CODE"
			setStatus("")
		end
	end

	G.TextButton_ShareConfig.MouseButton1Click:Connect(function()
		setMode(mode == "share" and nil or "share")
	end)
	G.TextButton_ImportConfig.MouseButton1Click:Connect(function()
		setMode(mode == "import" and nil or "import")
	end)
	actionButton.MouseButton1Click:Connect(function()
		if mode == "share" then doShare() elseif mode == "import" then doImport() end
	end)

	setMode(nil)
end

