		G.VisualsCtl.setState = function(s)
			if prevSet then prevSet(s) end
			if type(s) == "table" and type(s.gearSkin) == "table" then
				for _, cat in ipairs(CAT_ORDER) do
					local key = s.gearSkin[cat]
					if type(key) == "string" then setSkin(cat, key) end
				end
			end
		end
	else
		warn("[WIND] Gear Skin: G.VisualsCtl missing, the skin choice will not be saved in the config")
	end
end

-- ==========================================================================
-- ADDED: GALAXY SKIN (Visuals page: "Galaxy Skin" row under Gear Skin, OPEN -> outfit gallery, same layout as the Gear gallery)
--   * 3 outfits + an OFF card; each card shows the asset thumbnails of its items
--   * choosing an outfit loads every asset with game:GetObjects and installs it client side:
--       Accessory (hair / hat / suit / dress / gear accessory) -> Humanoid:AddAccessory
--       Shirt / Pants                                          -> put on the character (the original ones are stashed)
--       Tool                                                   -> Backpack
--   * OFF removes everything it added and puts the stashed Shirt / Pants back; re-applied after a respawn
--   * Config: the choice rides along through G.VisualsCtl (key "galaxySkin")
-- ==========================================================================
do
	local lp = Players.LocalPlayer
	local OFF = "OFF"

	local OUTFITS = {
		Outfit1 = { label = "Outfit 1", items = { { kind = "Suit", id = 114387059771803 }, { kind = "Gear", id = 140452706084909 }, { kind = "Hair", id = 104694012226727 } } },
		Outfit2 = { label = "Outfit 2", items = { { kind = "Hair", id = 85338745046296 }, { kind = "Shirt", id = 12499718918 }, { kind = "Pants", id = 80001233597114 }, { kind = "Gear", id = 98679799093947 } } },
		Outfit3 = { label = "Outfit 3", items = { { kind = "Dress", id = 103384049063449 }, { kind = "Hat", id = 138105003202405 } } },
	}
	local ORDER = { "Outfit1", "Outfit2", "Outfit3" }

	local choice = OFF
	local applied = {}  -- instances this section added
	local originals = nil -- { char = Model, items = { clones of the original Shirt / Pants / hair } }
	local token = 0
	local gallery, refreshGallery
	local statusText = ""

	local function setStatus(t)
		statusText = t
		if gallery and gallery.status then gallery.status.Text = t end
	end

	local function isHairAcc(a)
		if not a:IsA("Accessory") then return false end
		local ok, v = pcall(function() return a.AccessoryType == Enum.AccessoryType.Hair end)
		return (ok and v) or a:FindFirstChild("HairAttachment", true) ~= nil
	end

	local function isOriginalPiece(c)
		return c:IsA("Shirt") or c:IsA("Pants") or isHairAcc(c)
	end

	-- like the Akatsuki changer: clone the originals once, then DESTROY them (parent = nil did not remove them)
	local function stripOriginals(char)
		if not char then return end
		if not originals or originals.char ~= char then
			originals = { char = char, items = {} }
			for _, c in ipairs(char:GetChildren()) do
				if isOriginalPiece(c) then table.insert(originals.items, c:Clone()) end
			end
		end
		for _, c in ipairs(char:GetChildren()) do
			if isOriginalPiece(c) then pcall(function() c:Destroy() end) end
		end
	end

	local function clearApplied(restore)
		for _, i in ipairs(applied) do pcall(function() i:Destroy() end) end
		applied = {}
		local char = lp.Character
		if restore and originals and char and originals.char == char then
			stripOriginals(char) -- clears anything left of ours first (originals stays captured)
			local hum = char:FindFirstChildOfClass("Humanoid")
			for _, c in ipairs(originals.items) do
				local n = c:Clone()
				if n:IsA("Accessory") and hum then
					pcall(function() hum:AddAccessory(n) end)
					n.Parent = char
				else
					n.Parent = char
				end
			end
			originals = nil
		end
	end

	-- puts one loaded asset on the player; returns how many pieces were installed
	local function install(obj)
		local char = lp.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum then return 0 end
		local list = { obj }
		for _, d in ipairs(obj:GetDescendants()) do table.insert(list, d) end
		local n, usedSelf = 0, false
		for _, inst in ipairs(list) do
			if inst:IsA("Accessory") then
				-- same recipe as the Akatsuki skin changer: AddAccessory, parent to the character, then weld the Handle
				-- to the matching attachment by hand (layered clothing, i.e. a Handle with a WrapLayer, is left to AddAccessory)
				local handle = inst:FindFirstChild("Handle")
				local layered = handle and (handle:FindFirstChildWhichIsA("WrapLayer", true) ~= nil)
				if handle and handle:IsA("BasePart") then
					for _, p in ipairs(inst:GetDescendants()) do
						if p:IsA("BasePart") then
							p.Anchored = false
							p.CanCollide = false
							p.Massless = true
							p.LocalTransparencyModifier = 0
						end
					end
					handle.Transparency = 0
				end
				pcall(function() hum:AddAccessory(inst) end)
				inst.Parent = char
				if handle and handle:IsA("BasePart") and not layered then
					local okW = pcall(function()
						local aA, aB
						for _, at in ipairs(handle:GetChildren()) do
							if at:IsA("Attachment") then
								local m = char:FindFirstChild(at.Name, true)
								if m and m:IsA("Attachment") and not m:IsDescendantOf(inst) then aA, aB = at, m; break end
							end
						end
						local body = aB and aB.Parent
						local c0 = aA and aA.CFrame or inst.AttachmentPoint
						local c1 = aB and aB.CFrame or CFrame.new()
						if not body then body = char:FindFirstChild("Head") end
						if not body then error("no body part") end
						local old = handle:FindFirstChild("AccessoryWeld")
						if old then old:Destroy() end
						handle.CFrame = body.CFrame * c1 * c0:Inverse()
						local w = Instance.new("Weld")
						w.Name = "AccessoryWeld"
						w.Part0 = handle
						w.Part1 = body
						w.C0 = c0
						w.C1 = c1
						w.Parent = handle
					end)
					if not okW then warn("[WIND] Galaxy Skin: could not weld " .. inst.Name) end
				end
				table.insert(applied, inst); n += 1; if inst == obj then usedSelf = true end
			elseif inst:IsA("Tool") then
				local bp = lp:FindFirstChildOfClass("Backpack")
				if bp then
					inst.Parent = bp
					table.insert(applied, inst); n += 1; if inst == obj then usedSelf = true end
				end
			elseif inst:IsA("Shirt") or inst:IsA("Pants") then
				-- fresh Shirt / Pants built from the template string (how the Akatsuki changer does it)
				local fresh = Instance.new(inst.ClassName)
				fresh.Name = "GalaxySkin_" .. inst.ClassName
				if inst:IsA("Shirt") then fresh.ShirtTemplate = inst.ShirtTemplate else fresh.PantsTemplate = inst.PantsTemplate end
				fresh.Parent = char
				table.insert(applied, fresh); n += 1
				if inst == obj then usedSelf = false end
			end
		end
		if not usedSelf then pcall(function() obj:Destroy() end) end
		return n
	end

	local function applyChoice()
		token += 1
		local my = token
		local def = OUTFITS[choice]
