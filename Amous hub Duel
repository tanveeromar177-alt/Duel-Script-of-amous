        local list = nil
        local ok, res = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(CFG.ASSET_ID)) end)
        if ok and type(res) == "table" then
            list = res
        else
            local ok2, model = pcall(function() return InsertService:LoadAsset(CFG.ASSET_ID) end)
            if ok2 and model then list = { model } end
        end
        if list then template = findAccessory(list) end
        loadFinished = true
    end

    local function setupCharacter(character)
        currentToken = currentToken + 1
        local token = currentToken
        clearCurrent()
        task.spawn(function()
            local humanoid = character:WaitForChild("Humanoid", 10)
            local head = character:WaitForChild("Head", 10)
            if not humanoid or not head then return end
            local t0 = os.clock()
            while not loadFinished and os.clock() - t0 < CFG.LOAD_WAIT do task.wait(0.1) end
            if token ~= currentToken or not template then return end
            local acc = template:Clone()
            local handle = acc:FindFirstChild("Handle")
            if not handle or not handle:IsA("BasePart") then
                acc:Destroy()
                return
            end
            handle.CanCollide = false
            handle.CanQuery = false
            handle.CanTouch = false
            local weld = nil
            if not CFG.FORCE_FLOAT then
                local ok = pcall(function() humanoid:AddAccessory(acc) end)
                if ok then
                    weld = handle:WaitForChild("AccessoryWeld", 2)
                    if not weld then
                        for _, c in ipairs(handle:GetChildren()) do
                            if c:IsA("JointInstance") then weld = c; break end
                        end
                    end
                end
            end
            if token ~= currentToken then acc:Destroy(); return end
            current.accessory, current.handle, current.head = acc, handle, head
            if weld and weld:IsA("Weld") then
                current.weld, current.baseC0, current.mode = weld, weld.C0, "weld"
            else
                acc.Parent = workspace
                handle.Anchored = true
                current.mode = "float"
            end
        end)
    end

    local function onFrame()
        local handle = current.handle
        if not handle or not handle.Parent then return end
        local spin = math.rad((os.clock() * CFG.SPIN_SPEED) % 360)
        if current.mode == "weld" then
            local weld = current.weld
            if weld and weld.Parent then
                weld.C0 = current.baseC0 * CFrame.Angles(0, spin, 0)
            end
        elseif current.mode == "float" then
            local head = current.head
            if head and head.Parent then
                local lift = head.Size.Y / 2 + handle.Size.Y / 2 + CFG.FLOAT_GAP
                handle.CFrame = head.CFrame * CFrame.new(0, lift, 0) * CFrame.Angles(0, spin, 0)
            end
        end
    end

    local function start()
        if running then return end
        running = true
        loadFinished = false
        template = nil
        connections[#connections + 1] = LP.CharacterAdded:Connect(setupCharacter)
        connections[#connections + 1] = RunService.RenderStepped:Connect(onFrame)
        task.spawn(function()
            loadTemplate()
            if LP.Character then setupCharacter(LP.Character) end
        end)
    end

    local function stop()
        running = false
        currentToken = currentToken + 1
        for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
        connections = {}
        clearCurrent()
    end

    local function setEnabled(on)
        mahoragaAdaptedEnabled = on and true or false
        if mahoragaAdaptedEnabled then start() else stop() end
        if setMahoragaAdaptedVisual then setMahoragaAdaptedVisual(mahoragaAdaptedEnabled) end
    end

    return { Start = start, Stop = stop, SetEnabled = setEnabled }
end)()
_G.HazeMahoragaAdapted = MahoragaAdapted

