			faces = {{ name = "Regular", weight = 400, style = "normal", assetId = assetFn(ttfPath) }},
		}))

		G.SpicyFont = Font.new(assetFn(jsonPath), Enum.FontWeight.Regular, Enum.FontStyle.Normal)
	end)
	if not ok then
		warn("[WIND] Spicy Sale font failed, using GothamSSm fallback: " .. tostring(err))
	end
end

