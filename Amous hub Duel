	function Store.saveConfig(snapshot)
		-- only skip writes while initial load is still applying; never lock forever
		if not Store.ready then
			return false, "save not ready"
		end
		if Store.noOverwrite then
			-- still keep memory mirror so re-execute works
			local clean = Store.sanitize(snapshot)
			if type(clean) == "table" then
				local ok, json = pcall(function()
					return HttpService:JSONEncode(clean)
				end)
				if ok and type(json) == "string" then
					env.__VOLT_SAVE_MIRROR = json
				end
			end
			return false, "file protected (memory only)"
		end
		local clean = Store.sanitize(snapshot)
		if type(clean) ~= "table" then
			return false, "empty snapshot"
		end
		local ok, json = pcall(function()
			return HttpService:JSONEncode(clean)
		end)
		if not ok then
			-- isolate the key that cannot be encoded so one bad value never blocks the rest
			local safe = {}
			for k, v in pairs(clean) do
				if pcall(function()
					return HttpService:JSONEncode({ [k] = v })
				end) then
					safe[k] = v
				else
					warn("[VOLT SAVE] dropped unsavable key: " .. tostring(k))
				end
			end
			ok, json = pcall(function()
				return HttpService:JSONEncode(safe)
			end)
			if not ok then
				Store.notify("Save failed (encode): " .. tostring(json), "enc")
				return false, tostring(json)
			end
		end
		if json == Store.lastJson then
			return true, "unchanged"
		end
		env.__VOLT_SAVE_MIRROR = json
		local wrote, info = Store.write(json)
		if wrote then
			Store.lastJson = json
			Store.failCount = 0
			if not Store.okOnce then
				Store.okOnce = true
				Store.notify("Autosave is working -> " .. tostring(info), "saveok")
			end
		else
			Store.failCount = Store.failCount + 1
			if Store.failCount == 1 or Store.failCount % 20 == 0 then
				Store.notify(
					"SAVE FAILED: " .. tostring(info) .. " (kept in memory, survives re-execute only)",
					"savefail"
				)
			end
		end
		return wrote, info
	end

