	-- returns a list of { text = ..., path = ... }; files first, memory mirror last
	function Store.candidates()
		local out, rf, isf = {}, pick("readfile"), pick("isfile")
		Store.fileExists = false
		if rf then
			for _, p in ipairs(PATHS) do
				-- try the read even if isfile says no: some executors report isfile wrongly
				local ok, s = pcall(rf, p)
				if ok and type(s) == "string" and s ~= "" then
					Store.fileExists = true
					out[#out + 1] = { text = s, path = p }
				elseif isf then
					local okE, e = pcall(isf, p)
