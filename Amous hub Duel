		local rf = pick("readfile") or readfile_ or readfile
		if #writers == 0 then
			return false, "executor has no writefile"
		end
		ensureFolder()
		local good, errs = {}, {}
		for _, p in ipairs(PATHS) do
			local written = false
			for _, wf in ipairs(writers) do
				local ok, err = pcall(wf, p, json)
				if ok then
					local verified = true
					if type(rf) == "function" then
						local okR, got = pcall(rf, p)
						verified = okR and type(got) == "string" and #got > 2
					end
					if verified then
						good[#good + 1] = p
						written = true
						break
					else
						errs[#errs + 1] = p .. ": readback failed"
					end
				else
					errs[#errs + 1] = p .. ": " .. tostring(err)
				end
			end
		end
		if #good > 0 then
			return true, table.concat(good, ", ")
		end
