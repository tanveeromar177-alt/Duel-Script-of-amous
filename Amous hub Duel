-- SQUARE IDENTITY (spinning red square feet ↔ head)
-- ═══════════════════════════════════════════════════════════════
local SquareIdentity = (function()
    local CFG = {
        SIZE         = Vector3.new(3, 0.3, 3),
        COLOR        = Color3.fromRGB(255, 0, 0),
        FEET_GAP     = 0.1,
        HEAD_GAP     = 0.2,
        WAIT_AT_FEET = 5,
        RISE_TIME    = 1.2,
        FALL_TIME    = 1.2,
        SPIN_SPEED   = 180,
    }
    local square, connections = nil, {}
    local currentToken, root, feetOffset, headOffset = 0, nil, nil, nil
    local cycleStart = 0
    local running = false

    local function measure(character, rootPart)
        local boxCF, boxSize = character:GetBoundingBox()
        local feet = (boxCF.Position.Y - boxSize.Y / 2) - rootPart.Position.Y
        local head = character:FindFirstChild("Head")
        local top
        if head and head:IsA("BasePart") then
            top = (head.Position.Y + head.Size.Y / 2) - rootPart.Position.Y
        else
            top = (boxCF.Position.Y + boxSize.Y / 2) - rootPart.Position.Y
        end
        return feet, top
    end

    local function setupCharacter(character)
        currentToken = currentToken + 1
        local token = currentToken
        root, feetOffset, headOffset = nil, nil, nil
        if square then square.Transparency = 1 end
        task.spawn(function()
            local rootPart = character:WaitForChild("HumanoidRootPart", 10)
            local humanoid = character:WaitForChild("Humanoid", 10)
            if not rootPart or not humanoid then return end
            task.wait(1)
            if token ~= currentToken or not rootPart.Parent then return end
            local feet, top = measure(character, rootPart)
            if feet ~= feet or top ~= top or top <= feet then return end
            root, feetOffset, headOffset = rootPart, feet, top
            cycleStart = os.clock()
            if square then square.Transparency = 0 end
        end)
    end

    local function smooth(a)
        return a * a * (3 - 2 * a)
    end

    local function heightAlpha(elapsed)
        local total = CFG.WAIT_AT_FEET + CFG.RISE_TIME + CFG.FALL_TIME
        local t = elapsed % total
        if t < CFG.WAIT_AT_FEET then
            return 0
        elseif t < CFG.WAIT_AT_FEET + CFG.RISE_TIME then
            return smooth((t - CFG.WAIT_AT_FEET) / CFG.RISE_TIME)
        else
            return 1 - smooth((t - CFG.WAIT_AT_FEET - CFG.RISE_TIME) / CFG.FALL_TIME)
        end
    end

    local function onFrame()
        if not square or not root or not root.Parent then
            if square then square.Transparency = 1 end
            return
        end
        local now = os.clock()
        local a = heightAlpha(now - cycleStart)
        local y = (feetOffset - CFG.FEET_GAP) * (1 - a) + (headOffset + CFG.HEAD_GAP) * a
        local pos = root.Position + Vector3.new(0, y, 0)
        local spin = math.rad((now * CFG.SPIN_SPEED) % 360)
        square.CFrame = CFrame.new(pos) * CFrame.Angles(0, spin, 0)
    end

    local function start()
        if running then return end
        running = true
        if not square or not square.Parent then
            square = Instance.new("Part")
            square.Name = "HazeSpinningSquare"
            square.Shape = Enum.PartType.Block
            square.Size = CFG.SIZE
            square.Color = CFG.COLOR
            square.Material = Enum.Material.Neon
            square.Anchored = true
            square.CanCollide = false
            square.CanQuery = false
            square.CanTouch = false
            square.CastShadow = false
            square.Transparency = 1
            square.Parent = workspace
        end
        connections[#connections + 1] = LP.CharacterAdded:Connect(setupCharacter)
        connections[#connections + 1] = RunService.RenderStepped:Connect(onFrame)
        if LP.Character then setupCharacter(LP.Character) end
    end

    local function stop()
        running = false
        currentToken = currentToken + 1
        for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
        connections = {}
        root, feetOffset, headOffset = nil, nil, nil
        if square then
            pcall(function() square:Destroy() end)
            square = nil
        end
    end

    local function setEnabled(on)
        squareIdentityEnabled = on and true or false
        if squareIdentityEnabled then start() else stop() end
        if setSquareIdentityVisual then setSquareIdentityVisual(squareIdentityEnabled) end
    end

    return { Start = start, Stop = stop, SetEnabled = setEnabled }
end)()
_G.HazeSquareIdentity = SquareIdentity

