		local act = make("TextButton", {
			Text = "", AutoButtonColor = false,
			Position = UDim2.fromOffset(10, 11), Size = UDim2.fromOffset(36, 36),
			BackgroundColor3 = C.panel2, BackgroundTransparency = 1,
		}, row)
		round(act, 18)
		local pct = make("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
			Text = "", Font = FONT_B, TextSize = 10, TextColor3 = C.accent,
		}, act)
		if s.downloaded then
			local playing = isCur and sound.IsPlaying
			icon(playing and "pause" or "play", act, 14, C.text)
			act.BackgroundTransparency = isCur and 0 or 1
			if isCur then act.BackgroundColor3 = C.accent end
		elseif s.downloading then
			pct.Text = "..."
		else
			icon("download", act, 15, C.text)
		end
		act.MouseEnter:Connect(function()
			if not (isCur and s.downloaded) then tween(act, 0.15, { BackgroundTransparency = 0 }) end
		end)
		act.MouseLeave:Connect(function()
			if not (isCur and s.downloaded) then tween(act, 0.15, { BackgroundTransparency = 1 }) end
		end)
		act.MouseButton1Click:Connect(function()
			if s.downloaded then playSong(s) else download(s) end
		end)
		cover(row, 40, s, UDim2.fromOffset(54, 9))
		label(row, s.title, 13, isCur and C.accent or C.text, FONT_B,
			UDim2.fromOffset(104, 11), UDim2.new(1, -170, 0, 18))
