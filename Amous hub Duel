-- ============================================================
-- Velirox Gui: rainbow GUI mode (toggle from Config > Velirox Gui)
-- Colours the hub window (borders, accent fills, toggle tracks, text gradients), the minimized
-- button and the mobile buttons. Turning it off restores the colours that were there before.
-- ============================================================
pcall(function()
	local RunService = game:GetService("RunService")
	local Players = game:GetService("Players")
	local CoreGui = game:GetService("CoreGui")
	local LP = Players.LocalPlayer

	local Velirox = (function()
		local SPEED = 0.25          -- hue cycles per second
		local UPDATE_STEP = 1 / 20  -- colour update rate
		local RESCAN_EVERY = 4      -- seconds between rescans for new / changed GUI objects
		local TOL = 6               -- colour tolerance (0-255 per channel) for ownership checks
		local MINI_BG = Color3.fromRGB(10, 12, 18)
		-- mobile button palette (same values as Config._createQuickButton)
		local MOB_BG = Color3.fromRGB(27, 29, 26)
		local MOB_BG_ON = Color3.fromRGB(255, 255, 255)
		local MOB_BORDER = Color3.fromRGB(85, 88, 85)
		local MOB_BORDER_ON = Color3.fromRGB(255, 255, 255)
		local MOB_TEXT = Color3.fromRGB(255, 255, 255)
		local MOB_TEXT_ON = Color3.fromRGB(0, 0, 0)

		local running = false
		local hbConn = nil
		local scanThread = nil
		local entries = {}
		local known = setmetatable({}, { __mode = "k" })
		local accents = { Color3.fromRGB(112, 116, 130) }
		local counter = 0
		local accum = 0
		local t0 = os.clock()
		local root = nil

		local function near(a, b, tol)
			return math.abs(a.R - b.R) * 255 <= tol
				and math.abs(a.G - b.G) * 255 <= tol
				and math.abs(a.B - b.B) * 255 <= tol
		end

		local function isAccent(c)
			for _, a in ipairs(accents) do
				if near(c, a, 8) then
					return true
				end
			end
			return false
		end

		local function rainbowSeq(t)
			local keys = {}
			for i = 0, 6 do
				keys[#keys + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV((t + i / 6) % 1, 0.85, 1))
			end
			return ColorSequence.new(keys)
		end

		local function findRoot()
			local holders = {}
			pcall(function()
				if gethui then
					holders[#holders + 1] = gethui()
				end
			end)
			holders[#holders + 1] = CoreGui
			holders[#holders + 1] = LP:FindFirstChild("PlayerGui")
			for _, h in ipairs(holders) do
				local g = h and h:FindFirstChild("VoltModernV2")
				if g then
					return g
				end
			end
			return nil
		end

		local function track(obj, prop, kind)
			local slots = known[obj]
			if not slots then
				slots = {}
				known[obj] = slots
			end
			if slots[prop] then
				return
			end
			slots[prop] = true
			counter = counter + 1
			entries[#entries + 1] = {
				obj = obj,
				prop = prop,
				kind = kind,
				orig = obj[prop],
				last = nil,
				off = (counter * 0.071) % 1,
				always = obj:FindFirstAncestor("MinimizedFrame") ~= nil,
			}
		end

		local function consider(obj)
			if obj:IsA("UIStroke") then
				local p = obj.Parent
				if p and (obj.ApplyStrokeMode == Enum.ApplyStrokeMode.Border
					or not (p:IsA("TextLabel") or p:IsA("TextButton") or p:IsA("TextBox"))) then
					track(obj, "Color", "stroke")
				end
			elseif obj:IsA("UIGradient") then
				local p = obj.Parent
				if p and (p:IsA("UIStroke")
					or ((p:IsA("TextLabel") or p:IsA("TextButton")) and p.Text ~= "")) then
					track(obj, "Color", "grad")
				end
			elseif obj:IsA("GuiObject") then
				if obj.Name == "ToggleTrack" then
					track(obj, "BackgroundColor3", "bg")
				elseif obj.Name ~= "MinimizedFrame" and obj.BackgroundTransparency < 0.98 and isAccent(obj.BackgroundColor3) then
					track(obj, "BackgroundColor3", "bg")
				end
			end
		end

		local function scanAll()
			root = findRoot()
			if not root then
				return
			 end
			accents = { Color3.fromRGB(112, 116, 130) }
			local g = Config._glass
			if g then
				if g.accent then
					accents[#accents + 1] = g.accent
				end
				if g.accent2 then
					accents[#accents + 1] = g.accent2
				end
			end
			local n = 0
			for _, obj in ipairs(root:GetDescendants()) do
				pcall(consider, obj)
				n = n + 1
				if n % 400 == 0 then
					task.wait()
					if not running then
						return
					end
				end
			end
		end

		local function applyEntry(e, t, seq)
			local obj = e.obj
			if e.kind == "grad" then
				obj.Color = seq
				return
			end
			local cur = obj[e.prop]
			local owned = e.last ~= nil and near(cur, e.last, TOL)
			if e.kind == "stroke" or owned or isAccent(cur) then
				if not owned then
					e.orig = cur
				end
				local new = Color3.fromHSV((t + e.off) % 1, 0.8, 1)
				obj[e.prop] = new
				e.last = new
			else
				e.last = nil
			end
		end

		local function step()
			if not root or not root.Parent then
				root = findRoot()
			end
			local t = (os.clock() - t0) * SPEED
			local seq = rainbowSeq(t)
			local mainFrame = root and root:FindFirstChild("MainWrapper")
			local mainVisible = mainFrame and mainFrame.Visible
			local i = 1
			while i <= #entries do
				local e = entries[i]
				if e.obj.Parent then
					if mainVisible or e.always then
						pcall(applyEntry, e, t, seq)
					end
					i = i + 1
				else
					entries[i] = entries[#entries]
					entries[#entries] = nil
				end
			end
			-- minimized button background
			local mini = root and root:FindFirstChild("MinimizedFrame")
			if mini and mini.Visible then
				mini.BackgroundColor3 = Color3.fromHSV(t % 1, 0.75, 0.3)
			end
			-- mobile buttons
			local qf = Config._quickButtonFrames
			if qf then
				local idx = 0
				for _, f in pairs(qf) do
					idx = idx + 1
					if f and f.Parent and f.Visible then
						local on = f:GetAttribute("VoltOn") == true
						local c = Color3.fromHSV((t + idx * 0.083) % 1, 0.85, 1)
						local st = f:FindFirstChildOfClass("UIStroke")
						local tb = f:FindFirstChildOfClass("TextButton")
						if st then
							st.Color = c
						end
						if on then
							f.BackgroundColor3 = c
							if tb then
								tb.TextColor3 = MOB_TEXT_ON
							end
						else
							f.BackgroundColor3 = MOB_BG
							if tb then
								tb.TextColor3 = c
							end
						end
					end
				end
			end
		end

		local function restoreAll()
			for _, e in ipairs(entries) do
				local obj = e.obj
				if obj.Parent then
					pcall(function()
						if e.kind == "grad" then
							obj.Color = e.orig
						elseif e.last and near(obj[e.prop], e.last, TOL) then
							obj[e.prop] = e.orig
						end
					end)
				end
			end
			entries = {}
			known = setmetatable({}, { __mode = "k" })
			counter = 0
			local mini = root and root:FindFirstChild("MinimizedFrame")
			if mini then
				mini.BackgroundColor3 = MINI_BG
			end
			for _, f in pairs(Config._quickButtonFrames or {}) do
				if f and f.Parent then
					local on = f:GetAttribute("VoltOn") == true
					local st = f:FindFirstChildOfClass("UIStroke")
					local tb = f:FindFirstChildOfClass("TextButton")
					f.BackgroundColor3 = on and MOB_BG_ON or MOB_BG
					if st then
						st.Color = on and MOB_BORDER_ON or MOB_BORDER
					end
					if tb then
						tb.TextColor3 = on and MOB_TEXT_ON or MOB_TEXT
					end
				end
			end
		end

		local function start()
			if running then
				return
			end
			running = true
			t0 = os.clock()
			accum = 0
			scanThread = task.spawn(function()
				pcall(scanAll)
				while running do
					task.wait(RESCAN_EVERY)
					if not running then
						break
					end
					pcall(scanAll)
				end
			end)
			hbConn = RunService.Heartbeat:Connect(function(dt)
				accum = accum + dt
				if accum < UPDATE_STEP then
					return
				end
				accum = 0
				pcall(step)
			end)
		end

		local function stop()
			if not running then
				return
			end
			running = false
			if hbConn then
				hbConn:Disconnect()
				hbConn = nil
			end
			if scanThread then
				pcall(task.cancel, scanThread)
				scanThread = nil
			end
			pcall(restoreAll)
		end

		local function setEnabled(on)
			Config.veliroxGuiEnabled = on and true or false
			if Config.veliroxGuiEnabled then
				start()
			else
				stop()
			end
			if Config._veliroxSetVisual then
				pcall(Config._veliroxSetVisual, Config.veliroxGuiEnabled)
			end
		end

		return { Start = start, Stop = stop, SetEnabled = setEnabled, IsRunning = function() return running end }
	end)()

	Config._velirox = Velirox
	function Config._toggleVeliroxGui()
		Velirox.SetEnabled(not Velirox.IsRunning())
	end
	if Config.veliroxGuiEnabled == true then
		task.delay(2, function()
			Velirox.Start()
			if Config._veliroxSetVisual then
				pcall(Config._veliroxSetVisual, true)
			end
		end)
	end
end)

-- ============================================================
-- Embedded Bypass mini GUI (toggle from Visuals > Open Bypass)
-- ============================================================
do
	-- Kawatan Speed Bypass engine (GUI kept as Volt)
	local BP = {
		enabled = false,
		power = 97000,
		mode = "PC",
		toggleKey = Enum.KeyCode.V,
		defaultPowers = { PC = 97000, MOBILE = 65000 },
		running = false,
		gui = nil,
		visible = false,
		windowSize = UDim2.new(0, 230, 0, 135),
	}
	local UI = {
		Background = Color3.fromRGB(10, 10, 10),
		BackgroundFrame = Color3.fromRGB(25, 25, 25),
		BackgroundButton = Color3.fromRGB(50, 50, 50),
		TextPrimary = Color3.fromRGB(240, 240, 240),
		TextAccent = Color3.fromRGB(200, 200, 200),
		StrokeDefault = Color3.fromRGB(130, 130, 130),
		ActiveStroke = Color3.fromRGB(255, 255, 255),
		EnabledColor = Color3.fromRGB(255, 255, 255),
	}
	local TITLE_URL = "" -- Blyra logo removed; text title used instead

	-- Kawatan lag core: while active, every RenderStepped frame busy-waits for `lagAmount` seconds.
	-- power (10000..500000) maps linearly to 0..0.2 seconds of lag per frame.
	local RunService = game:GetService("RunService")
	local lagAmount = 0
	local lagConn = nil

	local function applyPower(val)
		BP.power = math.clamp(tonumber(val) or BP.power, 10000, 500000)
		local t = (BP.power - 10000) / 490000
		lagAmount = t * 0.2
	end
	applyPower(BP.power)

	local function stopBypass()
		BP.running = false
		if lagConn then
			lagConn:Disconnect()
			lagConn = nil
		end
	end

	local function startBypass(power)
		stopBypass()
		applyPower(power or BP.power)
		BP.running = true
		lagConn = RunService.RenderStepped:Connect(function()
			if not BP.running then
				return
			end
			if lagAmount > 0 then
				local t = tick()
				while tick() - t < lagAmount do
				end
			end
		end)
	end

	-- re-apply one second after every respawn while the bypass is active
	game:GetService("Players").LocalPlayer.CharacterAdded:Connect(function()
		task.wait(1)
		if BP.enabled then
			startBypass(BP.power)
		end
	end)

	-- expose for external / auto hooks
	_G._VoltBypassStart = function(power)
		BP.enabled = true
		startBypass(power or BP.power)
	end
	_G._VoltBypassStop = function()
		BP.enabled = false
		stopBypass()
	end
	_G._VoltBypassState = BP
	local function corner(p, r)
		local c = Instance.new("UICorner", p)
		c.CornerRadius = UDim.new(0, r or 6)
		return c
	end
	local function stroke(p, col, th)
		local s = Instance.new("UIStroke", p)
		s.Color = col or UI.StrokeDefault
		s.Thickness = th or 1
		return s
	end
	local function buildGui()
		if BP.gui and BP.gui.Parent then
			return BP.gui
		end
		local parent = (gethui and gethui()) or CoreGui or localPlayer:FindFirstChild("PlayerGui")
		local old = parent and parent:FindFirstChild("VoltBypassUI")
		if old then pcall(function() old:Destroy() end) end
		local screenGui = Instance.new("ScreenGui")
		screenGui.Name = "VoltBypassUI"
		screenGui.ResetOnSpawn = false
		screenGui.DisplayOrder = 121
		screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		pcall(function()
			if syn and syn.protect_gui then syn.protect_gui(screenGui) end
		end)
		screenGui.Parent = parent
		local mainFrame = Instance.new("Frame", screenGui)
		mainFrame.Size = BP.windowSize
		mainFrame.Position = UDim2.new(0.5, -115, 0.5, -65)
		mainFrame.BackgroundColor3 = UI.Background
		mainFrame.BackgroundTransparency = 0.1
		mainFrame.Active = true
		mainFrame.BorderSizePixel = 0
		corner(mainFrame, 8)
		local mainStroke = stroke(mainFrame, UI.StrokeDefault, 1.5)
		-- drag
		local dragging, dragStart, startPos
		mainFrame.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = mainFrame.Position
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - dragStart
				local cam = workspace.CurrentCamera
				local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
				local ax = startPos.X.Scale * vp.X + startPos.X.Offset + delta.X
