-- ==========================================================================
-- ADDED: SPEED ENGINE + VELOCITY SPOOF (from luckbroom) / AUTO CARRY SPEED (from Akatsuki)
--   Normal / Carry / Lagger Normal / Lagger Carry speed -> TextBox, TextBox_2, TextBox_3, TextBox_4 (decimals allowed)
--   Speed Mode button (TextButton_2) and Speed Bind (TextButton_5, default Q): Normal <-> Carry
--   Lagger Bind row (TextButton_6, key R) and its key bind were removed on request; lagger is driven by the LAGGER NORMAL / LAGGER CARRY mobile buttons
--   Mobile buttons CARRY SPEED / LAGGER NORMAL / LAGGER CARRY drive the same state and show it (latched colour)
--   Auto Carry Speed toggle (WaveTogglePill_2): while LocalPlayer attribute "Stealing" is true, the CARRY speed of the
--   current mode is used (Carry Speed, or Lagger Carry Speed when a lagger mode is active) - Akatsuki's rule
--   Engine = luckbroom "Direct" motor: every RenderStepped the horizontal AssemblyLinearVelocity of HumanoidRootPart is set
--   to MoveDirection * speed (Y untouched). It is always on, like in luckbroom (there is no master switch).
--   Spoof = luckbroom hook: reads of Velocity / AssemblyLinearVelocity on YOUR root from non-executor code are clamped to
--   20 studs/s. Needs getrawmetatable, setreadonly, newcclosure and checkcaller in the executor; without them the speed
--   still works and only the spoof is skipped (see the status line printed a moment after load).
--   Config: speed boxes + Auto Carry toggle are saved by the generic toggle/textbox capture; speed mode, lagger mode and the
--   two key binds are added to the saved state (state.speed, state.binds.speed).
--   Not ported (no matching UI in Wind): luckbroom "Carry Boost" LinearVelocity motor, its proximity "Auto Carry"
--   (replaced by Akatsuki's Stealing-attribute version), speed meter (you said later).
-- ==========================================================================
do
	-- removed on request: the "V1" button on the Auto Carry Speed row
	if G.TextButton_9 then G.TextButton_9:Destroy() end

	local SPEED_CAP = 500        -- sanity cap (luckbroom's own carry engine clamps to the same 500)
	local SPOOF_READ_LIMIT = 20  -- luckbroom / Akatsuki: spoofed reads never exceed this many studs/s

	local speedBoxes = {
		normal       = { box = G.TextBox,   last = 60 },
		carry        = { box = G.TextBox_2, last = 30 },
		laggerNormal = { box = G.TextBox_3, last = 15 },
		laggerCarry  = { box = G.TextBox_4, last = 10 },
	}

	-- a box holding junk (empty, text, 0, negative, inf/nan) keeps its last valid value
	local function readSpeed(entry)
		local n = tonumber(entry.box.Text)
		if n and n == n and n > 0 and n < math.huge then
			entry.last = math.min(n, SPEED_CAP)
		end
		return entry.last
	end

	-- ---------- mode state + UI ----------
	local carryMode = false  -- Speed Mode = "Carry"
	local laggerMode = 0     -- 0 off, 1 Lagger, 2 Lagger Carry
	removeRow(G.Frame_14) -- removed on request: the "Lagger Mode" row (label + TextButton_3)

	local mobileFrames = {}
	for _, d in ipairs(stackBtns) do
		mobileFrames[d.name] = d.frame
	end

	local function setMobile(name, on)
		mobileToggles[name] = on
		local frame = mobileFrames[name]
		if frame then
			TweenService:Create(frame, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
				BackgroundColor3 = on and Color3.fromRGB(160, 16, 40) or Color3.fromRGB(48, 8, 15)
			}):Play()
		end
	end

	local function refreshUi()
		G.TextButton_2.Text = carryMode and "Carry" or "Normal"
		setMobile("CARRY SPEED", carryMode)
		setMobile("LAGGER NORMAL", laggerMode == 1)
		setMobile("LAGGER CARRY", laggerMode == 2)
	end

	local function changed()
		refreshUi()
		bindChangedHook() -- schedules the autosave (replaced by scheduleAutosave in the config section)
	end

	-- luckbroom rules: carry while a lagger mode is on -> lagger off + carry on; any lagger mode switches carry off
	local function toggleCarry()
		if laggerMode ~= 0 then
			laggerMode = 0
			carryMode = true
		else
			carryMode = not carryMode
		end
		changed()
	end

	local function setLagger(mode)
		laggerMode = mode
		if mode ~= 0 then carryMode = false end
		changed()
	end

	local function cycleLagger()
		setLagger((laggerMode + 1) % 3)
	end

	G.TextButton_2.MouseButton1Click:Connect(toggleCarry)
	stackToggleHooks["CARRY SPEED"] = toggleCarry
	stackToggleHooks["LAGGER NORMAL"] = function() setLagger(laggerMode == 1 and 0 or 1) end
	stackToggleHooks["LAGGER CARRY"] = function() setLagger(laggerMode == 2 and 0 or 2) end

	speedCtl.toggleCarry = toggleCarry
	speedCtl.getLaggerMode = function() return laggerMode end
	speedCtl.cycleLagger = cycleLagger
	speedCtl.getState = function()
		return { carry = carryMode, lagger = laggerMode }
	end
	speedCtl.setState = function(s)
		if type(s) ~= "table" then return end
		if type(s.carry) == "boolean" then carryMode = s.carry end
		if s.lagger == 0 or s.lagger == 1 or s.lagger == 2 then laggerMode = s.lagger end
		if laggerMode ~= 0 then carryMode = false end
		refreshUi()
	end

	-- ---------- velocity spoof (luckbroom _hookVelHRP) ----------
	-- the shared table survives a re-execute, so the metatable is hooked only once per game session
	local hookState = _G.__WindVelocityHook
	if type(hookState) ~= "table" then
		hookState = { hooked = false, roots = setmetatable({}, { __mode = "k" }) }
		_G.__WindVelocityHook = hookState
	end

	local function registerRoot(root)
		hookState.roots = setmetatable({}, { __mode = "k" }) -- only the current root is spoofed
		hookState.roots[root] = true
		if hookState.hooked then return end
		if type(getrawmetatable) ~= "function" or type(setreadonly) ~= "function"
			or type(newcclosure) ~= "function" or type(checkcaller) ~= "function" then
			return
		end
		pcall(function()
			local mt = getrawmetatable(root)
			if not mt then return end
			local oldIndex = rawget(mt, "__index")
			if type(oldIndex) ~= "function" and type(oldIndex) ~= "table" then return end
			local function original(obj, key)
				if type(oldIndex) == "function" then return oldIndex(obj, key) end
				return oldIndex[key]
			end
			setreadonly(mt, false)
			mt.__index = newcclosure(function(obj, key)
				local value = original(obj, key)
				if (key == "AssemblyLinearVelocity" or key == "Velocity")
					and typeof(value) == "Vector3" and value.Magnitude > SPOOF_READ_LIMIT
					and not checkcaller() and hookState.roots[obj] then
					return value.Unit * SPOOF_READ_LIMIT
				end
				return value
			end)
			hookState.hooked = true
			setreadonly(mt, true)
		end)
	end

	-- ---------- speed engine (luckbroom "Direct" motor, Akatsuki carry rule) ----------
	local MOVE_KEYS = {
		[Enum.KeyCode.W] = true, [Enum.KeyCode.A] = true, [Enum.KeyCode.S] = true, [Enum.KeyCode.D] = true,
		[Enum.KeyCode.Up] = true, [Enum.KeyCode.Left] = true, [Enum.KeyCode.Down] = true, [Enum.KeyCode.Right] = true,
	}
	local lastMoveDir = Vector3.zero
	local spoofedRoot, netOwnerRoot

	local function movementBlocked(hum)
		if not hum or hum.Health <= 0 then return true end
		if _G.dropActive or _G.IsDropping then return true end
		local st = hum:GetState()
		return hum.PlatformStand
			or st == Enum.HumanoidStateType.Physics
			or st == Enum.HumanoidStateType.Ragdoll
			or st == Enum.HumanoidStateType.FallingDown
	end

	local function activeSpeed()
		local autoCarry = LocalPlayer:GetAttribute("Stealing") == true and pillOn(G.WaveTogglePill_2)
		if laggerMode ~= 0 then
			if laggerMode == 2 or autoCarry then return readSpeed(speedBoxes.laggerCarry) end
			return readSpeed(speedBoxes.laggerNormal)
		end
		if carryMode or autoCarry then return readSpeed(speedBoxes.carry) end
		return readSpeed(speedBoxes.normal)
	end

	speedCtl.getActiveSpeed = activeSpeed -- read by the head label: the speed that is set right now, not a measured one

	local function speedStep()
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root or movementBlocked(hum) or _G.__WindAimbotDriving == true or _G.__WindAutoLRDriving == true or _G.__WindBatTpDriving == true then -- aimbot / Auto Left-Right / Bat TP own the root velocity
			lastMoveDir = Vector3.zero
			return
		end
		if spoofedRoot ~= root then
			spoofedRoot = root
			registerRoot(root)
		end

		local md = hum.MoveDirection
		local direction = Vector3.new(md.X, 0, md.Z)
		if direction.Magnitude > 0.05 then
			lastMoveDir = direction
		else
			direction = nil
			if lastMoveDir.Magnitude > 0.05 and not UserInputService:GetFocusedTextBox() then
				for key in pairs(MOVE_KEYS) do
					if UserInputService:IsKeyDown(key) then
						direction = lastMoveDir
						break
					end
				end
			end
		end

		local speed = activeSpeed()
		local y = root.AssemblyLinearVelocity.Y
		if direction then
			if netOwnerRoot ~= root then -- once per root; on a normal client this call is refused, like in luckbroom/Akatsuki
				netOwnerRoot = root
				pcall(function() root:SetNetworkOwner(LocalPlayer) end)
			end
			local unit = direction.Unit
			root.AssemblyLinearVelocity = Vector3.new(unit.X * speed, y, unit.Z * speed)
		else
			root.AssemblyLinearVelocity = Vector3.new(0, y, 0)
		end
	end

	if _G.__WindSpeedEngine and _G.__WindSpeedEngine.Destroy then
		pcall(_G.__WindSpeedEngine.Destroy) -- re-execute: drop the previous instance's loop
	end
	local speedEngine = {}
	local speedErrorShown = false
	speedEngine.conn = RunService.RenderStepped:Connect(function()
		local ok, err = pcall(speedStep)
		if not ok and not speedErrorShown then
			speedErrorShown = true
			warn("[WIND] speed engine error: " .. tostring(err))
		end
	end)
	speedEngine.charConn = LocalPlayer.CharacterRemoving:Connect(function()
		lastMoveDir = Vector3.zero
		spoofedRoot, netOwnerRoot = nil, nil
	end)
	speedEngine.Destroy = function()
		if speedEngine.conn then speedEngine.conn:Disconnect() speedEngine.conn = nil end
		if speedEngine.charConn then speedEngine.charConn:Disconnect() speedEngine.charConn = nil end
		speedCtl.getActiveSpeed = nil
	end
	_G.__WindSpeedEngine = speedEngine

	refreshUi()

	task.delay(2, function()
		print(string.format("[WIND] Speed engine running | velocity spoof: %s",
			hookState.hooked and "hooked" or "NOT hooked (missing executor API, or no character yet)"))
	end)
end

-- ---------- Ragdoll Steal (Adapt) -> toggle "Ragdoll Steal" (WaveTogglePill_28) ----------
-- In Adapt this is not a feature of its own: while "Auto Steal" is on and YOU get ragdolled (Physics/Ragdoll state),
-- the steal automation is paused for 1.45s (1.2s if a Medusa part is anchored on you), then resumed.
-- The Auto Steal engine (section "ADDED: AUTO STEAL" further down) sets the pause/resume hooks below when it installs.
-- The state machine itself is complete and publishes _G._WindStealRagdollPaused (true while paused) for the
-- auto-steal loop to read, exactly like Adapt's _AdaptNormalStealRagdollPaused.
local stealHooks = {
	stop = nil,   -- set by the Auto Steal section below: aborts the running steal (Adapt: stopAllStealAutomation)
	resume = nil, -- set by the Auto Steal section below: restarts the engine if the toggle is on (Adapt: syncStealMode)
}
local RAGDOLL_STEAL_PAUSE = 1.45
local RAGDOLL_STEAL_PAUSE_MEDUSA = 1.2

_G._WindStealRagdollPaused = false
if _G._WindStealRagdollState and _G._WindStealRagdollState.Destroy then
	pcall(_G._WindStealRagdollState.Destroy) -- re-execute: drop the previous instance
end

local ragdollSteal = { active = false, token = 0, humanoid = nil, conns = {} }
_G._WindStealRagdollState = ragdollSteal

local function autoStealOn()
	return pillOn(G.WaveTogglePill_29)
end

local function ragdollStealEnabled()
	return pillOn(G.WaveTogglePill_28)
end

local function callHook(fn)
	if type(fn) == "function" then pcall(fn) end
end

local function rsDisconnect(name)
	local c = ragdollSteal.conns[name]
	if c then
		pcall(function() c:Disconnect() end)
		ragdollSteal.conns[name] = nil
	end
end

local function rsEnd(resume)
	ragdollSteal.token += 1
	ragdollSteal.active = false
	_G._WindStealRagdollPaused = false
	if resume and autoStealOn() then
		callHook(stealHooks.resume)
	end
end

local function rsPauseTime()
	local char = LocalPlayer.Character
	local part = _G._WindStealBarMedusaPart -- nothing in Wind sets this yet -> normal pause time
	if part and part.Parent and char and part:IsDescendantOf(char) and part.Anchored then
		return RAGDOLL_STEAL_PAUSE_MEDUSA
	end
	return RAGDOLL_STEAL_PAUSE
end

local function rsEvaluate()
	local hum = ragdollSteal.humanoid
	if not hum or not hum.Parent then return end

	if not ragdollStealEnabled() then
		if ragdollSteal.active then rsEnd(true) end
		return
	end
	if not autoStealOn() then
		if ragdollSteal.active then rsEnd(false) end
		return
	end

	local st = hum:GetState()
	local ragdolled = st == Enum.HumanoidStateType.Physics or st == Enum.HumanoidStateType.Ragdoll
	if ragdolled and not ragdollSteal.active then
		ragdollSteal.active = true
		ragdollSteal.token += 1
		local token = ragdollSteal.token
		_G._WindStealRagdollPaused = true
		callHook(stealHooks.stop)
		task.delay(rsPauseTime(), function()
			if ragdollSteal.token ~= token or not ragdollSteal.active then return end
			_G._WindStealRagdollPaused = false
			ragdollSteal.active = false
			if ragdollStealEnabled() and autoStealOn() then
				callHook(stealHooks.resume)
			end
		end)
	end
end

local function rsAttach(char)
	rsDisconnect("state")
	if ragdollSteal.active then rsEnd(false) end
	local hum = char and (char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10))
	ragdollSteal.humanoid = hum
	if not hum then return end
	ragdollSteal.conns.state = hum.StateChanged:Connect(rsEvaluate)
	task.defer(rsEvaluate)
end

ragdollSteal.Destroy = function()
	rsEnd(false)
	rsDisconnect("state")
	rsDisconnect("character")
	ragdollSteal.humanoid = nil
end

ragdollSteal.conns.character = LocalPlayer.CharacterAdded:Connect(rsAttach)
if LocalPlayer.Character then
	task.defer(rsAttach, LocalPlayer.Character)
end

G.WaveTogglePill_28:GetAttributeChangedSignal("WaveToggleOn"):Connect(function()
	if not ragdollStealEnabled() then
		if ragdollSteal.active then rsEnd(true) end
	else
		task.defer(rsEvaluate)
	end
end)

-- re-attach per-character listeners after respawn (Akatsuki waits 0.5s too)
LocalPlayer.CharacterAdded:Connect(function()
	task.wait(0.5)
	if pillOn(G.WaveTogglePill_26) then attachBatCounter() end
	if pillOn(G.WaveTogglePill_27) then attachMedusa() end
end)

-- toggles may already be ON at this point
applyInfJump()
if pillOn(G.WaveTogglePill_26) then attachBatCounter() end
if pillOn(G.WaveTogglePill_27) then attachMedusa() end

-- ==========================================================================
-- ADDED: BAT AIMBOT (ported from Vx7) + MIRROR TP DOWN (ported from Ace Duel)
--   The previous bat aimbot (Akatsuki Cypher prediction block) was removed and replaced by the Vx7 bat aimbot
--   (Vx7 tbl36.update / getBat / nearestTarget / ensureMover / resetMotion, as found in Vx7_by_printed_REALL.txt).
--   Vx7 bat aimbot, every RenderStepped while "Bat Speed" (WaveTogglePill_22) is on:
--     * target = nearest living player by distance to your root; his velocity = finite difference of his root
--       position (dt clamped 1/120 .. 0.25, speed capped at 80, smoothed with lerp 0.25);
--     * aim point = his position + velocity * clamp(|v| / 130, 0.05, 0.12) + 1 stud up;
--     * turning: yaw/pitch error in degrees -> AssemblyAngularVelocity (gain 285, clamp +-28 per axis);
--     * movement: a LinearVelocity mover (per-axis force clamp(mass * max(speed * 220, 6000), 1e6, 5e7), velocity
--       lerp 1 - exp(-dt * 26)) toward chase point = aim point + direction * 2.8 + 4.75 studs up; horizontal
--       speed = approach speed, vertical +-52 while the chase point is above/below you, else -2; also Humanoid:Move;
--     * swing: while "Auto Swing" (WaveTogglePill_23) is on, the held bat/slap Tool is Activated every frame
--       (Vx7 has no range gate or cooldown there).
--   Start: equips the bat/slap Tool only when you hold no Tool. Stop: removes the mover, clears velocities, stands
--   the root upright facing where it looks, restores AutoRotate / PlatformStand.
--   Controls (UI unchanged): "Bat Speed" toggle (WaveTogglePill_22), mobile AIMBOT button and the Aimbot Bind key
--     flip the same toggle. "Bat Aimbot Speed" (TextBox_8) = Vx7 Approach Speed (box accepts 0 < n <= 500, default 58).
--     "Bat Lagger Speed" (TextBox_9) = speed used while a Lagger mode of the speed engine is on (default 40).
--   Kept from the old Wind code: if the "Stealing" attribute is set, Drop BR runs first and the aimbot starts once
--     Stealing is gone (max 5 s). Speed engine: paused while the aimbot has a target (_G.__WindAimbotDriving).
--   Not ported: Vx7's velocity-spoof hook (Config._vxSyncSpoof, a separate speed-engine subsystem, optional there),
--     its brainrot-safety guard, the Vx7 Bat Lagger toggle and Silent Bat Aim (Body Lock stays as it was).
--   Unverified: nothing here was run; the Vx7 numbers are copied from the file, how they behave in the live game is not tested.
--
--   MIRROR TP DOWN (row under "Bat Speed", WaveTogglePill_MirrorTP) = Ace Duel's TP-mirror fall watcher:
--     while the toggle AND the bat aimbot are on, every Heartbeat each living enemy within 8 studs horizontally
--     (distance^2 <= 64) has his root Y compared with the previous frame; a drop of >= 3 studs in one frame
--     teleports YOU to Y = TP_DOWN_Y (-7, same as Ace's _AdaptTpDownFullY default) keeping your yaw and zeroing
--     velocity; 0.08 s debounce. Saved by the generic config capture (toggle key WaveTogglePill_MirrorTP):
--     autosave, "Save Config", "Load" and "Reset Config" all include it.
--   Not ported: Ace's _CandySafeGateBlocked gate (Ace-specific).
-- ==========================================================================
do
	if _G.__WindAimbot and _G.__WindAimbot.Destroy then
		pcall(_G.__WindAimbot.Destroy) -- re-execute: drop the previous instance's loops
	end

	-- the Normal/Bypass mode button belonged to the removed Ace aimbot
	if G.TextButton_43 then G.TextButton_43:Destroy() end

	-- ---------- Vx7 bat aimbot constants (Vx7 tbl36 helpers + the numbers inside tbl36.update) ----------
	local VX = {
		MOVER_NAME = "WindAimbotMoveVelocity",
		ATTACHMENT_NAME = "WindAimbotMoveAttachment",
		MIN_FORCE = 1000000,
		MAX_FORCE = 50000000,
		SPEED_MIN = 1,    -- Vx7 currentSpeed clamp
		SPEED_MAX = 500,
		VEL_CAP = 80,     -- target velocity cap (studs/s)
		VEL_LERP = 0.25,
		LEAD_MIN = 0.05,  -- lead time = clamp(|vel| / 130, 0.05, 0.12)
		LEAD_MAX = 0.12,
		LEAD_DIV = 130,
		AIM_UP = 1,       -- aim point is 1 stud above the target root
		OVERSHOOT = 2.8,  -- chase point = aim point + direction * 2.8 ...
		CHASE_UP = 4.75,  -- ... + 4.75 studs up
		TURN_GAIN = 285,
		TURN_CLAMP = 28,
		CLIMB_SPEED = 52, -- vertical speed while the chase point is above/below you
		SINK_SPEED = -2,
		MOVER_RATE = 26,  -- mover velocity lerp: 1 - exp(-dt * 26)
	}

	-- ---------- speeds (boxes) ----------
	local function validSpeed(n)
		return type(n) == "number" and n == n and n > 0 and n <= VX.SPEED_MAX -- Vx7 box rule: 0 < n <= 500
	end

	local aimSpeeds = { main = 58, lagger = 40 } -- the boxes ship with 58 / 40 (same as Vx7 defaults)
	do
		local a, b = tonumber(G.TextBox_8.Text), tonumber(G.TextBox_9.Text)
		if validSpeed(a) then aimSpeeds.main = a end
		if validSpeed(b) then aimSpeeds.lagger = b end
	end

	local function commitBoxes()
		local a, b = tonumber(G.TextBox_8.Text), tonumber(G.TextBox_9.Text)
		if validSpeed(a) then aimSpeeds.main = a end
		if validSpeed(b) then aimSpeeds.lagger = b end
	end

	local function showBoxes()
		G.TextBox_8.Text = string.format("%g", aimSpeeds.main)
		G.TextBox_9.Text = string.format("%g", aimSpeeds.lagger)
	end

	-- Vx7 currentSpeed: lagger speed while a lagger mode is on, else the main speed; clamped 1..500
	local function currentAimSpeed()
		local lagger = speedCtl.getLaggerMode and speedCtl.getLaggerMode() or 0
		local v = (lagger ~= 0) and aimSpeeds.lagger or aimSpeeds.main
		return math.clamp(tonumber(v) or ((lagger ~= 0) and 40 or 58), VX.SPEED_MIN, VX.SPEED_MAX)
	end

	-- ---------- Vx7 helpers: bat, nearest target, LinearVelocity mover ----------
	local function isBatName(name)
		local lower = name:lower()
		return lower:find("bat") ~= nil or lower:find("slap") ~= nil
	end

	-- Vx7 getBat: a Tool named bat/slap among the character's children first, then in the Backpack
	local function getBat()
		local char = LocalPlayer.Character
		if not char then return nil end
		for _, child in ipairs(char:GetChildren()) do
			if child:IsA("Tool") and isBatName(child.Name) then return child end
		end
		local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
		if backpack then
			for _, child in ipairs(backpack:GetChildren()) do
				if child:IsA("Tool") and isBatName(child.Name) then return child end
			end
		end
		return nil
	end

	-- Vx7 nearestTarget: root part of the nearest living player (by distance to my root)
	local function nearestTarget(myRoot)
		local bestDist, bestRoot = math.huge, nil
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				local c = plr.Character
				local r = c and c:FindFirstChild("HumanoidRootPart")
				local h = c and c:FindFirstChildOfClass("Humanoid")
				if r and h and h.Health > 0 then
					local d = (r.Position - myRoot.Position).Magnitude
					if d < bestDist then
						bestDist, bestRoot = d, r
					end
				end
			end
		end
		return bestRoot
	end

	local function clearMover(root)
		root = root or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
		if not root then return end
		local lv = root:FindFirstChild(VX.MOVER_NAME)
		local att = root:FindFirstChild(VX.ATTACHMENT_NAME)
		if lv and lv:IsA("LinearVelocity") then lv:Destroy() end
		if att and att:IsA("Attachment") then att:Destroy() end
	end

	local function ensureMover(root, speed)
		local att = root:FindFirstChild(VX.ATTACHMENT_NAME)
		if att and not att:IsA("Attachment") then
			att:Destroy()
			att = nil
		end
		if not att then
			att = Instance.new("Attachment")
			att.Name = VX.ATTACHMENT_NAME
			att.Parent = root
		end
		local lv = root:FindFirstChild(VX.MOVER_NAME)
		if not lv or not lv:IsA("LinearVelocity") then
			if lv then lv:Destroy() end
			lv = Instance.new("LinearVelocity")
			lv.Name = VX.MOVER_NAME
			lv.Attachment0 = att
			lv.RelativeTo = Enum.ActuatorRelativeTo.World
			lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
			lv.ForceLimitsEnabled = true
			lv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
			lv.VectorVelocity = Vector3.zero
			lv.Parent = root
		else
			lv.Attachment0 = att
		end
		local force = math.clamp(root.AssemblyMass * math.max(speed * 220, 6000), VX.MIN_FORCE, VX.MAX_FORCE)
		lv.MaxAxesForce = Vector3.new(force, force, force)
		lv.Enabled = true
		return lv
	end

	local function applyMove(root, velocity, speed, dt)
		local lv = ensureMover(root, speed)
		local alpha = 1 - math.exp(-math.max(dt or (1 / 60), 0) * VX.MOVER_RATE)
		lv.VectorVelocity = lv.VectorVelocity:Lerp(velocity, alpha)
	end

	-- Vx7 resetMotion (without the velocity-spoof call, see header)
	local function resetMotion()
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if root then
			clearMover(root)
			root.Anchored = false
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			if sethiddenproperty then
				pcall(sethiddenproperty, root, "PhysicsRepRootPart", nil)
			end
			local look = root.CFrame.LookVector
			local flatLook = Vector3.new(look.X, 0, look.Z)
			local facing = flatLook.Magnitude > 0.01 and flatLook.Unit or Vector3.new(0, 0, -1)
			root.CFrame = CFrame.lookAt(root.Position, root.Position + facing)
		end
		if hum then
			hum.AutoRotate = true
			hum.PlatformStand = false
			pcall(function() hum:Move(Vector3.zero, false) end)
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
		end
	end

	-- target root -> { pos, time, vel } (Vx7 _G._adaptBatPred); weak keys so left players drop out
	local targetTrack = setmetatable({}, { __mode = "k" })

	-- ---------- one aimbot frame (Vx7 tbl36.update, RenderStepped) ----------
	local function stepAim(dt)
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not char or not root or not hum or hum.Health <= 0 then
			_G.__WindAimbotDriving = false
			return
		end

		local targetRoot = nearestTarget(root)
		if not targetRoot then
			hum.AutoRotate = true
			root.AssemblyAngularVelocity = Vector3.zero
			clearMover(root)
			_G.__WindAimbotDriving = false
			return
		end
		_G.__WindAimbotDriving = true -- the speed engine yields while the aimbot has a target
		local speed = currentAimSpeed()
		hum.AutoRotate = false

		-- target velocity: finite difference, capped at 80, smoothed 0.25 (Vx7)
		local now = tick()
		local track = targetTrack[targetRoot]
		local targetVel
		if not track then
			targetTrack[targetRoot] = { pos = targetRoot.Position, time = now, vel = Vector3.zero }
			targetVel = Vector3.zero
		else
			local span = math.clamp(now - track.time, 1 / 120, 0.25)
			local raw = (targetRoot.Position - track.pos) / span
			if raw.Magnitude > VX.VEL_CAP then raw = raw.Unit * VX.VEL_CAP end
			track.vel = track.vel:Lerp(raw, VX.VEL_LERP)
			track.pos = targetRoot.Position
			track.time = now
			targetVel = track.vel
		end

		-- aim point = position + velocity * clamp(|v|/130, 0.05, 0.12) + 1 stud up
		local lead = math.clamp(targetVel.Magnitude / VX.LEAD_DIV, VX.LEAD_MIN, VX.LEAD_MAX)
		local aimPoint = targetRoot.Position + targetVel * lead + Vector3.new(0, VX.AIM_UP, 0)
		local toAim = aimPoint - root.Position
		local dir = toAim.Magnitude > 0.01 and toAim.Unit or Vector3.zero
		local flat = Vector3.new(toAim.X, 0, toAim.Z)

		-- turn: yaw and pitch error in degrees -> angular velocity (gain 285, clamp +-28), pitch axis from current yaw
		if toAim.Magnitude > 0.01 and flat.Magnitude > 0.01 then
			local orient = root.Orientation
			local yawErr = (math.deg(math.atan2(-flat.X, -flat.Z)) - orient.Y + 180) % 360 - 180
			local pitchErr = (math.deg(math.atan2(toAim.Y, flat.Magnitude)) - orient.X + 180) % 360 - 180
			local yawRate = math.clamp(math.rad(yawErr) * VX.TURN_GAIN, -VX.TURN_CLAMP, VX.TURN_CLAMP)
			local pitchRate = math.clamp(math.rad(pitchErr) * VX.TURN_GAIN, -VX.TURN_CLAMP, VX.TURN_CLAMP)
			local yawRad = math.rad(orient.Y)
			local pitchAxis = Vector3.new(math.cos(yawRad), 0, -math.sin(yawRad))
			root.AssemblyAngularVelocity = Vector3.new(0, yawRate, 0) + pitchAxis * pitchRate
		else
			root.AssemblyAngularVelocity = Vector3.zero
		end

		-- move: chase point = aim point + dir * 2.8 + 4.75 up; horizontal at "speed", vertical +-52 or -2
		local chase = aimPoint + dir * VX.OVERSHOOT + Vector3.new(0, VX.CHASE_UP, 0) - root.Position
		local chaseFlat = Vector3.new(chase.X, 0, chase.Z)
		local horizontal = chaseFlat.Magnitude > 0.1 and chaseFlat.Unit * speed or Vector3.zero
		local vertical = math.abs(chase.Y) > 0.1
			and Vector3.new(0, math.sign(chase.Y) * VX.CLIMB_SPEED, 0)
			or Vector3.new(0, VX.SINK_SPEED, 0)
		applyMove(root, horizontal + vertical, speed, dt)
		if chaseFlat.Magnitude > 0.5 then
			hum:Move(chaseFlat.Unit, false)
		end

		-- swing: Vx7 activates the held bat every frame while Auto Swing is on (no range gate, no cooldown)
		if pillOn(G.WaveTogglePill_23) then
			local bat = getBat()
			if bat and bat.Parent == char then
				pcall(bat.Activate, bat)
			end
		end
	end

	-- ---------- start / stop ----------
	local aim = { conn = nil, errShown = false, startToken = 0 }

	local function disconnectLoop()
		if aim.conn then
			aim.conn:Disconnect()
			aim.conn = nil
		end
	end

	local function stopAim()
		aim.startToken += 1 -- cancels a start that is still waiting for the auto drop
		disconnectLoop()
		_G.__WindAimbotDriving = false
		table.clear(targetTrack)
		resetMotion()
		task.spawn(function()
			for _ = 1, 12 do
				task.wait(0.05)
				if aim.conn then return end -- re-enabled meanwhile: do not fight the new loop
				local c = LocalPlayer.Character
				if not c then return end
				local r = c:FindFirstChild("HumanoidRootPart")
				local h = c:FindFirstChildOfClass("Humanoid")
				if h then
					h.AutoRotate = true
					h.PlatformStand = false
				end
				if r then r.AssemblyAngularVelocity = Vector3.zero end
			end
		end)
	end

	-- Vx7 v(): equip the bat only when no Tool is held, clear the mover, then run update on RenderStepped
	local function startAim()
		disconnectLoop()
		aim.errShown = false
		table.clear(targetTrack)
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum and not char:FindFirstChildOfClass("Tool") then
			local bat = getBat()
			if bat and bat.Parent ~= char then
				pcall(hum.EquipTool, hum, bat)
			end
		end
		clearMover()
		aim.conn = RunService.RenderStepped:Connect(function(dt)
			if not pillOn(G.WaveTogglePill_22) then return end
			local ok, err = pcall(stepAim, dt)
			if not ok and not aim.errShown then
				aim.errShown = true
				warn("[WIND] aimbot error: " .. tostring(err))
			end
		end)
	end

	-- WindHub start path (kept from the previous aimbot): carrying a brainrot ("Stealing") -> Drop BR first,
	-- start once it is gone (max 5 s). Vx7's own equivalent is its brainrot-safety guard, which Wind does not have.
	local function startAimAfterAutoDrop()
		aim.startToken += 1
		local token = aim.startToken
		local function begin()
			if token ~= aim.startToken or not pillOn(G.WaveTogglePill_22) then return end
			startAim()
		end
		local char = LocalPlayer.Character
		local hasRoot = char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid")
		if LocalPlayer:GetAttribute("Stealing") and hasRoot then
			task.spawn(function()
				pcall(dropNow)
				local waitStart = tick()
				while LocalPlayer:GetAttribute("Stealing") and tick() - waitStart < 5 do
					task.wait()
				end
				begin()
			end)
		else
			begin()
		end
	end

	-- ---------- toggle / mobile button / bind ----------
	local function syncMobile(on)
		mobileToggles["AIMBOT"] = on
		if G.StackBtn_aimbot then
			TweenService:Create(G.StackBtn_aimbot, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
				BackgroundColor3 = on and Color3.fromRGB(160, 16, 40) or Color3.fromRGB(48, 8, 15)
			}):Play()
		end
	end

	G.WaveTogglePill_22:GetAttributeChangedSignal("WaveToggleOn"):Connect(function()
		local on = pillOn(G.WaveTogglePill_22)
		syncMobile(on)
		if on then startAimAfterAutoDrop() else stopAim() end
	end)

	local function toggleAimbot()
		setToggleVisual(G.WaveTogglePill_22, not pillOn(G.WaveTogglePill_22))
	end
	stackToggleHooks["AIMBOT"] = toggleAimbot
	aimCtl.toggle = toggleAimbot

	local function commitAndShow()
		commitBoxes()
		showBoxes()
	end
	G.TextBox_8.FocusLost:Connect(commitAndShow)
	G.TextBox_9.FocusLost:Connect(commitAndShow)

	-- ---------- config (aim speeds; the toggles are saved by the generic capture) ----------
	aimCtl.getState = function()
		commitBoxes()
		return { main = aimSpeeds.main, lagger = aimSpeeds.lagger }
	end
	aimCtl.setState = function(s)
		if type(s) ~= "table" then return end
		local src = s
		if s.main == nil and s.lagger == nil then -- config written by the old Ace aimbot: { mode, normal = {..}, bypass = {..} }
			src = (s.mode == "Normal" and s.normal) or s.bypass
		end
		if type(src) == "table" then
			if validSpeed(src.main) then aimSpeeds.main = src.main end
			if validSpeed(src.lagger) then aimSpeeds.lagger = src.lagger end
		end
		showBoxes()
	end
	aimCtl.syncFromBoxes = commitAndShow

	showBoxes()
	syncMobile(pillOn(G.WaveTogglePill_22))

	-- ---------- Mirror TP Down (Ace Duel fall watcher) ----------
	local MIRROR_RANGE_SQ = 64        -- Ace: dx*dx + dz*dz <= 64
	local MIRROR_DROP_PER_FRAME = 3   -- Ace: root Y lost between two Heartbeats >= 3 studs
	local MIRROR_DEBOUNCE = 0.08      -- Ace flag14 hold time
	local mirrorPrevY = setmetatable({}, { __mode = "k" })
	local mirrorBusy = false

	local function mirrorTpDown()
		if mirrorBusy then return end
		mirrorBusy = true
		task.delay(MIRROR_DEBOUNCE, function() mirrorBusy = false end)
		if _G.dropActive or _G.IsDropping then return end -- Drop BR owns the root while it runs
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then return end
		pcall(function()
			local _, yaw = root.CFrame:ToEulerAnglesYXZ()
			root.CFrame = CFrame.new(root.Position.X, TP_DOWN_Y, root.Position.Z) * CFrame.Angles(0, yaw, 0)
			root.AssemblyLinearVelocity = Vector3.zero
		end)
	end

	local function mirrorStep()
		local char = LocalPlayer.Character
		local myRoot = char and char:FindFirstChild("HumanoidRootPart")
		if not myRoot then return end
		local myPos = myRoot.Position
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character then
				local r = plr.Character:FindFirstChild("HumanoidRootPart")
				local h = plr.Character:FindFirstChildOfClass("Humanoid")
				if r and h and h.Health > 0 then
					local pos = r.Position
					local dx, dz = pos.X - myPos.X, pos.Z - myPos.Z
					if dx * dx + dz * dz <= MIRROR_RANGE_SQ then
						local prevY = mirrorPrevY[r]
						mirrorPrevY[r] = pos.Y
						if prevY and not mirrorBusy and prevY - pos.Y >= MIRROR_DROP_PER_FRAME then
							mirrorTpDown()
						end
					else
						mirrorPrevY[r] = nil -- out of range: forget him so re-entering never compares against an old Y
					end
				end
			end
		end
	end

	local mirrorConn = RunService.Heartbeat:Connect(function()
		if not (pillOn(G.WaveTogglePill_MirrorTP) and pillOn(G.WaveTogglePill_22)) then
			if next(mirrorPrevY) ~= nil then table.clear(mirrorPrevY) end
			return
		end
		pcall(mirrorStep)
	end)

	_G.__WindAimbot = {
		Destroy = function()
			stopAim()
			if mirrorConn then
				mirrorConn:Disconnect()
				mirrorConn = nil
			end
		end,
	}
end

-- ==========================================================================
-- ADDED: BAT TP (ported from Vx7 "Bat TP", version V2 = the only version Vx7 still runs: Config.batTpVersion is forced to "V2")
--   Controls: "Bat TP" toggle (WaveTogglePill_BatTP, Combat tab, under the Bat Aimbot rows), "Bat TP Bind" key
--   (TextButton_BatTPBind, default T, click it and press a key to rebind) and mobile button BAT TP (StackBtn_batTp).
--   All three flip the same toggle. Saved by the generic config code: toggle = state.toggles.WaveTogglePill_BatTP,
--   key = state.binds.batTp, mobile button position = state.positions.StackBtn_batTp (autosave, Save Config, Load, Reset Config).
--
--   What it does (Vx7 Config._btpVx7V2Update, every Heartbeat while ON):
--     * target = the player locked on last frame while he is alive with a root part; otherwise the nearest living
--       player within 350 studs (Vx7 batTpMaxRange). The lock stays until the target dies / leaves / goes into the void.
--     * if your root is farther than 8 studs (Vx7 batTpStuds default, clamp 1..20) from target root + (0, 0.9, 0): your root
--       is teleported onto that point, facing the way the target faces, velocities zeroed (when the target is in the air
--       and above you the upward velocity is kept, clamped 0..55). Within 8 studs: you are only turned toward the point
--       when your look direction differs by more than ~10 degrees, velocities are zeroed every frame.
--     * AutoRotate is switched off while driving; the camera is aimed at the target every frame.
--     * swing every 0.04 s: Tool:Activate() on the held Bat, plus FireServer() on the first RemoteEvent found inside the Bat.
--     * no Bat held -> the first Tool whose name contains "bat" is taken from the Backpack and equipped (Vx7 _btpResolveBat).
--   Mutual exclusion (like Vx7 setBatTp pausing silentBatAim): turning Bat TP ON turns the Bat Aimbot off and cancels an
--   Auto Left/Right run; turning the Bat Aimbot ON, or starting Auto Left/Right, turns Bat TP off. Nothing is restored afterwards.
--   The speed engine and Body Lock yield while Bat TP drives the root (_G.__WindBatTpDriving, same idea as __WindAimbotDriving).
--
--   Deviations from Vx7 (on purpose, not ported):
--     * Vx7's anti-spoof layer (tbl40: activeThreatPlayer priority, ghost/proxy-root detection, safe anchors, PhysicsRepRootPart
--       checks), its Anti Die link, no-collision mode and "return to start CFrame" on stop. Vx7 never sets the flag that
--       enables the return in V2, so stopping simply leaves you where you are.
--     * Void guard: a target whose root is non-finite, beyond +-4096 studs or at/below Y = max(FallenPartsDestroyHeight + 35, -20)
--       (Vx7 fn57 threshold) is dropped instead of followed, so you are never teleported into the void.
--     * AutoRotate is set back to true on stop / when there is no target (Vx7 restores the value it saw before).
--     * Studs (8), range (350) and the 0.04 s swing interval are constants here: the Wind UI has no boxes for them.
--     * Drop BR running (_G.dropActive / _G.IsDropping) pauses Bat TP, like it pauses Mirror TP Down.
--     * The hub's "Auto Swing" toggle only gates the Bat Aimbot swing; Bat TP always swings, as in Vx7.
-- ==========================================================================
do
	if _G.__WindBatTp and _G.__WindBatTp.Destroy then
		pcall(_G.__WindBatTp.Destroy) -- re-execute: drop the previous instance's loop
	end

	local BTP = {
		STUDS = 8,
		MAX_RANGE = 350,
		HEIGHT = 0.9,
		SWING_INTERVAL = 0.04,
		COORD_LIMIT = 4096,
		AIR_VELOCITY_MAX = 55,
		LOOK_DOT = 0.985,
	}

	local pill = G.WaveTogglePill_BatTP
	local bt = {
		conn = nil,
		target = nil,
		nextSwingAt = 0,
		rotateHeld = false,
		bat = nil,
		batRemote = nil,
		batRemoteBat = nil,
		errShown = false,
	}

	-- ---------- bat (Vx7 _btpIsBat / _btpResolveBat) ----------
	local function isBat(inst)
		return inst ~= nil and inst:IsA("Tool") and inst.Name:lower():find("bat", 1, true) ~= nil
	end

	local function resolveBat(equip)
		local char = LocalPlayer.Character
		if not char then
			bt.bat = nil
			return nil
		end
		local backpack = LocalPlayer:FindFirstChild("Backpack")
		local hum = char:FindFirstChildOfClass("Humanoid")
		local held
		for _, child in ipairs(char:GetChildren()) do
			if isBat(child) then
				if not held then
					held = child
				elseif backpack then
					child.Parent = backpack -- a second bat goes back to the Backpack
				end
			end
		end
		local bat = held
		if not bat and isBat(bt.bat) and (bt.bat.Parent == char or bt.bat.Parent == backpack) then
			bat = bt.bat
		end
		if not bat and backpack then
			for _, child in ipairs(backpack:GetChildren()) do
				if isBat(child) then
					bat = child
					break
				end
			end
		end
		if not bat then
			bt.bat = nil
			return nil
		end
		bt.bat = bat
		if equip and bat.Parent ~= char then
			if hum then
				pcall(hum.EquipTool, hum, bat)
			else
				pcall(function() bat.Parent = char end)
			end
		end
		return bat
	end

	local function swing()
		local bat = resolveBat(true)
		if not bat then return end
		if bt.batRemoteBat ~= bat or (bt.batRemote and not bt.batRemote.Parent) then
			bt.batRemoteBat = bat
			bt.batRemote = bat:FindFirstChildWhichIsA("RemoteEvent", true)
		end
		bat:Activate()
		if bt.batRemote and bt.batRemote.Parent then
			bt.batRemote:FireServer()
		end
	end

	-- ---------- target (Vx7 _btpFindClosestPlayer + fn57 void check) ----------
	local function rootLooksBad(root)
		local p = root.Position
		if p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z then return true end
		if math.abs(p.X) > BTP.COORD_LIMIT or math.abs(p.Y) > BTP.COORD_LIMIT or math.abs(p.Z) > BTP.COORD_LIMIT then
			return true
		end
		return p.Y <= math.max((workspace.FallenPartsDestroyHeight or -500) + 35, -20)
	end

	local function liveParts(plr)
		local char = plr and plr.Parent == Players and plr.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if root and hum and hum.Health > 0 and not rootLooksBad(root) then
			return root, hum
		end
		return nil, nil
	end

	local function findClosest(myPos)
		local bestDist, bestPlayer = math.huge, nil
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				local root = liveParts(plr)
				if root then
					local d = (myPos - root.Position).Magnitude
					if d <= BTP.MAX_RANGE and d < bestDist then
						bestDist, bestPlayer = d, plr
					end
				end
			end
		end
		return bestPlayer
	end

	-- ---------- AutoRotate bookkeeping ----------
	local function releaseRotate()
		if not bt.rotateHeld then return end
		bt.rotateHeld = false
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum and hum.Parent then
			pcall(function() hum.AutoRotate = true end)
		end
	end

	-- ---------- main step (Vx7 _btpVx7V2Update) ----------
	local function batTpStep()
		if not pillOn(pill) then return end
		if _G.dropActive or _G.IsDropping then
			_G.__WindBatTpDriving = false -- Drop BR owns the root while it runs
			return
		end
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not root or not hum or hum.Health <= 0 then
			_G.__WindBatTpDriving = false
			releaseRotate()
			return
		end
		local myState = hum:GetState()
		if hum.PlatformStand
			or myState == Enum.HumanoidStateType.Physics
			or myState == Enum.HumanoidStateType.Ragdoll
			or myState == Enum.HumanoidStateType.FallingDown then
			_G.__WindBatTpDriving = false -- ragdolled: let go until you can stand again
			releaseRotate()
			return
		end

		if not char:FindFirstChildOfClass("Tool") then
			resolveBat(true)
		end

		local target = bt.target
		local tRoot, tHum = liveParts(target)
		if not tRoot then
			target = findClosest(root.Position)
			bt.target = target
			tRoot, tHum = liveParts(target)
		end
		if not target or not tRoot or not tHum then
			_G.__WindBatTpDriving = false -- nobody in range: you can walk normally
			releaseRotate()
			return
		end

		bt.rotateHeld = true
		hum.AutoRotate = false
		_G.__WindBatTpDriving = true

		local pos = tRoot.Position
		local targetRotation = tRoot.CFrame - tRoot.Position
		local anchor = pos + Vector3.new(0, BTP.HEIGHT, 0)
		local far = (root.Position - anchor).Magnitude > BTP.STUDS
		local from = far and anchor or root.Position
		local tState = tHum:GetState()
		local airFollow = far
			and (tHum.FloorMaterial == Enum.Material.Air
				or tState == Enum.HumanoidStateType.Jumping
				or tState == Enum.HumanoidStateType.Freefall)
			and anchor.Y > root.Position.Y + 1
		local targetVelY = tRoot.AssemblyLinearVelocity.Y

		local flat = Vector3.new(anchor.X - from.X, 0, anchor.Z - from.Z)
		local goal
		if flat.Magnitude > 0.05 then
			goal = CFrame.lookAt(from, from + flat.Unit)
		else
			local look = Vector3.new(targetRotation.LookVector.X, 0, targetRotation.LookVector.Z)
			if look.Magnitude >= 0.01 then
				goal = CFrame.lookAt(from, from + look.Unit)
			else
				local _, yaw = root.CFrame:ToEulerAnglesYXZ()
				goal = CFrame.new(from) * CFrame.Angles(0, yaw, 0)
			end
		end

		pcall(function()
			if far then
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
				root.CFrame = goal
				if airFollow then
					root.AssemblyLinearVelocity = Vector3.new(0, math.clamp(targetVelY, 0, BTP.AIR_VELOCITY_MAX), 0)
				else
					root.AssemblyLinearVelocity = Vector3.zero
				end
				root.AssemblyAngularVelocity = Vector3.zero
			else
				if root.CFrame.LookVector:Dot(goal.LookVector) < BTP.LOOK_DOT then
					root.CFrame = goal
				end
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
			end
		end)

		local cam = workspace.CurrentCamera
		if cam then
			pcall(function()
				cam.CFrame = CFrame.new(cam.CFrame.Position, pos)
			end)
		end

		local now = os.clock()
		if now >= bt.nextSwingAt then
			bt.nextSwingAt = now + BTP.SWING_INTERVAL
			pcall(swing)
		end
	end

	-- ---------- start / stop ----------
	local function stopBatTp()
		if bt.conn then
			bt.conn:Disconnect()
			bt.conn = nil
		end
		bt.target = nil
		bt.nextSwingAt = 0
		bt.batRemote = nil
		bt.batRemoteBat = nil
		_G.__WindBatTpDriving = false
		releaseRotate()
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root then
			pcall(function()
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
			end)
		end
	end

	local function startBatTp()
		if bt.conn then
			bt.conn:Disconnect()
			bt.conn = nil
		end
		bt.target = nil
		bt.nextSwingAt = 0
		bt.errShown = false
		pcall(resolveBat, true) -- Vx7 fn63: take the bat out right away
		bt.conn = RunService.Heartbeat:Connect(function()
			local ok, err = pcall(batTpStep)
			if not ok and not bt.errShown then
				bt.errShown = true
				warn("[WIND] Bat TP error: " .. tostring(err))
			end
		end)
	end

	-- ---------- toggle / mobile button / bind ----------
	local function syncMobile(on)
		mobileToggles["BAT TP"] = on
		if G.StackBtn_batTp then
			TweenService:Create(G.StackBtn_batTp, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
				BackgroundColor3 = on and Color3.fromRGB(160, 16, 40) or Color3.fromRGB(48, 8, 15)
			}):Play()
		end
	end

	pill:GetAttributeChangedSignal("WaveToggleOn"):Connect(function()
		local on = pillOn(pill)
		syncMobile(on)
		if on then
			if pillOn(G.WaveTogglePill_22) then
				setToggleVisual(G.WaveTogglePill_22, false) -- Bat Aimbot off while Bat TP runs
			end
			if autoLR.running then
				pcall(autoLR.stop)
			end
			startBatTp()
		else
			stopBatTp()
		end
	end)

	-- Bat Aimbot switched on -> Bat TP off
	G.WaveTogglePill_22:GetAttributeChangedSignal("WaveToggleOn"):Connect(function()
		if pillOn(G.WaveTogglePill_22) and pillOn(pill) then
			setToggleVisual(pill, false)
		end
	end)

	local function toggleBatTp()
		setToggleVisual(pill, not pillOn(pill))
	end
	stackToggleHooks["BAT TP"] = toggleBatTp
	aimCtl.toggleBatTp = toggleBatTp

	syncMobile(pillOn(pill))
	_G.__WindBatTpDriving = false

	_G.__WindBatTp = {
		Destroy = function()
			stopBatTp()
		end,
	}
end

-- ==========================================================================
-- ADDED: SPINBOT (ported from Cz Hub "Spin", Cz_hub_spinner.txt)
--   Controls: "Spinbot" toggle (WaveTogglePill_Spinbot, Combat tab, under the Bat TP rows), "Spinbot Bind" key
--   (TextButton_SpinbotBind, default V, click it and press a key to rebind) and mobile button SPINBOT (StackBtn_spinbot,
--   5th row, right of BAT TP). All three flip the same toggle. Saved by the generic config code: toggle =
--   state.toggles.WaveTogglePill_Spinbot, key = state.binds.spinbot, mobile button position = state.positions.StackBtn_spinbot.
--   Spin = Cz's rotation, unchanged: every RunService.Stepped, Root.CFrame = Root.CFrame * CFrame.Angles(0, rad((speed * dt) % 360), 0),
--   with Humanoid.AutoRotate kept off while spinning (Cz does this so running / holding a tool cannot fight the rotation)
--   and set back to true when the spinbot is switched off. Speed = SPIN_SPEED below = 2000 (Cz unit: degrees per second).
--   Drop BR: unchanged and usable while spinning (key X, mobile DROP BR). The spin steps aside while Drop BR runs
--   (_G.dropActive / _G.IsDropping, about 0.2 s) so the drop moves the root exactly as without spin, then spinning resumes.
--   The spin also steps aside while the Bat Aimbot has a target, Bat TP or Auto Left/Right drives the root
--   (_G.__WindAimbotDriving / __WindBatTpDriving / __WindAutoLRDriving, same convention as the speed engine and Body Lock);
--   no toggle is switched by this, it just resumes when they stop.
--   Not ported: Cz's Anti Die / Anti Fling toggles, its Highlight outline, its speed text box and its GUI (Wind already has
--   its own Anti Die; Cz also turns its health protection on whenever Spin is on, Wind's Spinbot does not).
--   An imported config never switches the Spinbot on by itself (IMPORT_FORCE_OFF).
-- ==========================================================================
do
	if _G.__WindSpinbot and _G.__WindSpinbot.Destroy then
		pcall(_G.__WindSpinbot.Destroy) -- re-execute: drop the previous instance's loop
	end

	local SPIN_SPEED = 2000 -- degrees per second (Cz "SpinSpeed"); edit this number to change the speed

	local pill = G.WaveTogglePill_Spinbot
	local spin = { conn = nil, errShown = false }

	local function otherFeatureOwnsRoot()
		return _G.dropActive == true or _G.IsDropping == true
			or _G.__WindAimbotDriving == true
			or _G.__WindBatTpDriving == true
			or _G.__WindAutoLRDriving == true
	end

	-- one Cz spin step (RunService.Stepped body)
	local function spinStep(_, dt)
		if not pillOn(pill) then return end
		if type(dt) ~= "number" or dt ~= dt or dt <= 0 then return end
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not root or not hum or hum.Health <= 0 then return end
		if root.Anchored or hum.Sit then return end
		if otherFeatureOwnsRoot() then return end

		-- keep auto-rotate off in case it got re-enabled (tool equip, respawn)
		if hum.AutoRotate then
			hum.AutoRotate = false
		end

		local degrees = (SPIN_SPEED * dt) % 360
		root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(degrees), 0)
	end

	local function stopSpin()
		if spin.conn then
			spin.conn:Disconnect()
			spin.conn = nil
		end
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.AutoRotate = true
		end
	end

	local function startSpin()
		if spin.conn then return end
		spin.errShown = false
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.AutoRotate = false
		end
		spin.conn = RunService.Stepped:Connect(function(t, dt)
			local ok, err = pcall(spinStep, t, dt)
			if not ok and not spin.errShown then
				spin.errShown = true
				warn("[WIND] spinbot error: " .. tostring(err))
			end
		end)
	end

	-- ---------- toggle / mobile button / bind ----------
	local function syncMobile(on)
		mobileToggles["SPINBOT"] = on
		if G.StackBtn_spinbot then
			TweenService:Create(G.StackBtn_spinbot, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
				BackgroundColor3 = on and Color3.fromRGB(160, 16, 40) or Color3.fromRGB(48, 8, 15)
			}):Play()
		end
	end

	pill:GetAttributeChangedSignal("WaveToggleOn"):Connect(function()
		local on = pillOn(pill)
		syncMobile(on)
		if on then startSpin() else stopSpin() end
	end)

	local function toggleSpinbot()
		setToggleVisual(pill, not pillOn(pill))
	end
	stackToggleHooks["SPINBOT"] = toggleSpinbot
	aimCtl.toggleSpinbot = toggleSpinbot

	syncMobile(pillOn(pill))
	if pillOn(pill) then startSpin() end

	_G.__WindSpinbot = {
		Destroy = function()
			stopSpin()
		end,
	}
end

-- ==========================================================================
-- ADDED: AUTO STEAL (ported from "good 1.3" auto steal by mafia)
--   Controls (existing UI, nothing new added):
--     "Auto Steal" toggle (WaveTogglePill_29) = engine on/off.
--     "Steal Radius" box  (TextBox_10)        = radius in studs (clamped 1..300, whole numbers; read live).
--   Config: both controls are captured by the generic config code below (toggle key WaveTogglePill_29,
--     text key TextBox_10), so autosave, "Save Config", "Load" and "Reset Config" include them. Loading a
--     config flips the toggle, which starts/stops the engine through the attribute signal.
--   Game data taken from the "good 1.3" script (NOT verified against the game by me):
--     workspace.Plots.<plot>.PlotSign.YourBase (BillboardGui, Enabled = your plot),
--     <plot>.AnimalPodiums.<pod>.Base.Spawn.PromptAttachment -> ProximityPrompt with ActionText containing "Steal",
--     ReplicatedStorage.StealAnimal (RemoteEvent, FireServer(podName)).
--   Duration is fixed at 1.3 s (the "Steal Duration" row was removed from this hub earlier). The "Normal" button
--     (TextButton_48) is not wired.
--   AUTO PAUSE (ported from Vx7 "Auto Grab Pause", V1 steal): the "Steal Pause %" box (TextBox_StealPause, Combat page,
--     above "Steal Radius") sets at which bar progress the steal pauses. Value 1..99 (default 85), 0 = pause off
--     (then the old behaviour: no hold, split point 73%). Sequence with the pause on:
--       1) the bar fills 0 -> pause% in 1.3 * pause% seconds,
--       2) it HOLDS at pause% until you are within STEAL.PAUSE_RELEASE_DIST_* studs of the target (Vx7: 7 studs when
--          pause% >= 80, otherwise 9.3). While holding, a nearer steal prompt inside that distance takes over (as in Vx7),
--       3) then the rest fills in 1.3 * (1 - pause%) seconds and the steal fires.
--     If you are not close enough within STEAL.PAUSE_HOLD_TIMEOUT (1.6 s, Vx7 value) or you leave the radius, the steal
--     is aborted without firing and the engine waits STEAL.RETRY_COOLDOWN (0.12 s, Vx7) before it starts again.
--     The distances / timeout come from the Vx7 script and are NOT verified against the game by me.
--   Progress is drawn on the existing steal bar (Fill) and the bar label shows STEALING... while a steal runs.
--   Ragdoll Steal: stealHooks.stop/resume below are now set, and new steals also wait while
--     _G._WindStealRagdollPaused is true.
-- ==========================================================================
do
	if _G.__WindAutoSteal and _G.__WindAutoSteal.Destroy then
		pcall(_G.__WindAutoSteal.Destroy) -- re-execute: drop the previous instance
	end

	local STEAL = {
		DURATION = 1.3,
		STOP_FRACTION = 0.73,            -- split point when "Steal Pause %" is 0 (pause off)
		PAUSE_DEFAULT = 0,               -- percent; 0 = "Unpatched Auto Grab" sequence below (the box default is "0" too)
		UNPATCHED_DURATION = 1.2,        -- "Unpatched Auto Grab": hold time before the trigger fires
		UNPATCHED_BAR_CAP = 0.75,        -- "Unpatched Auto Grab": VISUAL cap, the bar stops at 75%
		UNPATCHED_RETRY_DELAY = 0.12,    -- second fire pass after the first
		UNPATCHED_COOLDOWN = 0.45,       -- no new steal for this long after a fire
		PAUSE_MIN = 1,
		PAUSE_MAX = 99,
		PAUSE_RELEASE_DIST_HIGH = 7,     -- studs, Vx7 n14 when pause% >= 80
		PAUSE_RELEASE_DIST_LOW = 9.3,    -- studs, Vx7 n14 when pause% < 80
		PAUSE_HOLD_TIMEOUT = 1.6,        -- seconds, Vx7
		PAUSE_SWITCH_SCAN = 0.1,         -- seconds between "nearer prompt" scans while holding
		RETRY_COOLDOWN = 0.12,           -- seconds after an aborted hold, Vx7
		RADIUS_DEFAULT = 60,
		RADIUS_MIN = 1,
		RADIUS_MAX = 300,
		PLOTS_CACHE_SECONDS = 2,
	}

	local function install()
		local pill = G.WaveTogglePill_29
		local radiusBox = G.TextBox_10
		if typeof(pill) ~= "Instance" or typeof(radiusBox) ~= "Instance" then
			warn("[WIND] Auto Steal: toggle (WaveTogglePill_29) or radius box (TextBox_10) not found, engine not installed")
			return nil
		end

		local ReplicatedStorage = game:GetService("ReplicatedStorage")

		local active = false
		local busy = false
		local runId = 0 -- bumped to abort the steal that is currently running
		local cooldownUntil = 0 -- tick() before which no new steal starts (set after an aborted pause hold)
		local heartbeatConn
		local pillConn
		local dataByPrompt = {} -- [ProximityPrompt] = { hold = {fn}, trigger = {fn} } (game handlers, cached once)

		-- ---------- radius ----------
		local lastGoodRadius = STEAL.RADIUS_DEFAULT
		local function readRadius()
			local n = tonumber(radiusBox.Text)
			if n and n == n and n ~= math.huge and n ~= -math.huge then
				lastGoodRadius = math.clamp(n, STEAL.RADIUS_MIN, STEAL.RADIUS_MAX)
			end
			return lastGoodRadius
		end

		local function syncRadiusLabel()
			StealRadiusLabel.Text = "Radius: " .. string.format("%g", readRadius())
		end
		local radiusTextConn = radiusBox:GetPropertyChangedSignal("Text"):Connect(syncRadiusLabel)
		local radiusFocusConn = radiusBox.FocusLost:Connect(function()
			radiusBox.Text = string.format("%g", readRadius()) -- invalid input snaps back to the last valid value
		end)
		syncRadiusLabel()

		-- ---------- pause percent ("Steal Pause %" box, optional: a missing box means the default) ----------
		local pauseBox = G.TextBox_StealPause
		local lastGoodPause = STEAL.PAUSE_DEFAULT
		local function pauseText(n)
			return string.format("%g", n)
		end
		-- returns the pause as a fraction 0.01..0.99, or nil when the pause is off (box = 0)
		local function readPauseFraction()
			if typeof(pauseBox) == "Instance" then
				local n = tonumber(pauseBox.Text)
				if n and n == n and n ~= math.huge and n ~= -math.huge then
					if n <= 0 then
						lastGoodPause = 0
					else
						lastGoodPause = math.clamp(n, STEAL.PAUSE_MIN, STEAL.PAUSE_MAX)
					end
				end
			end
			if lastGoodPause <= 0 then return nil end
			return lastGoodPause / 100
		end
		local pauseFocusConn
		if typeof(pauseBox) == "Instance" then
			pauseFocusConn = pauseBox.FocusLost:Connect(function()
				readPauseFraction()
				pauseBox.Text = pauseText(lastGoodPause) -- invalid input snaps back to the last valid value
			end)
			readPauseFraction() -- a saved config may already have changed the box
		end

		-- ---------- steal bar ----------
		local function setBar(p)
			Fill.Size = UDim2.new(math.clamp(p, 0, 1), 0, 1, 0)
		end

		local function setBarLabel(stealing)
			if stealActive then return end -- the manual click demo on the bar owns the label while it runs
			if stealing then
				StealLabel.Text = "STEALING..."
				StealLabel.TextColor3 = Color3.fromRGB(255, 130, 145)
				StealUIStroke.Color = Color3.fromRGB(255, 60, 85)
			else
				StealLabel.Text = "STEAL"
				StealLabel.TextColor3 = Color3.fromRGB(205, 210, 225)
				StealUIStroke.Color = Color3.fromRGB(235, 95, 115)
			end
		end

		-- ---------- target search ----------
		local plotsCache, plotsCacheAt = nil, 0
		local function getPlotsRoot()
			local now = tick()
			if plotsCache and plotsCache.Parent and now - plotsCacheAt < STEAL.PLOTS_CACHE_SECONDS then
				return plotsCache
			end
			plotsCache = workspace:FindFirstChild("Plots")
			plotsCacheAt = now
			return plotsCache
		end

		local function isMyPlot(plot)
			local sign = plot:FindFirstChild("PlotSign")
			local yourBase = sign and sign:FindFirstChild("YourBase")
			return yourBase ~= nil and yourBase:IsA("BillboardGui") and yourBase.Enabled == true
		end

		local function getRoot()
			local char = LocalPlayer.Character
			return char and char:FindFirstChild("HumanoidRootPart")
		end

		local function findStealPrompt(spawnPart)
			local att = spawnPart:FindFirstChild("PromptAttachment")
			if not att then return nil end
			for _, child in ipairs(att:GetChildren()) do
				if child:IsA("ProximityPrompt") and type(child.ActionText) == "string" and child.ActionText:find("Steal") then
					return child
				end
			end
			return nil
		end

		local function findNearestPrompt()
			local root = getRoot()
			local plotsRoot = getPlotsRoot()
			if not root or not plotsRoot then return nil, nil end
			local radius = readRadius()
			local rpos = root.Position
			local bestPrompt, bestName, bestDist = nil, nil, math.huge
			for _, plot in ipairs(plotsRoot:GetChildren()) do
				if not isMyPlot(plot) then
					local pods = plot:FindFirstChild("AnimalPodiums")
					if pods then
						for _, pod in ipairs(pods:GetChildren()) do
							local base = pod:FindFirstChild("Base")
							local spawnPart = base and base:FindFirstChild("Spawn")
							if spawnPart and spawnPart:IsA("BasePart") then
								local dist = (spawnPart.Position - rpos).Magnitude
								if dist < bestDist and dist <= radius then
									local prompt = findStealPrompt(spawnPart)
									if prompt then
										bestPrompt, bestName, bestDist = prompt, pod.Name, dist
									end
								end
							end
						end
					end
				end
			end
			return bestPrompt, bestName
		end

		-- ---------- steal execution ----------
		local function cancelCurrent()
			runId += 1
			busy = false
			setBar(0)
			setBarLabel(false)
		end

		local function promptPart(prompt)
			local att = prompt.Parent
			local part = att and att.Parent
			if part and part:IsA("BasePart") then return part end
			return nil
		end

		local function inRange(prompt)
			local part = promptPart(prompt)
			local root = getRoot()
			if not part or not root or not prompt:IsDescendantOf(workspace) then return false end
			return (root.Position - part.Position).Magnitude <= readRadius()
		end

		-- game handlers of a prompt, read once and cached (shared by the steal start and the pause take-over)
		local function getPromptData(prompt)
			for p in pairs(dataByPrompt) do
				if not p.Parent then dataByPrompt[p] = nil end
			end
			local data = dataByPrompt[prompt]
			if not data then
				data = { hold = {}, trigger = {} }
				dataByPrompt[prompt] = data
				if type(getconnections) == "function" then
					pcall(function()
						for _, c in ipairs(getconnections(prompt.PromptButtonHoldBegan)) do
							if c.Function then table.insert(data.hold, c.Function) end
						end
						for _, c in ipairs(getconnections(prompt.Triggered)) do
							if c.Function then table.insert(data.trigger, c.Function) end
						end
					end)
				end
			end
			return data
		end

		local function fireSteal(prompt, podName, data, noRemote)
			for _, fn in ipairs(data.trigger) do task.spawn(fn) end
			local remote = not noRemote and ReplicatedStorage:FindFirstChild("StealAnimal")
			if remote and remote:IsA("RemoteEvent") and podName then
				pcall(function() remote:FireServer(podName) end)
			end
			if type(fireproximityprompt) == "function" then
				pcall(fireproximityprompt, prompt)
			else
				pcall(function() prompt:InputHoldBegin() end)
				task.wait(0.05)
				pcall(function() prompt:InputHoldEnd() end)
			end
		end

		-- returns true when the steal was fired, false when it was aborted
		local function runSteal(prompt, podName, data, myRun)
			local duration = STEAL.DURATION
			local pauseFraction = readPauseFraction() -- nil = pause off

			-- pause off ("Steal Pause %" = 0): the "Unpatched Auto Grab" sequence (By Weekly):
			--   hold handlers -> wait 1.2 s (bar capped at 75%) -> fire prompt + trigger handlers -> retry after 0.12 s -> 0.45 s cooldown
			if not pauseFraction then
				for _, fn in ipairs(data.hold) do task.spawn(fn) end
				local t0 = tick()
				local dur = STEAL.UNPATCHED_DURATION
				while true do
					if myRun ~= runId or not active then return false end
					local elapsed = tick() - t0
					setBar(math.min(elapsed / dur, 1) * STEAL.UNPATCHED_BAR_CAP)
					if elapsed >= dur then break end
					task.wait()
				end
				fireSteal(prompt, podName, data, true)
				setBar(0) -- clear the visual at once, as the original does
				task.wait(STEAL.UNPATCHED_RETRY_DELAY)
				if myRun == runId and active then fireSteal(prompt, podName, data, true) end
				cooldownUntil = tick() + STEAL.UNPATCHED_COOLDOWN
				return true
			end
			local stopProgress = pauseFraction or STEAL.STOP_FRACTION
			local stopTime = duration * stopProgress
			local startTime = tick()

			for _, fn in ipairs(data.hold) do task.spawn(fn) end

			-- phase 1: fill up to the stop / pause point; leaving range or turning the toggle off aborts
			while true do
				if myRun ~= runId or not active or not inRange(prompt) then return false end
				local elapsed = tick() - startTime
				setBar(math.min(elapsed / duration, stopProgress))
				if elapsed >= stopTime then break end
				task.wait()
			end

			-- phase 1b (Vx7 "Auto Grab Pause"): HOLD the bar at the pause point until you are close to the target
			if pauseFraction then
				local releaseDist = pauseFraction >= 0.8 and STEAL.PAUSE_RELEASE_DIST_HIGH or STEAL.PAUSE_RELEASE_DIST_LOW
				local holdStart = tick()
				local lastScan = 0
				while true do
					if myRun ~= runId or not active then return false end
					local root = getRoot()
					local part = promptPart(prompt)
					if not root or not part or not prompt:IsDescendantOf(workspace) then return false end
					local dist = (root.Position - part.Position).Magnitude
					if dist > readRadius() then return false end -- left the radius
					if dist <= releaseDist then break end -- close enough: continue
					if tick() - holdStart >= STEAL.PAUSE_HOLD_TIMEOUT then
						cooldownUntil = tick() + STEAL.RETRY_COOLDOWN
						return false -- never got close: abort without firing
					end
					-- a nearer prompt inside the release distance takes over (Vx7 does the same and then continues)
					if tick() - lastScan >= STEAL.PAUSE_SWITCH_SCAN then
						lastScan = tick()
						local other, otherName = findNearestPrompt()
						if other and other ~= prompt then
							local otherPart = promptPart(other)
							if otherPart and (otherPart.Position - root.Position).Magnitude <= releaseDist then
								prompt, podName, data = other, otherName, getPromptData(other)
								for _, fn in ipairs(data.hold) do task.spawn(fn) end
								break
							end
						end
					end
					setBar(stopProgress)
					task.wait()
				end
			end

			-- phase 2: fill the rest, then fire
			local fillStart = tick()
			local fillDuration = math.max(duration - stopTime, 0.05)
			while true do
				if myRun ~= runId or not active then return false end
				local fp = math.clamp((tick() - fillStart) / fillDuration, 0, 1)
				setBar(stopProgress + fp * (1 - stopProgress))
				if fp >= 1 then break end
				task.wait()
			end

			fireSteal(prompt, podName, data)
			return true
		end

		local function executeSteal(prompt, podName)
			if busy then return end

			local data = getPromptData(prompt)

			runId += 1
			local myRun = runId
			busy = true
			setBarLabel(true)
			task.spawn(function()
				local ok, result = pcall(runSteal, prompt, podName, data, myRun)
				if not ok then warn("[WIND] Auto Steal error: " .. tostring(result)) end
				if myRun == runId then -- not superseded by cancelCurrent()
					busy = false
					setBar(0)
					setBarLabel(false)
				end
			end)
		end

		-- ---------- on / off ----------
		local function start()
			if active and heartbeatConn then return end
			active = true
			heartbeatConn = RunService.Heartbeat:Connect(function()
				if not active or busy or _G._WindStealRagdollPaused or _G._WindStealHitPaused then return end
				if tick() < cooldownUntil then return end
				local prompt, podName = findNearestPrompt()
				if prompt then executeSteal(prompt, podName) end
			end)
		end

		local function stop()
			active = false
			if heartbeatConn then
				heartbeatConn:Disconnect()
				heartbeatConn = nil
			end
			cancelCurrent()
		end

		local function syncFromToggle()
			if pillOn(pill) then start() else stop() end
		end
		pillConn = pill:GetAttributeChangedSignal("WaveToggleOn"):Connect(syncFromToggle)

		-- Ragdoll Steal section above: pause = abort the running steal, resume = restart if the toggle is still on
		stealHooks.stop = cancelCurrent
		stealHooks.resume = function()
			if pillOn(pill) then start() end
		end

		local api = {}
		api.IsEnabled = function() return active end
		api.Destroy = function()
			stop()
			if pillConn then pillConn:Disconnect() pillConn = nil end
			if radiusTextConn then radiusTextConn:Disconnect() radiusTextConn = nil end
			if radiusFocusConn then radiusFocusConn:Disconnect() radiusFocusConn = nil end
			if pauseFocusConn then pauseFocusConn:Disconnect() pauseFocusConn = nil end
			if stealHooks.stop == cancelCurrent then stealHooks.stop = nil end
			stealHooks.resume = nil
		end

		syncFromToggle() -- the toggle may already be ON (the saved config is applied further down)
		return api
	end

	local okInstall, api = pcall(install)
	if okInstall then
		_G.__WindAutoSteal = api
	else
		warn("[WIND] Auto Steal install failed: " .. tostring(api))
	end
end

-- ==========================================================================
-- ADDED: AUTO STEAL STOP (ported from Vx7 "Stop When Hit")
--   Control: "Auto Steal Stop" toggle (WaveTogglePill_AutoStealStop, row under "Auto Steal").
--   Active only while BOTH this toggle and "Auto Steal" (WaveTogglePill_29) are on.
--   What it does (same triggers and timings as Vx7 defaults):
--     you get hit = Humanoid state Physics / Ragdoll / FallingDown, PlatformStand turns on, Health drops,
--     or the ragdoll attributes (RagdollEndTime / Ragdolled / Ragdoll on Player, Character, Humanoid) say ragdolled,
--     or a Medusa freeze = 3+ anchored, fully transparent BaseParts directly in your Character.
--     -> the running steal is aborted (bar reset) and no new steal starts for 1.3 s (3 s for Medusa),
--        then the Auto Steal engine continues by itself.
--   Mechanism: sets _G._WindStealHitPaused (read by the Auto Steal engine loop) and calls stealHooks.stop.
--   Turning the toggle off during a pause ends the pause at once (as in Vx7). Respawn clears the pause.
--   Differences to Vx7: the "Reset bar pause" seconds box is not added (fixed 1.3 s); the Medusa check skips while
--     Drop BR runs (_G.dropActive / _G.IsDropping, the Drop BR flags this hub already uses) instead of Vx7's own flags.
--   Game data (attribute names, state list) is taken from the Vx7 script, NOT verified against the game by me.
--   Config: the toggle key starts with "WaveTogglePill", so autosave / Save Config / Load / Reset include it.
-- ==========================================================================
do
	if _G.__WindAutoStealStop and _G.__WindAutoStealStop.Destroy then
		pcall(_G.__WindAutoStealStop.Destroy) -- re-execute: drop the previous instance
	end
	_G._WindStealHitPaused = false

	local function install()
		local pill = G.WaveTogglePill_AutoStealStop
		local autoPill = G.WaveTogglePill_29
		if typeof(pill) ~= "Instance" or typeof(autoPill) ~= "Instance" then
			warn("[WIND] Auto Steal Stop: toggle (WaveTogglePill_AutoStealStop) or Auto Steal toggle (WaveTogglePill_29) not found, not installed")
			return nil
		end

		local HIT_PAUSE = 1.3
		local MEDUSA_PAUSE = 3
		local POLL_INTERVAL = 0.025
		local MEDUSA_PART_COUNT = 3

		local token = 0 -- bumped to invalidate the pending resume timer
		local pauseUntil = 0
		local lastRagdoll, lastMedusa = false, false
		local pollAcc = 0
		local charConns = {}
		local heartbeatConn, charAddedConn, pillConn

		local function enabled()
			return pillOn(pill) and pillOn(autoPill)
		end

		local function getCharHum()
			local char = LocalPlayer.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			return char, hum
		end

		local function isMedusa()
			if _G.dropActive or _G.IsDropping then return false end
			local char, hum = getCharHum()
			if not hum or hum.Health <= 0 then return false end
			local count = 0
			for _, child in ipairs(char:GetChildren()) do
				if child:IsA("BasePart") and child.Anchored and child.Transparency == 1 then
					count += 1
					if count >= MEDUSA_PART_COUNT then return true end
				end
			end
			return false
		end

		local function isRagdolled()
			local char, hum = getCharHum()
			if not hum or hum.Health <= 0 then return false end
			local endTime = LocalPlayer:GetAttribute("RagdollEndTime")
				or char:GetAttribute("RagdollEndTime")
				or hum:GetAttribute("RagdollEndTime")
			if type(endTime) == "number" and endTime > workspace:GetServerTimeNow() then return true end
			for _, holder in ipairs({ LocalPlayer, char, hum }) do
				if holder:GetAttribute("Ragdolled") == true or holder:GetAttribute("Ragdoll") == true then
					return true
				end
			end
			local st = hum:GetState()
			return hum.PlatformStand
				or st == Enum.HumanoidStateType.Physics
				or st == Enum.HumanoidStateType.Ragdoll
				or st == Enum.HumanoidStateType.FallingDown
		end

		local function endPause()
			token += 1
			pauseUntil = 0
			_G._WindStealHitPaused = false
		end

		local function trigger()
			if not enabled() then return end
			local medusa = isMedusa()
			if medusa then
				if lastMedusa then return end
				lastMedusa = true
			elseif os.clock() < pauseUntil then
				return
			end
			token += 1
			local myToken = token
			local pause = medusa and MEDUSA_PAUSE or HIT_PAUSE
			pauseUntil = os.clock() + pause
			-- flag first: stealHooks.stop leaves the engine loop running and it would start a new steal right away
			_G._WindStealHitPaused = true
			if type(stealHooks.stop) == "function" then pcall(stealHooks.stop) end
			task.delay(pause, function()
				if myToken ~= token then return end
				pauseUntil = 0
				_G._WindStealHitPaused = false
			end)
		end

		local function clearCharConns()
			for i = #charConns, 1, -1 do
				local c = charConns[i]
				charConns[i] = nil
				pcall(function() c:Disconnect() end)
			end
		end

		local function track(c)
			charConns[#charConns + 1] = c
		end

		local function bindCharacter(char)
			clearCharConns()
			if not char then return end
			local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
			if not hum or LocalPlayer.Character ~= char then return end

			track(hum.StateChanged:Connect(function(_, new)
				if new == Enum.HumanoidStateType.Physics
					or new == Enum.HumanoidStateType.Ragdoll
					or new == Enum.HumanoidStateType.FallingDown then
					trigger()
				end
			end))
			track(hum:GetPropertyChangedSignal("PlatformStand"):Connect(function()
				if hum.PlatformStand then trigger() end
			end))
			local lastHealth = hum.Health
			track(hum.HealthChanged:Connect(function(h)
				if h < lastHealth then trigger() end
				lastHealth = h
			end))
			for _, holder in ipairs({ LocalPlayer, char, hum }) do
				for _, name in ipairs({ "RagdollEndTime", "Ragdolled", "Ragdoll" }) do
					track(holder:GetAttributeChangedSignal(name):Connect(function()
						if isRagdolled() then trigger() end
					end))
				end
			end
			local function watchPart(child)
				if not child:IsA("BasePart") or child.Parent ~= char then return end
				local function check()
					if isMedusa() then trigger() end
				end
				track(child:GetPropertyChangedSignal("Anchored"):Connect(check))
				track(child:GetPropertyChangedSignal("Transparency"):Connect(check))
			end
			for _, child in ipairs(char:GetChildren()) do watchPart(child) end
			track(char.ChildAdded:Connect(watchPart))
		end

		-- polling backup, every 0.025 s (as in Vx7): catches ragdoll / Medusa that the signals above miss
		heartbeatConn = RunService.Heartbeat:Connect(function(dt)
			if not enabled() then
				lastRagdoll, lastMedusa = false, false
				return
			end
			pollAcc += dt
			if pollAcc < POLL_INTERVAL then return end
			pollAcc = 0
			local ragdolled = isRagdolled()
			if isMedusa() then
				trigger()
			else
				lastMedusa = false
				if ragdolled and not lastRagdoll then trigger() end
			end
			lastRagdoll = ragdolled
		end)

		charAddedConn = LocalPlayer.CharacterAdded:Connect(function(char)
			lastRagdoll, lastMedusa = false, false
			endPause()
			task.delay(0.1, bindCharacter, char)
		end)
		if LocalPlayer.Character then
			task.defer(bindCharacter, LocalPlayer.Character)
		end

		pillConn = pill:GetAttributeChangedSignal("WaveToggleOn"):Connect(function()
			if not pillOn(pill) then
				lastRagdoll, lastMedusa = false, false
				if _G._WindStealHitPaused then endPause() end -- toggle off ends a running pause at once
			end
		end)

		local api = {}
		api.IsPaused = function() return _G._WindStealHitPaused == true end
		api.Destroy = function()
			endPause()
			clearCharConns()
			if heartbeatConn then heartbeatConn:Disconnect() heartbeatConn = nil end
			if charAddedConn then charAddedConn:Disconnect() charAddedConn = nil end
			if pillConn then pillConn:Disconnect() pillConn = nil end
		end
		return api
	end

	local okInstall, api = pcall(install)
	if okInstall and api then
		_G.__WindAutoStealStop = api
	elseif not okInstall then
		warn("[WIND] Auto Steal Stop install failed: " .. tostring(api))
	end
end

-- ==========================================================================
-- ADDED: ANTI DIE (ported from AkatsukiHub "Anti Die")
--   Control: "Anti Die" toggle (WaveTogglePill_AntiDie, Combat page, COUNTERS section under "Medusa Counter").
--   What it does (same as the Akatsuki code, only names rewritten):
--     while ON, for your Character's Humanoid: BreakJointsOnDeath = false, the Dead state is disabled,
--     and whenever Health drops to 0 (Health signal, Died signal, and a per-frame check) it is set back to MaxHealth.
--     Respawn: the new Character is picked up 0.2 s after CharacterAdded.
--     Turning it OFF restores BreakJointsOnDeath = true and re-enables the Dead state.
--   Not ported: Akatsuki's Bat Aimbot also switches Anti Die on/off by itself ("autobat" source); Wind has no such link.
--   This changes the Humanoid on YOUR client. Whether the server also keeps you alive depends on the game: NOT verified.
--   Config: the toggle key starts with "WaveTogglePill", so autosave / Save Config / Load / Reset include it.
-- ==========================================================================
do
	if _G.__WindAntiDie and _G.__WindAntiDie.Destroy then
		pcall(_G.__WindAntiDie.Destroy) -- re-execute: drop the previous instance
	end

	local function install()
		local pill = G.WaveTogglePill_AntiDie
		if typeof(pill) ~= "Instance" then
			warn("[WIND] Anti Die: toggle (WaveTogglePill_AntiDie) not found, not installed")
			return nil
		end

		local enabledNow = false
		local tracked = {} -- [Character] = { humanoid, healthConn, diedConn, cleanupConn }
		local charAddedConn, heartbeatConn, pillConn

		local function untrack(char, restore)
			local entry = tracked[char]
			if entry then
				for _, key in ipairs({ "healthConn", "diedConn", "cleanupConn" }) do
					local c = entry[key]
					if c then pcall(function() c:Disconnect() end) end
				end
				tracked[char] = nil
			end
			if restore and char and char.Parent then
				pcall(function()
					local hum = char:FindFirstChildOfClass("Humanoid")
					if hum then
						hum.BreakJointsOnDeath = true
						hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
					end
				end)
			end
		end

		local function track(char)
			if not char or not char.Parent then return end
			local hum = char:FindFirstChildOfClass("Humanoid")
			if not hum then return end
			untrack(char, false)
			hum.BreakJointsOnDeath = false
			hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
			local entry
			entry = {
				humanoid = hum,
				healthConn = hum:GetPropertyChangedSignal("Health"):Connect(function()
					if enabledNow and tracked[char] == entry and hum.Health <= 0 then
						hum.Health = hum.MaxHealth
					end
				end),
				diedConn = hum.Died:Connect(function()
					task.defer(function()
						if enabledNow and tracked[char] == entry and hum.Parent then
							hum.BreakJointsOnDeath = false
							hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
							hum.Health = hum.MaxHealth
						end
					end)
				end),
				cleanupConn = char.AncestryChanged:Connect(function()
					if not char.Parent then untrack(char, false) end
				end),
			}
			tracked[char] = entry
		end

		local function setEnabled(on)
			on = on == true
			if on == enabledNow then return end
			enabledNow = on
			if on then
				if not charAddedConn then
					charAddedConn = LocalPlayer.CharacterAdded:Connect(function(char)
						task.wait(0.2)
						if enabledNow and char and char.Parent then track(char) end
					end)
				end
				local char = LocalPlayer.Character
				if char and char.Parent and not tracked[char] then track(char) end
			else
				if charAddedConn then charAddedConn:Disconnect() charAddedConn = nil end
				for char in pairs(tracked) do untrack(char, true) end
			end
		end

		-- per-frame backup (as in Akatsuki): re-binds to a replaced Humanoid and keeps the three properties pinned
		heartbeatConn = RunService.Heartbeat:Connect(function()
			if not enabledNow then return end
			local char = LocalPlayer.Character
			local hum = char and char.Parent and char:FindFirstChildOfClass("Humanoid")
			if not hum then return end
			local entry = tracked[char]
			if not entry or entry.humanoid ~= hum then track(char) end
			if hum.BreakJointsOnDeath then hum.BreakJointsOnDeath = false end
			if hum:GetStateEnabled(Enum.HumanoidStateType.Dead) then
				hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
			end
			if hum.Health <= 0 then hum.Health = hum.MaxHealth end
		end)

		pillConn = pill:GetAttributeChangedSignal("WaveToggleOn"):Connect(function()
			setEnabled(pillOn(pill))
		end)

		local api = {}
		api.IsEnabled = function() return enabledNow end
		api.Destroy = function()
			setEnabled(false)
			if heartbeatConn then heartbeatConn:Disconnect() heartbeatConn = nil end
			if pillConn then pillConn:Disconnect() pillConn = nil end
		end

		setEnabled(pillOn(pill)) -- the toggle may already be ON (the saved config is applied further down)
		return api
	end

	local okInstall, api = pcall(install)
	if okInstall and api then
		_G.__WindAntiDie = api
	elseif not okInstall then
		warn("[WIND] Anti Die install failed: " .. tostring(api))
	end
end

-- ==========================================================================
-- ADDED: HEAD LABEL (plain red text above YOUR head: speed on top, ".gg/windhub" below)
--   Speed: shows the speed that is SET, not a measured one. Normal mode -> the Normal Speed box value,
--     Carry mode -> the Carry Speed box value; Lagger Normal / Lagger Carry modes and Auto Carry (while the
--     "Stealing" attribute is set) show their own box values, exactly as the speed engine picks them (activeSpeed).
--   Anchor: the label follows HumanoidRootPart, not the Head, because the head bobs with the run animation.
--     OFFSET_Y is measured from the root (the head is about 1.5 studs above it).
--   HEAD.SCALE resizes the whole label (size, text, outline) by scaling every number in the build code.
--   It is a client-side BillboardGui: only YOU see it. No toggle and nothing saved in the config.
-- ==========================================================================
do
	for _, key in ipairs({ "__WindHeadLabel", "__SovynHeadLabel" }) do -- the second key is from the pre-rename build
		local old = _G[key]
		if old and old.Destroy then
			pcall(old.Destroy) -- re-execute: drop the previous label
		end
	end

	local HEAD = {
		WIDTH = 200,
		HEIGHT = 60,
		SCALE = 0.4,    -- scales the whole label: size, text and outline together (was 0.55)
		OFFSET_Y = 4.7, -- studs above HumanoidRootPart (about 3.2 above the head)
		TEXT = ".gg/windhub",
		SPEED_TEXT_SIZE = 34,
		NAME_TEXT_SIZE = 18,
		SPEED_SPLIT = 0.62, -- share of the height used by the speed line
		SPEED_UPDATE_SECONDS = 0.1,
		COLOR_SPEED = Color3.fromRGB(235, 30, 52),
		COLOR_NAME = Color3.fromRGB(205, 26, 46),
		COLOR_OUTLINE = Color3.fromRGB(20, 0, 4),
		COLOR_SHINE = Color3.fromRGB(255, 214, 219), -- the bright band that sweeps across the text
		SHINE_SECONDS = 3.0, -- one sweep (was 1.1, too fast)
		SHINE_PAUSE = 2.5,   -- rest (band hidden left of the text) before the next round
		SHINE_HOLD = 1.0,    -- the band stays on the last letters this long before it goes back
		SHINE_HIDDEN = -1,   -- gradient offset with the band off the left side of the text
		SHINE_END = 0.4,     -- gradient offset with the band on the last letters
	}

	local function install()
		local font = G.SpicyFont

		-- every size below is written for scale 1 and multiplied here, so the whole label scales together
		local function S(n) return n * HEAD.SCALE end
		local function ST(n) return math.max(1, math.floor(n * HEAD.SCALE + 0.5)) end -- TextSize is a whole number

		local gui = Instance.new("BillboardGui")
		gui.Name = "WindHeadLabel"
		gui.ResetOnSpawn = false
		gui.AlwaysOnTop = true
		gui.LightInfluence = 0
		gui.MaxDistance = math.huge
		gui.Size = UDim2.fromOffset(S(HEAD.WIDTH), S(HEAD.HEIGHT))
		gui.ClipsDescendants = false
		gui.StudsOffset = Vector3.new(0, HEAD.OFFSET_Y, 0)

		local gradients = {} -- one shine gradient per text line

		local function makeLine(name, text, color, maxSize, pos, size)
			local t = Instance.new("TextLabel")
			t.Name = name
			t.BackgroundTransparency = 1
			t.FontFace = font
			t.Text = text
			t.TextColor3 = Color3.fromRGB(255, 255, 255) -- the gradient below carries the real colour
			t.TextScaled = true
			t.TextXAlignment = Enum.TextXAlignment.Center
			t.TextYAlignment = Enum.TextYAlignment.Center
			t.Position = pos
			t.Size = size
			t.ZIndex = 5
			t.Parent = gui

			local limit = Instance.new("UITextSizeConstraint")
			limit.MaxTextSize = ST(maxSize)
			limit.MinTextSize = 1
			limit.Parent = t

			local outline = Instance.new("UIStroke")
			outline.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
			outline.Color = HEAD.COLOR_OUTLINE
			outline.Thickness = math.max(1, S(1.5))
			outline.Parent = t

			local grad = Instance.new("UIGradient")
			grad.Rotation = 20
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, color),
				ColorSequenceKeypoint.new(0.4, color),
				ColorSequenceKeypoint.new(0.5, HEAD.COLOR_SHINE),
				ColorSequenceKeypoint.new(0.6, color),
				ColorSequenceKeypoint.new(1, color),
			})
			grad.Offset = Vector2.new(-1, 0)
			grad.Parent = t
			table.insert(gradients, grad)
			return t
		end

		local speedValue = makeLine("Speed", "0.0", HEAD.COLOR_SPEED, HEAD.SPEED_TEXT_SIZE,
			UDim2.fromScale(0, 0), UDim2.fromScale(1, HEAD.SPEED_SPLIT))
		makeLine("Name", HEAD.TEXT, HEAD.COLOR_NAME, HEAD.NAME_TEXT_SIZE,
			UDim2.fromScale(0, HEAD.SPEED_SPLIT), UDim2.fromScale(1, 1 - HEAD.SPEED_SPLIT))

		-- remove labels left behind by earlier runs or by the pre-rename build (they would draw on top of this one)
		local playerGui = LocalPlayer:WaitForChild("PlayerGui", 10)
		if playerGui then
			for _, child in ipairs(playerGui:GetChildren()) do
				if child:IsA("BillboardGui") and (child.Name == "WindHeadLabel" or child.Name == "SovynHeadLabel") then
					child:Destroy()
				end
			end
		end

		local okParent = pcall(function() gui.Parent = playerGui end)
		if not okParent or not gui.Parent then
			gui:Destroy()
			warn("[WIND] Head label: PlayerGui not available, label not created")
			return nil
		end

		print(string.format("[WIND] Head label ready: %dx%d px, scale %.2f", math.floor(S(HEAD.WIDTH)), math.floor(S(HEAD.HEIGHT)), HEAD.SCALE))

		-- ---------- follow the character ----------
		local alive = true
		local conns = {}

		local function attach(char)
			if not char then
				gui.Adornee = nil
				return
			end
			local anchor = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 10)
			if alive and anchor and anchor:IsDescendantOf(workspace) then
				gui.Adornee = anchor
			end
		end

		table.insert(conns, LocalPlayer.CharacterAdded:Connect(attach))
		table.insert(conns, LocalPlayer.CharacterRemoving:Connect(function() attach(nil) end))
		if LocalPlayer.Character then task.spawn(attach, LocalPlayer.Character) end

		-- ---------- shine: left to right, holds on the end of the text, then back to the left ----------
		task.spawn(function()
			local info = TweenInfo.new(HEAD.SHINE_SECONDS, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			local function sweepTo(offsetX)
				for _, g in ipairs(gradients) do
					TweenService:Create(g, info, { Offset = Vector2.new(offsetX, 0) }):Play()
				end
				task.wait(HEAD.SHINE_SECONDS)
			end
			for _, g in ipairs(gradients) do
				g.Offset = Vector2.new(HEAD.SHINE_HIDDEN, 0)
			end
			while alive do
				sweepTo(HEAD.SHINE_END)
				if not alive then break end
				task.wait(HEAD.SHINE_HOLD)
				if not alive then break end
				sweepTo(HEAD.SHINE_HIDDEN)
				if not alive then break end
				task.wait(HEAD.SHINE_PAUSE)
			end
		end)

		-- ---------- speed meter (shows the SET speed) ----------
		task.spawn(function()
			while alive do
				local getter = speedCtl.getActiveSpeed
				local text = "--"
				if type(getter) == "function" then
					local ok, value = pcall(getter)
					if ok and type(value) == "number" and value == value then
						text = string.format("%.1f", value)
					end
				end
				speedValue.Text = text
				task.wait(HEAD.SPEED_UPDATE_SECONDS)
			end
		end)

		return {
			Destroy = function()
				alive = false
				for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
				table.clear(conns)
				gui:Destroy()
			end,
		}
	end

	local okInstall, api = pcall(install)
	if okInstall and api then
		_G.__WindHeadLabel = api
	elseif not okInstall then
		warn("[WIND] Head label install failed: " .. tostring(api))
	end
end

-- ==========================================================================
-- ADDED: RAGDOLL TIMER / ENEMY RAGDOLL TIMER / BODY LOCK  (ported from Vx7)
--   Ragdoll Timer       -> toggle WaveTogglePill_6. Billboard above YOU with the ragdoll countdown, then "READY!".
--   Enemy Ragdoll Timer -> toggle WaveTogglePill_8. Overlay above every other player who gets ragdolled
--                          (2.5s countdown) or medusa-stoned (3.5s), then "STEAL!" while they stay down.
--   Body Lock           -> toggle WaveTogglePill_9 + range box TextBox_7. Turns your character toward the
--                          nearest other player inside the range (Vx7 silentBatAim: RotVelocity, turn speed 30).
--   Config: Wind's generic saver already stores every WaveTogglePill and TextBox of G, so these three toggles
--           and the Body Lock range go into "Save Config" and the "_autosave" file with no extra code. On load
--           the saver flips the pill, which fires the listeners below and starts the feature.
--   Vx7 differences (on purpose):
--     * Body Lock uses ONE mode: nearest player within the Range box. Vx7 had "Body Perm" (any player, no range)
--       and "Body Radio" (range-limited, first match in list order); Wind has only a Range box.
--     * Body Lock pauses while the bat aimbot or Auto Left/Right drives the character (_G.__WindAimbotDriving,
--       _G.__WindAutoLRDriving), same idea as luckbroom suppressing it. Clicking Body Lock ON switches the
--       bat aimbot off, as Vx7 does.
--     * Vx7 theme colours replaced by its fallback accents (red / purple for medusa).
-- ==========================================================================
do
	local ACCENT = Color3.fromRGB(232, 69, 79)
	local ACCENT_MEDUSA = Color3.fromRGB(184, 105, 255)
	local OWN_DEFAULT_TIME = 2.5
	local ENEMY_RAGDOLL_TIME = 2.5
	local ENEMY_MEDUSA_TIME = 3.5
	local BODY_LOCK_TURN_SPEED = 30
	local BODY_LOCK_DEFAULT_RANGE = 50
	local OWN_TIMER_SCALE = 0.6   -- size of the "Ragdoll Timer" billboard above you (1 = the old size)
	local ENEMY_TIMER_SCALE = 0.6 -- size of the "Enemy Ragdoll Timer" boxes (1 = the old size)

	local pillRagdoll = G.WaveTogglePill_6
	local pillEnemy = G.WaveTogglePill_8
	local pillBody = G.WaveTogglePill_9
	local rangeBox = G.TextBox_7

	local function isFinite(n)
		return type(n) == "number" and n == n and math.abs(n) ~= math.huge
	end

	local function isDownState(state)
		return state == Enum.HumanoidStateType.Physics
			or state == Enum.HumanoidStateType.Ragdoll
			or state == Enum.HumanoidStateType.FallingDown
	end

	local function readRagdollEndTime(player, char, hum)
		local t = player:GetAttribute("RagdollEndTime")
		if t == nil then t = char:GetAttribute("RagdollEndTime") end
		if t == nil then t = hum:GetAttribute("RagdollEndTime") end
		return t
	end

	-- Vx7 fn7: medusa stone = at least 3 anchored, fully transparent parts in the character
	local function isMedusaStoned(char)
		if not char then return false end
		local count = 0
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") and d.Anchored and d.Transparency == 1 then
				count += 1
				if count >= 3 then return true end
			end
		end
		return false
	end

	-- ---------------------------------------------------------------- Ragdoll Timer (you)
	local own = { conn = nil, charConn = nil, gui = nil, token = 0 }

	local function ownClear()
		own.token += 1
		if own.gui then
			local g = own.gui
			own.gui = nil
			pcall(function() g:Destroy() end)
		end
	end

	local function ownShow(duration)
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
		if not root or not playerGui then return end
		own.token += 1
		local token = own.token
		local old = playerGui:FindFirstChild("RagCountdownBillboard")
		if old then old:Destroy() end

		local gui = Instance.new("BillboardGui")
		gui.Name = "RagCountdownBillboard"
		gui.Adornee = root
		gui.Size = UDim2.new(0, 84 * OWN_TIMER_SCALE, 0, 42 * OWN_TIMER_SCALE)
		gui.StudsOffset = Vector3.new(0, 2.5, 0)
		gui.AlwaysOnTop = true
		gui.Parent = playerGui
		own.gui = gui

		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = ACCENT
		label.TextStrokeColor3 = Color3.new(0, 0, 0)
		label.TextStrokeTransparency = 0
		label.Parent = gui

		task.spawn(function()
			local remaining = tonumber(duration) or OWN_DEFAULT_TIME
			while own.token == token and gui.Parent and remaining > 0 do
				label.Text = string.format("%.1f", math.max(remaining, 0))
				task.wait(0.1)
				remaining -= 0.1
			end
			if remaining <= 0 and own.token == token and gui.Parent then
				label.Text = "READY!"
				task.wait(0.5)
			end
			if own.token == token then
				if gui.Parent then gui:Destroy() end
				if own.gui == gui then own.gui = nil end
			end
		end)
	end

	-- returns isRagdolled, secondsLeft (nil when the game gives no end time)
	local function ownIsRagdolled(char, hum)
		local state = hum:GetState()
		if state == Enum.HumanoidStateType.Physics or state == Enum.HumanoidStateType.Ragdoll then
			return true, nil
		end
		if hum.PlatformStand then return true, nil end
		local now = workspace:GetServerTimeNow()
		local endTime = readRagdollEndTime(LocalPlayer, char, hum)
		if type(endTime) == "number" and endTime > now then
			return true, endTime - now
		end
		if state == Enum.HumanoidStateType.FallingDown then return true, nil end
		return false, nil
	end

	local function ownStop()
		if own.conn then own.conn:Disconnect() own.conn = nil end
		if own.charConn then own.charConn:Disconnect() own.charConn = nil end
		ownClear()
	end

	local function ownStart()
		ownStop()
		local acc, wasRagdolled, lastChar = 0, false, nil
		own.conn = RunService.Heartbeat:Connect(function(dt)
			acc += dt or (1 / 60)
			if acc < 0.05 then return end
			acc = 0
			pcall(function()
				local char = LocalPlayer.Character
				if not char then return end
				if char ~= lastChar then lastChar, wasRagdolled = char, false end
				local hum = char:FindFirstChildOfClass("Humanoid")
				if not hum or hum.Health <= 0 then return end
				local ragdolled, secondsLeft = ownIsRagdolled(char, hum)
				if ragdolled and not wasRagdolled then ownShow(secondsLeft) end
				wasRagdolled = ragdolled
			end)
		end)
		own.charConn = LocalPlayer.CharacterAdded:Connect(function()
			task.wait(0.5)
			wasRagdolled = false
			lastChar = LocalPlayer.Character
		end)
	end

	-- ---------------------------------------------------------------- Enemy Ragdoll Timer
	local enemy = { conn = nil, remConn = nil, records = {}, guis = {} }

	local function enemyClearOne(player)
		local entry = enemy.guis[player]
		if not entry then return end
		entry.token += 1
		if entry.positionConn then entry.positionConn:Disconnect() entry.positionConn = nil end
		if entry.gui then
			local g = entry.gui
			pcall(function() g:Destroy() end)
		end
		enemy.guis[player] = nil
	end

	local function enemyClearAll()
		local list = {}
		for player in pairs(enemy.guis) do list[#list + 1] = player end
		for _, player in ipairs(list) do enemyClearOne(player) end
		table.clear(enemy.records)
	end

	local function enemyStillDown(player, char, hum, kind)
		if kind == "medusa" then return isMedusaStoned(char) end
		if isDownState(hum:GetState()) then return true end
		local endTime = readRagdollEndTime(player, char, hum)
		return type(endTime) == "number" and endTime > workspace:GetServerTimeNow()
	end

	local function enemyShow(player, char, duration, kind)
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
		if not root or not playerGui then return end
		duration = tonumber(duration) or ENEMY_RAGDOLL_TIME
		kind = kind == "medusa" and "medusa" or "ragdoll"
		enemyClearOne(player)

		local name = "EnemyRagCountdown_" .. tostring(player.UserId)
		local old = playerGui:FindFirstChild(name)
		if old then old:Destroy() end
		local color = kind == "medusa" and ACCENT_MEDUSA or ACCENT

		local screenGui = Instance.new("ScreenGui")
		screenGui.Name = name
		screenGui.ResetOnSpawn = false
		screenGui.IgnoreGuiInset = true
		screenGui.DisplayOrder = 2147483647
		screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
		screenGui.Parent = playerGui

		local overlay = Instance.new("Frame")
		overlay.Name = "EnemyRagdollOverlay"
		overlay.Size = UDim2.fromOffset(104, 50)
		overlay.AnchorPoint = Vector2.new(0.5, 0.5)
		overlay.BackgroundTransparency = 1
		overlay.BorderSizePixel = 0
		overlay.Visible = false
		overlay.ZIndex = 1000
		overlay.Parent = screenGui

		local uiScale = Instance.new("UIScale") -- shrinks the whole box (size, text, stroke) around its centre
		uiScale.Scale = ENEMY_TIMER_SCALE
		uiScale.Parent = overlay

		local box = Instance.new("Frame")
		box.Size = UDim2.new(1, -8, 1, -8)
		box.Position = UDim2.fromOffset(4, 4)
		box.BackgroundColor3 = Color3.fromRGB(12, 13, 17)
		box.BackgroundTransparency = 0.16
		box.BorderSizePixel = 0
		box.ZIndex = 1001
		box.Parent = overlay
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 11)
		corner.Parent = box
		local stroke = Instance.new("UIStroke")
		stroke.Color = color
		stroke.Transparency = 0.18
		stroke.Thickness = 1.2
		stroke.Parent = box

		local title = Instance.new("TextLabel")
		title.Size = UDim2.new(1, 0, 0, 14)
		title.Position = UDim2.fromOffset(0, 3)
		title.BackgroundTransparency = 1
		title.Text = kind == "medusa" and "MEDUSA" or "RAGDOLL"
		title.Font = Enum.Font.GothamBold
		title.TextSize = 7
		title.TextColor3 = color
		title.TextStrokeTransparency = 1
		title.ZIndex = 1002
		title.Parent = box

		local value = Instance.new("TextLabel")
		value.Size = UDim2.new(1, -8, 0, 25)
		value.Position = UDim2.fromOffset(4, 14)
		value.BackgroundTransparency = 1
		value.Font = Enum.Font.GothamBlack
		value.TextSize = 19
		value.TextColor3 = color
		value.TextStrokeColor3 = Color3.new(0, 0, 0)
		value.TextStrokeTransparency = 0.38
		value.ZIndex = 1002
		value.Parent = box

		local entry = { gui = screenGui, token = 1, effectType = kind }
		enemy.guis[player] = entry
		local token = entry.token

		local posAcc = 0
		entry.positionConn = RunService.RenderStepped:Connect(function(dt)
			posAcc += dt or (1 / 60)
			if posAcc < 0.05 then return end
			posAcc = 0
			if not root.Parent or not overlay.Parent then
				overlay.Visible = false
				return
			end
			local cam = workspace.CurrentCamera
			if not cam then
				overlay.Visible = false
				return
			end
			local pos, onScreen = cam:WorldToViewportPoint(root.Position + Vector3.new(0, 1.85, 0))
			overlay.Visible = onScreen and pos.Z > 0
			if overlay.Visible then
				overlay.Position = UDim2.fromOffset(pos.X, pos.Y)
			end
		end)

		local function alive()
			return pillOn(pillEnemy) and enemy.guis[player] == entry and entry.token == token and screenGui.Parent ~= nil
		end

		task.spawn(function()
			local remaining = duration
			while alive() and remaining > 0 do
				value.Text = string.format("%.1f", math.max(remaining, 0))
				task.wait(0.1)
				remaining -= 0.1
			end
			if alive() then
				value.Text = "STEAL!"
				while alive() do
					task.wait(0.1)
					local currentChar = player.Character
					local hum = currentChar and currentChar:FindFirstChildOfClass("Humanoid")
					if not hum or hum.Health <= 0 or currentChar ~= char then break end
					local down = enemyStillDown(player, currentChar, hum, kind)
					if kind == "medusa" then entry.stoned = down else entry.ragdolled = down end
					if not down then break end
				end
			end
			if enemy.guis[player] == entry and entry.token == token then
				if entry.positionConn then entry.positionConn:Disconnect() entry.positionConn = nil end
				if screenGui.Parent then screenGui:Destroy() end
				enemy.guis[player] = nil
			end
		end)
	end

	local function enemyIsRagdolled(player, char, hum)
		if isDownState(hum:GetState()) then return true end
		local endTime = readRagdollEndTime(player, char, hum)
		return type(endTime) == "number" and endTime > workspace:GetServerTimeNow()
	end

	local function enemyStop()
		if enemy.conn then enemy.conn:Disconnect() enemy.conn = nil end
		if enemy.remConn then enemy.remConn:Disconnect() enemy.remConn = nil end
		enemyClearAll()
	end

	local function enemyStart()
		enemyStop()
		local acc = 0
		enemy.conn = RunService.Heartbeat:Connect(function(dt)
			acc += dt or (1 / 60)
			if acc < 0.05 then return end
			acc = 0
			pcall(function()
				local seen = {}
				for _, player in ipairs(Players:GetPlayers()) do
					if player ~= LocalPlayer then
						seen[player] = true
						local char = player.Character
						local hum = char and char:FindFirstChildOfClass("Humanoid")
						local rec = enemy.records[player]
						if not rec or rec.character ~= char then
							rec = { character = char, ragdolled = false, stoned = false }
							enemy.records[player] = rec
							enemyClearOne(player)
						end
						if hum and hum.Health > 0 then
							local ragdolled = enemyIsRagdolled(player, char, hum)
							local stoned = isMedusaStoned(char)
							if stoned and not rec.stoned then
								enemyShow(player, char, ENEMY_MEDUSA_TIME, "medusa")
							elseif ragdolled and not rec.ragdolled and not stoned then
								local active = enemy.guis[player]
								if not active or active.effectType ~= "medusa" then
									enemyShow(player, char, ENEMY_RAGDOLL_TIME, "ragdoll")
								end
							end
							rec.stoned = stoned
							rec.ragdolled = ragdolled
						else
							rec.ragdolled = false
							rec.stoned = false
							enemyClearOne(player)
						end
					end
				end
				for player in pairs(enemy.records) do
					if not seen[player] then
						enemy.records[player] = nil
						enemyClearOne(player)
					end
				end
			end)
		end)
		enemy.remConn = Players.PlayerRemoving:Connect(function(player)
			enemy.records[player] = nil
			enemyClearOne(player)
		end)
	end

	-- ---------------------------------------------------------------- Body Lock
	local lock = { conn = nil, touched = false }

	local function bodyLockRange()
		local n = rangeBox and tonumber(rangeBox.Text)
		if not isFinite(n) or n <= 0 then return BODY_LOCK_DEFAULT_RANGE end
		return math.min(n, 2000)
	end

	local function bodyLockTarget(root)
		local best, bestDist = nil, bodyLockRange()
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				local char = player.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				local targetRoot = char and char:FindFirstChild("HumanoidRootPart")
				if hum and targetRoot and hum.Health > 0 then
					local dist = (root.Position - targetRoot.Position).Magnitude
					if dist <= bestDist then
						best, bestDist = targetRoot, dist
					end
				end
			end
		end
		return best
	end

	local function bodyLockRelease()
		if not lock.touched then return end
		lock.touched = false
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if root then root.RotVelocity = Vector3.new(0, 0, 0) end
		if hum then hum.AutoRotate = true end
	end

	local function bodyLockStop()
		if lock.conn then lock.conn:Disconnect() lock.conn = nil end
		bodyLockRelease()
	end

	local function bodyLockStart()
		bodyLockStop()
		lock.conn = RunService.Heartbeat:Connect(function()
			pcall(function()
				if _G.__WindAimbotDriving == true or _G.__WindAutoLRDriving == true or _G.__WindBatTpDriving == true then
					bodyLockRelease()
					return
				end
				local char = LocalPlayer.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if not root or not hum or hum.Health <= 0 then
					lock.touched = false
					return
				end
				local target = bodyLockTarget(root)
				if not target then
					bodyLockRelease()
					return
				end
				hum.AutoRotate = false
				lock.touched = true
				local look = root.CFrame.LookVector
				local forward = Vector3.new(look.X, 0, look.Z)
				local delta = target.Position - root.Position
				local wanted = Vector3.new(delta.X, 0, delta.Z)
				if forward.Magnitude > 0.001 and wanted.Magnitude > 0.001 then
					forward, wanted = forward.Unit, wanted.Unit
					local angle = math.acos(math.clamp(forward:Dot(wanted), -1, 1))
					local cross = forward:Cross(wanted)
					root.RotVelocity = Vector3.new(0, cross.Y * angle * BODY_LOCK_TURN_SPEED, 0)
				end
			end)
		end)
	end

	-- ---------------------------------------------------------------- wiring
	if _G.__WindRagBodyLock and _G.__WindRagBodyLock.Destroy then
		pcall(_G.__WindRagBodyLock.Destroy) -- re-execute: drop the previous instance's loops
	end
	_G.__WindRagBodyLock = {
		Destroy = function()
			ownStop()
			enemyStop()
			bodyLockStop()
		end,
	}

	local function bind(pill, onFn, offFn)
		if not pill then
			warn("[WIND] Ragdoll/Body Lock: toggle pill missing, feature not wired")
			return
		end
		local function apply()
			if pillOn(pill) then onFn() else offFn() end
		end
		pill:GetAttributeChangedSignal("WaveToggleOn"):Connect(apply)
		apply() -- covers a pill that is already on when this block runs
	end

	bind(pillRagdoll, ownStart, ownStop)
	bind(pillEnemy, enemyStart, enemyStop)
	bind(pillBody, bodyLockStart, bodyLockStop)

	-- Vx7: switching Body Lock on turns the bat aimbot off. Only on a real click, so loading a saved config
	-- never flips another toggle behind your back.
	if G.TextButton_22 and G.WaveTogglePill_22 then
		G.TextButton_22.MouseButton1Click:Connect(function()
			task.defer(function()
				if pillOn(pillBody) and pillOn(G.WaveTogglePill_22) then
					setToggleVisual(G.WaveTogglePill_22, false)
				end
			end)
		end)
	end
end

-- ==========================================================================
-- ADDED: KICK WARNING (ported from Vx7 "WARNING E01")  +  UNWALK ROW REMOVED
--   Kick Warning -> toggle WaveTogglePill_7. When you pick up / start carrying something, a billboard over your
--                   head counts "SAFE IN 3.00s" (amber under 1s), then "SAFE TO STEAL" for 1.5s and disappears.
--   NOTE: the string "Kick Warning" does not exist anywhere in Vx7. The only warning feature there is
--         "WARNING E01" (pickup safety countdown), so that is what this row now does. If you meant something else,
--         tell me what the row should warn about.
--   Carry detection is Vx7's own three layers, name filters included (Tool / Model / welded part not named
--   bat, slap, medusa, head, stone; value objects Carrying/IsCarrying/Grabbed/Holding/StealHold/HasGrab;
--   attributes Carrying/IsCarrying/HasBrainrot). Those names are Vx7's guesses for its game; I did not check them
--   against your game.
--   Vx7 difference: no "WARNING E01 Size" box (Wind has no row for it), scale fixed at 1.
--   Config: WaveTogglePill_7 is stored by Wind's generic config saver like every other toggle.
--   Unwalk: the row (Frame_40 / WaveTogglePill_5) had no logic behind it and is removed; the ANIMATIONS header stays.
-- ==========================================================================
do
	local pillKick = G.WaveTogglePill_7

	local WEAPON_WORDS = { "bat", "slap", "medusa", "head", "stone" }
	local CARRY_WORDS = { "brainrot", "animal", "carry", "grab", "steal", "hold" }
	local CHARACTER_PART_NAMES = {
		animate = true, animsaves = true, health = true, rig = true, ["body colors"] = true, bodycolors = true,
		humanoid = true, head = true, torso = true, uppertorso = true, lowertorso = true, humanoidrootpart = true,
	}
	local CARRY_VALUE_NAMES = { "Carrying", "IsCarrying", "Grabbed", "Holding", "StealHold", "HasGrab" }
	local CARRY_ATTRIBUTES = { "Carrying", "IsCarrying", "HasBrainrot" }

	local function nameHasWord(name, words)
		name = tostring(name or ""):lower()
		for _, w in ipairs(words) do
			if name:find(w, 1, true) then return true end
		end
		return false
	end

	local function isCharacterPart(inst) -- Vx7 fn53
		if CHARACTER_PART_NAMES[inst.Name:lower()] or nameHasWord(inst.Name, WEAPON_WORDS) then return true end
		if inst:FindFirstChildOfClass("Humanoid") then return true end
		if inst:FindFirstChildWhichIsA("Accoutrement", true) then return true end
		return false
	end

	-- layer 1: Vx7 isHoldingBrainrot
	local function isHoldingBrainrot()
		local char = LocalPlayer.Character
		if not char then return false end
		for _, child in ipairs(char:GetChildren()) do
			if child:IsA("Tool") and not nameHasWord(child.Name, WEAPON_WORDS) then return true end
		end
		for _, child in ipairs(char:GetChildren()) do
			if child:IsA("Model") and not isCharacterPart(child) and child:FindFirstChildWhichIsA("BasePart") then
				return true
			end
		end
		local hum = char:FindFirstChildOfClass("Humanoid")
		local sitting = hum and (hum.Sit or hum.SeatPart ~= nil)
		local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
		if root and not sitting then
			local ok, parts = pcall(function() return root:GetConnectedParts(true) end)
			if ok and parts then
				for _, part in ipairs(parts) do
					if not part:IsDescendantOf(char) and not part:IsA("Seat") and not part:IsA("VehicleSeat") then
						local tool = part:FindFirstAncestorWhichIsA("Tool")
						if not nameHasWord(tool and tool.Name or part.Name, WEAPON_WORDS) then
							local model = part:FindFirstAncestorOfClass("Model")
							if not (model and Players:GetPlayerFromCharacter(model)) then return true end
						end
					end
				end
			end
		end
		return false
	end

	-- layer 2: Vx7 isCarryingForWarningE01
	local function isCarrying(char)
		if not char then return false end
		local ok, held = pcall(isHoldingBrainrot)
		if ok and held then return true end
		for _, name in ipairs(CARRY_VALUE_NAMES) do
			local v = char:FindFirstChild(name, true)
			if v then
				if v:IsA("BoolValue") and v.Value then return true end
				if v:IsA("ObjectValue") and v.Value then return true end
				if v:IsA("StringValue") and v.Value ~= "" then return true end
			end
		end
		for _, child in ipairs(char:GetChildren()) do
			if child:IsA("Model") and child:FindFirstChildWhichIsA("BasePart", true) then
				if child:FindFirstChildOfClass("Humanoid") and child:FindFirstChild("HumanoidRootPart") then return true end
				if nameHasWord(child.Name, CARRY_WORDS) then return true end
			elseif child:IsA("Tool") and not nameHasWord(child.Name, WEAPON_WORDS) then
				return true
			end
		end
		return false
	end

	local kick = { monitor = nil, respawn = nil, wasCarrying = false, lastTriggered = -math.huge, generation = 0, board = nil, timer = nil }

	local function kickClear()
		kick.generation += 1
		if kick.timer then kick.timer:Disconnect() kick.timer = nil end
		if kick.board then
			local b = kick.board
			kick.board = nil
			pcall(function() b:Destroy() end)
		end
	end

	-- layer 3 lives in the monitor below (attributes), then the billboard
	local function kickShow()
		local char = LocalPlayer.Character
		local head = char and char:FindFirstChild("Head")
		if not head then return end
		kickClear()
		local generation = kick.generation

		local board = Instance.new("BillboardGui")
		board.Name = "VX7_WARNING_E01"
		board.Adornee = head
		board.Size = UDim2.fromOffset(252, 56)
		board.StudsOffset = Vector3.new(0, 4.95, 0)
		board.AlwaysOnTop = true
		board.LightInfluence = 0
		board.MaxDistance = 150
		board.Parent = head
		kick.board = board

		local card = Instance.new("Frame")
		card.Size = UDim2.fromOffset(252, 56)
		card.BackgroundColor3 = Color3.fromRGB(22, 2, 7)
		card.BackgroundTransparency = 0.35
		card.BorderSizePixel = 0
		card.Parent = board
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = card
		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(232, 31, 58)
		stroke.Thickness = 1.15
		stroke.Transparency = 0.28
		stroke.Parent = card

		local title = Instance.new("TextLabel")
		title.Size = UDim2.new(1, 0, 0, 22)
		title.BackgroundTransparency = 1
		title.Text = "WARNING E01"
		title.Font = Enum.Font.GothamBold
		title.TextSize = 13
		title.TextColor3 = Color3.fromRGB(255, 90, 100)
		title.Parent = card

		local status = Instance.new("TextLabel")
		status.Size = UDim2.new(1, 0, 0, 30)
		status.Position = UDim2.fromOffset(0, 23)
		status.BackgroundTransparency = 1
		status.Text = "SAFE IN 3.00s"
		status.Font = Enum.Font.GothamMedium
		status.TextSize = 18
		status.TextColor3 = Color3.fromRGB(255, 100, 110)
		status.Parent = card

		local startedAt = os.clock()
		kick.timer = RunService.RenderStepped:Connect(function()
			if generation ~= kick.generation then return end
			if not board.Parent then
				kickClear()
				return
			end
			local left = math.max(0, 3 - (os.clock() - startedAt))
			if left > 0 then
				status.Text = string.format("SAFE IN %.2fs", left)
				if left < 1 then
					status.TextColor3 = Color3.fromRGB(255, 203, 72)
					stroke.Color = Color3.fromRGB(240, 145, 40)
				end
				return
			end
			kick.timer:Disconnect()
			kick.timer = nil
			status.Text = "SAFE TO STEAL"
			status.TextColor3 = Color3.fromRGB(73, 255, 145)
			stroke.Color = Color3.fromRGB(42, 218, 112)
			task.delay(1.5, function()
				if generation == kick.generation then kickClear() end
			end)
		end)
	end

	local function kickStop()
		if kick.monitor then kick.monitor:Disconnect() kick.monitor = nil end
		if kick.respawn then kick.respawn:Disconnect() kick.respawn = nil end
		kick.wasCarrying = false
		kickClear()
	end

	local function kickStart()
		if kick.monitor then return end
		kick.wasCarrying = false
		kick.lastTriggered = -math.huge
		local acc = 0
		kick.monitor = RunService.Heartbeat:Connect(function(dt)
			acc += dt
			if acc < 0.08 then return end
			acc = 0
			local char = LocalPlayer.Character
			local ok, carrying = pcall(isCarrying, char)
			carrying = ok and carrying == true
			if not carrying and char then
				for _, attr in ipairs(CARRY_ATTRIBUTES) do
					if char:GetAttribute(attr) == true or LocalPlayer:GetAttribute(attr) == true then
						carrying = true
						break
					end
				end
			end
			if carrying and not kick.wasCarrying and os.clock() - kick.lastTriggered > 3.25 then
				kick.lastTriggered = os.clock()
				kickShow()
			end
			kick.wasCarrying = carrying
		end)
		kick.respawn = LocalPlayer.CharacterAdded:Connect(function()
			kick.wasCarrying = false
			kick.lastTriggered = -math.huge
			kickClear()
		end)
	end

	if _G.__WindKickWarning and _G.__WindKickWarning.Destroy then
		pcall(_G.__WindKickWarning.Destroy) -- re-execute: drop the previous instance's loops
	end
	_G.__WindKickWarning = { Destroy = kickStop }

	if pillKick then
		local function apply()
			if pillOn(pillKick) then kickStart() else kickStop() end
		end
		pillKick:GetAttributeChangedSignal("WaveToggleOn"):Connect(apply)
		apply()
	else
		warn("[WIND] Kick Warning: toggle pill missing, feature not wired")
	end

	-- Unwalk row: no logic behind it, remove it (the ANIMATIONS header G.Frame_38 is left alone)
	removeRow(G.Frame_40)
end

