	refreshGallery = function()
		if not gallery then return end
		for _, c in ipairs(gallery.cards) do
			local sel = (skinChoice[c.cat] == c.key)
			c.stroke.Color = sel and C_SEL or C_LINE
			c.stroke.Thickness = sel and 2.2 or 1.3
			c.card.BackgroundTransparency = sel and 0 or 0.1
			c.tag.Visible = sel
			c.card.Visible = (c.cat == galleryCat)
		end
		for cat, t in pairs(gallery.tabs) do
			local on = (cat == galleryCat)
			t.BackgroundColor3 = on and Color3.fromRGB(128, 16, 35) or Color3.fromRGB(48, 8, 15)
			t.TextColor3 = on and Color3.fromRGB(240, 245, 255) or Color3.fromRGB(144, 56, 71)
		end
		if skinChoice[galleryCat] ~= OFF then
			gallery.status.Text = "Custom sound: ON (" .. SOUND_NAME[galleryCat] .. ")"
		else
			gallery.status.Text = "Custom sound: OFF"
		end
	end

