-- ---------- Bat Counter (Akatsuki "Ragdoll Counter") ----------
local batCounterConns = {}
local batRagdolled = false
local BAT_COUNTER_RANGE = 4 -- studs, same as Akatsuki

local function findBat()
	local char = LocalPlayer.Character
	if not char then return nil end
	local held = char:FindFirstChildOfClass("Tool")
	if held and held.Name:lower():find("bat") then
		return held
	end
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if backpack then
		local hum = char:FindFirstChildOfClass("Humanoid")
		for _, tool in ipairs(backpack:GetChildren()) do
			if tool:IsA("Tool") and tool.Name:lower():find("bat") then
				if hum then
					pcall(function() hum:EquipTool(tool) end)
				end
				return char:FindFirstChild(tool.Name) or tool
			end
		end
	end
	return nil
end

local function nearestEnemyRoot(myRoot)
	local bestRoot, bestDist = nil, math.huge
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local r = plr.Character:FindFirstChild("HumanoidRootPart")
			local h = plr.Character:FindFirstChildOfClass("Humanoid")
			if r and h and h.Health > 0 then
				local d = (myRoot.Position - r.Position).Magnitude
				if d < bestDist then
					bestRoot, bestDist = r, d
				end
			end
		end
	end
	return bestRoot, bestDist
end

local function batCounterFire()
	if not pillOn(G.WaveTogglePill_26) then return end
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then return end

	local enemyRoot, dist = nearestEnemyRoot(root)
	if enemyRoot and dist <= BAT_COUNTER_RANGE then
		local look = Vector3.new(enemyRoot.Position.X, root.Position.Y, enemyRoot.Position.Z)
		if (look - root.Position).Magnitude > 0.01 then
			pcall(function()
				hum.AutoRotate = false
				root.CFrame = CFrame.lookAt(root.Position, look)
			end)
		end
	end

	local bat = findBat()
	if bat then
		pcall(function() bat:Activate() end)
		local remote = bat:FindFirstChildWhichIsA("RemoteEvent", true)
		if remote then
			pcall(function() remote:FireServer() end)
		end
	end
	task.defer(function()
		if hum.Parent then hum.AutoRotate = true end
	end)
end

local function detachBatCounter()
	disconnectAll(batCounterConns)
	batRagdolled = false
end

local function attachBatCounter()
	detachBatCounter()
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	table.insert(batCounterConns, hum.StateChanged:Connect(function(_, newState)
		if not pillOn(G.WaveTogglePill_26) then return end
		local hit = newState == Enum.HumanoidStateType.Physics
			or newState == Enum.HumanoidStateType.Ragdoll
			or newState == Enum.HumanoidStateType.FallingDown
		if hit and not batRagdolled then
			batRagdolled = true
			pcall(batCounterFire)
		elseif not hit and batRagdolled then
			batRagdolled = false
		end
	end))

	table.insert(batCounterConns, hum:GetPropertyChangedSignal("PlatformStand"):Connect(function()
		if not pillOn(G.WaveTogglePill_26) then return end
		if hum.PlatformStand and not batRagdolled then
			batRagdolled = true
			pcall(batCounterFire)
		elseif not hum.PlatformStand then
			batRagdolled = false
		end
	end))
end

G.WaveTogglePill_26:GetAttributeChangedSignal("WaveToggleOn"):Connect(function()
	if pillOn(G.WaveTogglePill_26) then attachBatCounter() else detachBatCounter() end
end)

