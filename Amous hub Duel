local function queue()
	local q = {}
	for _, s in ipairs(known) do
		if s.downloaded then table.insert(q, s) end
	end
	return q
end
local playSong
local function step(dir)
	local q = queue()
	if #q == 0 then
		toast("Download a song first")
		return
	end
	local nextSong
	if shuffle and #q > 1 then
		repeat nextSong = q[math.random(#q)] until nextSong ~= current
	else
		local idx = table.find(q, current) or 0
		nextSong = q[((idx - 1 + dir) % #q) + 1]
	end
	if nextSong == current then
		sound.TimePosition = 0
		sound:Play()
	else
		playSong(nextSong)
	end
end
function playSong(s)
	if not s.downloaded then
		toast("Download \"" .. s.title .. "\" first")
		return
	end
	if current == s then
		if sound.IsPlaying then sound:Pause() else sound:Resume() end
	else
		local okAsset, asset = pcall(getcustomasset, s.file)
		if not okAsset or type(asset) ~= "string" or asset == "" then
			s.downloaded = false
			toast("Saved file could not be opened. Download it again.")
			refresh()
			return
		end
		current = s
		sound:Stop()
		sound.SoundId = asset
		sound.TimePosition = 0
		sound:Play()
		playToken += 1
		local myToken = playToken
		task.delay(8, function()
			if not closed and myToken == playToken and current == s and not sound.IsLoaded then
				toast("This file will not load. Download it again.")
			end
		end)
		local at = table.find(history, s)
		if at then table.remove(history, at) end
		table.insert(history, 1, s)
	end
	updateNow()
	refresh()
end
local MIN_AUDIO_BYTES = 1024
local function looksLikeAudio(body)
	return type(body) == "string" and #body >= MIN_AUDIO_BYTES and body:sub(1, 1) ~= "<"
end
local function download(s)
	if s.downloaded or s.downloading then return end
	if not CAN_DOWNLOAD then
		toast("Executor lacks writefile / isfile / getcustomasset")
		return
	end
	s.downloading = true
	s.progress = 0
	local finished = false
	local failure = nil
	task.spawn(function()
		local ok, err = pcall(function()
			local body = game:HttpGet(s.url)
			if not looksLikeAudio(body) then
				error("no audio data received (" .. (type(body) == "string" and #body or 0) .. " bytes)")
			end
			writefile(s.file, body)
		end)
		failure = (not ok) and tostring(err) or nil
		finished = true
	end)
	task.spawn(function()
		local t0 = os.clock()
		while not finished and not closed do
			local p = ((os.clock() - t0) % 1.2) / 1.2
			s.progress = p
			local ref = rowRefs[s]
			if ref and ref.bar.Parent then
				ref.bar.Size = UDim2.fromScale(p, 1)
				ref.pct.Text = "..."
			end
			task.wait(0.03)
		end
		s.downloading = false
		if closed then return end
		if failure then
			warn("[Volt] Download failed for " .. s.title .. ": " .. failure)
			toast("Download failed: " .. s.title)
		else
			s.downloaded = true
			toast("Downloaded: " .. s.title)
		end
		refresh()
	end)
	refresh()
end
