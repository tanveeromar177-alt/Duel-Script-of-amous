			local radius = tonumber(Steal.StealRadius) or 62
			local target = closestPrompt(radius)
			_G._CandyStealTargetPos = target and target.Spawn and target.Spawn.Position or nil
			if target then
				executeNormalV3(target)
			end
		end)
	end

	local function stopAutoSteal()
		Steal.AutoStealEnabled = false
		runToken = runToken + 1
		if autoConn then
			autoConn:Disconnect()
			autoConn = nil
		end
		isStealing = false
		releaseActiveFallback()
		for _, data in pairs(callbackCache) do
			data.Ready = true
		end
	end

	_G._MoneyStartAutoSteal = startAutoSteal
	_G._MoneyStopAutoSteal = stopAutoSteal
	_G.CandyNormalAutoStealStart = startAutoSteal
	_G.CandyNormalAutoStealStop = stopAutoSteal
	_G.CandyNormalAutoStealSetRadius = function(r)
		Steal.StealRadius = tonumber(r) or Steal.StealRadius
	end

	-- bridge Config.autoStealEnabled <-> V3 runner
	task.spawn(function()
		local last = false
		while true do
			task.wait(0.15)
			local on = Config and Config.autoStealEnabled == true
			if on ~= last then
				last = on
				if on then
					startAutoSteal()
				else
					stopAutoSteal()
				end
			end
		end
	end)

	-- keep stealStartTime / isStealing visible for the progress bar below
	_G._VoltStealV3State = function()
		return isStealing, stealStartTime, Steal
	end

	-- destroy old bars
	pcall(function()
		for _, name in ipairs({ "VoltStealBar", "MoveeStealBar", "StealProgressScreenGui", "VoltMoneyStealBar", "VoltAutoGrabBar" }) do
			local a = LP.PlayerGui:FindFirstChild(name)
			if a then a:Destroy() end
			if typeof(CoreGui) == "Instance" then
				local b = CoreGui:FindFirstChild(name)
				if b then b:Destroy() end
			end
		end
		if Config._stealBarRoot then Config._stealBarRoot.Visible = false end
	end)

	local parent = (gethui and gethui()) or LP:WaitForChild("PlayerGui")
	local gui = Instance.new("ScreenGui")
	gui.Name = "VoltAutoGrabBar"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 200
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	pcall(function()
		if syn and syn.protect_gui then syn.protect_gui(gui) end
	end)
	gui.Parent = parent

	local Y = Instance.new("Frame", gui)
	Y.Name = "BarHost"
	Y.AnchorPoint = Vector2.new(0.5, 1)
	Y.Position = UDim2.new(0.5, 0, 1, -14)
	Y.Size = UDim2.new(0, 280, 0, 36)
	Y.BackgroundTransparency = 1
	Y.BorderSizePixel = 0
	Y.ZIndex = 500
	Y.Active = true
	Y.Visible = true
	local ZB = 500

	-- Haze Hub auto-steal bar: 280x36 black panel, full-panel grey progress fill, "FPS . ms" on the left
	local Root = Instance.new("Frame")
	Root.Name = "StealBarRoot"
	Root.Size = UDim2.fromScale(1, 1)
	Root.Position = UDim2.new(0, 0, 0, 0)
	Root.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
	Root.BackgroundTransparency = 0
	Root.BorderSizePixel = 0
	Root.ClipsDescendants = true
	Root.ZIndex = ZB + 50
	Root.Parent = Y
	Instance.new("UICorner", Root).CornerRadius = UDim.new(0, 10)
	-- apply stealBarScale from config
	local outerScale = Instance.new("UIScale")
	outerScale.Scale = math.clamp(tonumber(Config and Config.stealBarScale) or 1, 0.5, 2)
	outerScale.Parent = Y
	pcall(function()
		local prevApply = Config._applyStealBarScale
		Config._applyStealBarScale = function(arg)
			Config.stealBarScale = math.clamp(tonumber(arg) or 1, 0.5, 2)
			outerScale.Scale = Config.stealBarScale
			if type(prevApply) == "function" and prevApply ~= Config._applyStealBarScale then
				pcall(prevApply, Config.stealBarScale)
			end
			pcall(function()
				if type(fn34) == "function" then fn34() elseif scheduleSaveConfig then scheduleSaveConfig() end
			end)
		end
		-- apply whatever was loaded
		outerScale.Scale = math.clamp(tonumber(Config.stealBarScale) or 1, 0.5, 2)
	end)

	local fill = Instance.new("Frame", Root)
	fill.Name = "Fill"
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.Position = UDim2.new(0, 0, 0, 0)
	fill.BackgroundColor3 = Color3.fromRGB(132, 133, 137)
	fill.BorderSizePixel = 0
	fill.ZIndex = ZB + 51
	Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 10)
	local fillGrad = Instance.new("UIGradient", fill)
	fillGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0.00, Color3.fromRGB(154, 155, 160)),
		ColorSequenceKeypoint.new(0.50, Color3.fromRGB(211, 213, 220)),
		ColorSequenceKeypoint.new(1.00, Color3.fromRGB(230, 233, 240)),
	})
	fillGrad.Rotation = 0

	local fpsLabel = Instance.new("TextLabel", Root)
	fpsLabel.Name = "FPSNeon"
	fpsLabel.Size = UDim2.new(1, -16, 1, 0)
	fpsLabel.Position = UDim2.new(0, 10, 0, 0)
	fpsLabel.BackgroundTransparency = 1
	fpsLabel.Text = "--FPS \u{B7} --ms"
	fpsLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	fpsLabel.Font = Enum.Font.GothamBold
	fpsLabel.TextSize = 12
	fpsLabel.TextXAlignment = Enum.TextXAlignment.Left
	fpsLabel.TextYAlignment = Enum.TextYAlignment.Center
	fpsLabel.TextStrokeTransparency = 1
	fpsLabel.ZIndex = ZB + 55

	-- position save + lock (follows Lock UI / Unlock UI)
	local POS_FILE = "volt/Volt_StealBarPos.json"
	local HttpSvc = game:GetService("HttpService")
	local function barLocked()
		return Config.uiLocked == true or Config.lockButtonsEnabled == true
	end
	local function saveBarPos()
		pcall(function()
			if not writefile then return end
			if makefolder then pcall(makefolder, "volt") end
			local p = Y.Position
			writefile(POS_FILE, HttpSvc:JSONEncode({ sx = p.X.Scale, ox = p.X.Offset, sy = p.Y.Scale, oy = p.Y.Offset }))
		end)
	end
	pcall(function()
		if not (isfile and readfile and isfile(POS_FILE)) then return end
		local d = HttpSvc:JSONDecode(readfile(POS_FILE))
		if type(d) ~= "table" then return end
		local sx, ox, sy, oy = tonumber(d.sx), tonumber(d.ox), tonumber(d.sy), tonumber(d.oy)
		if not (sx and ox and sy and oy) then return end
		for _, n in ipairs({ sx, ox, sy, oy }) do
			if n ~= n or math.abs(n) == math.huge then return end
		end
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(0, 0)
		if vp.X > 0 and vp.Y > 0 then
			local ax, ay = sx * vp.X + ox, sy * vp.Y + oy -- bar is anchored (0.5, 1): ax = centre, ay = bottom edge
			if ax < 0 or ax > vp.X or ay < 36 or ay > vp.Y + 40 then return end -- saved spot is off-screen: keep default
		end
		Y.Position = UDim2.new(sx, ox, sy, oy)
	end)

	-- drag
	local dragging, moved, dragStart, startPos = false, false, nil, nil
	Y.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			if barLocked() then return end
			dragging, moved = true, false
			dragStart = inp.Position
			startPos = Y.Position
		end
	end)
	UIS.InputChanged:Connect(function(inp)
		if not dragging then return end
		if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
			if barLocked() then
				dragging = false
				if moved then saveBarPos() end
				return
			end
			local dx = inp.Position.X - dragStart.X
			local dy = inp.Position.Y - dragStart.Y
			if math.abs(dx) + math.abs(dy) > 2 then moved = true end
			Y.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + dx, startPos.Y.Scale, startPos.Y.Offset + dy)
		end
	end)
	UIS.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			if dragging then
				dragging = false
				if moved then saveBarPos() end
			end
		end
	end)

	local displayProgress = 0
	local fpsAcc, fpsFrames, fpsVal, labelAcc = 0, 0, 0, 0.5
	RunService.RenderStepped:Connect(function(dt)
		fpsAcc += dt
		fpsFrames += 1
		labelAcc += dt
		if fpsAcc >= 0.5 then
			fpsVal = math.floor(fpsFrames / fpsAcc + 0.5)
			fpsAcc, fpsFrames = 0, 0
		end
		if labelAcc >= 0.5 then
			labelAcc = 0
			local ping = 0
			pcall(function()
				ping = LP:GetNetworkPing() * 1000
			end)
			if ping <= 0 then
				pcall(function()
					ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
				end)
			end
			fpsLabel.Text = string.format("%dFPS \u{B7} %dms", fpsVal, math.floor(ping + 0.5))
		end

		-- progress: same V3 steal state as before, 0 while idle (Haze behaviour)
		local target = 0
		local stealing, startT, st = false, nil, Steal
		if type(_G._VoltStealV3State) == "function" then
			stealing, startT, st = _G._VoltStealV3State()
		end
		st = st or Steal
		local holdMax = tonumber(st and st.V3HoldMax) or 2.6
		if stealing and startT then
			target = math.clamp((tick() - startT) / holdMax, 0, 1)
		end
		displayProgress = displayProgress + (target - displayProgress) * math.min(1, (dt or 0.016) * 12)
		if math.abs(displayProgress - target) < 0.005 then displayProgress = target end
		fill.Size = UDim2.new(displayProgress, 0, 1, 0)
		-- show when auto steal is on or while a steal is running
		Y.Visible = (st and st.AutoStealEnabled) or displayProgress > 0.01 or stealing
	end)

	_G.StealBar = {
		SetProgress = function(p)
			displayProgress = math.clamp(tonumber(p) or 0, 0, 1)
		end,
		SetState = function() end,
		Reset = function()
			displayProgress = 0
			isStealing = false
		end,
	}
	_G._CursedSetProgressBarVisible = function(v)
		Y.Visible = v == true
	end

	if Config and Config.autoStealEnabled then
		startAutoSteal()
	end
end)
