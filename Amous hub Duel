local TauntSystem = (function()
    local TAUNT_CFG = {
        MESSAGE        = "W Haze ezz steal",
        EMOTE_ASSET_ID = 130260688519268,
        FALLBACK_EMOTE = "laugh",
        COOLDOWN       = 1,
        MOVE_THRESHOLD = 0.1,
        GRACE          = 0.4,
    }
    local TextChatService = game:GetService("TextChatService")
    local ContentProvider = game:GetService("ContentProvider")
    local MarketplaceService = game:GetService("MarketplaceService")
    local EMOTE_NAME = "HazeTauntEmote"
    local cachedTrack, cachedHumanoid, cachedMethod = nil, nil, nil
    local activeTrack, moveConn = nil, nil
    local prepareToken, lastUse = 0, 0

    local function sendChat(text)
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channels = TextChatService:FindFirstChild("TextChannels")
            local channel = channels and channels:FindFirstChild("RBXGeneral")
            if channel then channel:SendAsync(text) return true end
            return false
        end
        local events = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        local say = events and events:FindFirstChild("SayMessageRequest")
        if say then say:FireServer(text, "All") return true end
        return false
    end

    local function stopEmote()
        if moveConn then moveConn:Disconnect(); moveConn = nil end
        if activeTrack then
            pcall(function() activeTrack:Stop(0.15) end)
            activeTrack = nil
        end
    end

    local function loadTrack(animator, id)
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. tostring(id)
        pcall(function() ContentProvider:PreloadAsync({ anim }) end)
        local ok, t = pcall(function() return animator:LoadAnimation(anim) end)
        if not ok or not t then return nil end
        local t0 = os.clock()
        while t.Length == 0 and os.clock() - t0 < 5 do task.wait(0.1) end
        if t.Length == 0 then pcall(function() t:Destroy() end); return nil end
        return t
    end

    local function resolveInnerAnimationId(id)
        if not game.GetObjects then return nil end
        local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(id)) end)
        if not ok or type(objs) ~= "table" then return nil end
        for _, obj in ipairs(objs) do
            if obj:IsA("Animation") then return obj.AnimationId end
            for _, d in ipairs(obj:GetDescendants()) do
                if d:IsA("Animation") then return d.AnimationId end
            end
        end
        return nil
    end

    local function setupDescriptionEmote(humanoid)
        local desc = humanoid:FindFirstChildOfClass("HumanoidDescription")
        if not desc then return false end
        local ok = pcall(function()
            desc:SetEmotes({ [EMOTE_NAME] = { TAUNT_CFG.EMOTE_ASSET_ID } })
            desc:SetEquippedEmotes({ EMOTE_NAME })
        end)
        return ok
    end

    local function prepareEmote(character)
        prepareToken = prepareToken + 1
        local myToken = prepareToken
        cachedTrack, cachedHumanoid, cachedMethod = nil, nil, nil
        task.spawn(function()
            local humanoid = character:WaitForChild("Humanoid", 10)
            if not humanoid then return end
            local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator", 10)
            if not animator then return end
            local t = loadTrack(animator, TAUNT_CFG.EMOTE_ASSET_ID)
            local method = "direct"
            if not t then
                local inner = resolveInnerAnimationId(TAUNT_CFG.EMOTE_ASSET_ID)
                if inner then
                    local numeric = tostring(inner):match("%d+")
                    if numeric then t = loadTrack(animator, numeric) end
                    method = "inner"
                end
            end
            if myToken ~= prepareToken then return end
            if t then
                t.Priority = Enum.AnimationPriority.Action4
                t.Looped = true
                cachedTrack, cachedHumanoid, cachedMethod = t, humanoid, method
            else
                local ok = setupDescriptionEmote(humanoid)
                cachedHumanoid = humanoid
                cachedMethod = ok and "description" or nil
            end
        end)
    end

    local function playEmote()
        local character = LP.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return false end
        stopEmote()
        if cachedTrack and cachedHumanoid == humanoid then
            local t = cachedTrack
            activeTrack = t
            t.Looped = true
            t:Play(0.05, 1, 1)
            local startedAt = os.clock()
            moveConn = RunService.Heartbeat:Connect(function()
                if os.clock() - startedAt < TAUNT_CFG.GRACE then return end
                if humanoid.Health <= 0
                    or humanoid.MoveDirection.Magnitude > TAUNT_CFG.MOVE_THRESHOLD
                    or humanoid.Jump then
                    stopEmote()
                end
            end)
            return true
        end
        if cachedMethod == "description" and cachedHumanoid == humanoid then
            local ok, res = pcall(function() return humanoid:PlayEmote(EMOTE_NAME) end)
            if ok and res then return true end
        end
        local ok, res = pcall(function() return humanoid:PlayEmote(TAUNT_CFG.FALLBACK_EMOTE) end)
        return ok and res ~= false
    end

    LP.CharacterAdded:Connect(function(character)
        stopEmote()
        prepareEmote(character)
    end)
    if LP.Character then prepareEmote(LP.Character) end

    local function trigger()
        if os.clock() - lastUse < TAUNT_CFG.COOLDOWN then return end
        lastUse = os.clock()
        playEmote()
        sendChat(TAUNT_CFG.MESSAGE)
    end

    return { Trigger = trigger, Stop = stopEmote }
end)()
_G.HazeTaunt = TauntSystem

