local function icon(kind, parent, s, color, pos)
	local f = make("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(s, s),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = pos or UDim2.fromScale(0.5, 0.5),
	}, parent)
	local function bar(x, y, w, h, rot)
		return make("Frame", {
			BackgroundColor3 = color, BorderSizePixel = 0,
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(w, h),
			Rotation = rot or 0,
		}, f)
	end
	local function side(x0, w, dir)
		local n = math.max(7, math.floor(s))
		n = math.min(n, 24)
		local h = s / n
		local mid = (n + 1) / 2
		for i = 1, n do
			local wi = math.max(1, w * (1 - math.abs(i - mid) / mid))
			local x = (dir == "r") and x0 or (x0 + w - wi)
			bar(x, (i - 1) * h, wi, h + 0.6)
		end
	end
	if kind == "play" then
		side(s * 0.22, s * 0.68, "r")
	elseif kind == "pause" then
		bar(s * 0.2, s * 0.1, s * 0.22, s * 0.8)
		bar(s * 0.58, s * 0.1, s * 0.22, s * 0.8)
	elseif kind == "next" then
		side(s * 0.1, s * 0.62, "r")
		bar(s * 0.78, s * 0.08, s * 0.13, s * 0.84)
	elseif kind == "prev" then
		bar(s * 0.09, s * 0.08, s * 0.13, s * 0.84)
		side(s * 0.28, s * 0.62, "l")
	elseif kind == "plus" then
		bar(0, s * 0.43, s, s * 0.14)
		bar(s * 0.43, 0, s * 0.14, s)
	elseif kind == "minus" then
		bar(0, s * 0.43, s, s * 0.14)
	elseif kind == "check" then
		bar(s * 0.28 - s * 0.07, s * 0.62 - s * 0.2, s * 0.14, s * 0.4, -45)
		bar(s * 0.62 - s * 0.07, s * 0.45 - s * 0.375, s * 0.14, s * 0.75, 45)
	elseif kind == "download" then
		bar(s * 0.43, 0, s * 0.14, s * 0.42)
		local n = 8
		local h = (s * 0.4) / n
		for i = 1, n do
			local wi = math.max(1, s * 0.62 * (1 - (i - 1) / n))
			bar((s - wi) / 2, s * 0.36 + (i - 1) * h, wi, h + 0.6)
		end
		bar(s * 0.08, s * 0.9, s * 0.84, s * 0.1)
	end
	return f
end
local function clearIcon(holder)
	for _, c in ipairs(holder:GetChildren()) do
		if c:IsA("Frame") then c:Destroy() end
	end
end
