-- ---------- TP Down / Auto TP Down / Drop BR (Akatsuki) ----------
--   TP Down      : key bind (button "F", click it to rebind) + mobile button "TP DOWN"
--   Auto TP Down : toggle (WaveTogglePill_4) + height box (TextBox_6, studs, default 20)
--   Drop BR      : key bind (button "X", click it to rebind) + mobile button "DROP BR"
-- _G.dropActive / _G.IsDropping are the same flags Akatsuki uses (Anti Ragdoll above reads them too).
local TP_DOWN_Y = -7 -- Akatsuki's hardcoded target Y: map specific, change it if your map's void/floor differs
local tpDownLastAt = 0
local tpDownPending = false

local function tpDownNow()
	if _G.dropActive or _G.IsDropping then return end
	local wait = 0.1 - (os.clock() - tpDownLastAt)
	if wait > 0 then
		if not tpDownPending then
			tpDownPending = true
			local char = LocalPlayer.Character
			task.delay(wait, function()
				tpDownPending = false
				if LocalPlayer.Character ~= char then return end
				tpDownNow()
			end)
		end
		return
	end
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum or hum.Health <= 0 or root.Anchored or hum.Sit or hum.SeatPart then return end
	tpDownLastAt = os.clock()
	local _, yaw = root.CFrame:ToEulerAnglesYXZ()
	pcall(function()
		root.CFrame = CFrame.new(root.Position.X, TP_DOWN_Y, root.Position.Z) * CFrame.Angles(0, yaw, 0)
		root.AssemblyLinearVelocity = Vector3.zero
	end)
end

local dropBusy = false
local dropConn

local function dropNow()
	if dropBusy then return end
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	if dropConn then
		dropConn:Disconnect()
		dropConn = nil
	end
	local startY = root.Position.Y
	local startedAt = tick()
	dropBusy = true
	_G.dropActive = true
	_G.IsDropping = true
	local function finish()
		if dropConn then
			dropConn:Disconnect()
			dropConn = nil
		end
		dropBusy = false
		_G.dropActive = false
		_G.IsDropping = false
	end
	dropConn = RunService.Heartbeat:Connect(function()
		local r = char and char:FindFirstChild("HumanoidRootPart")
		if not r then
			finish()
			return
		end
		if tick() - startedAt >= 0.2 then
			local _, yaw = r.CFrame:ToEulerAnglesYXZ()
			pcall(function()
				r.CFrame = CFrame.new(r.Position.X, startY, r.Position.Z) * CFrame.Angles(0, yaw, 0)
				r.AssemblyLinearVelocity = Vector3.zero
				r.Velocity = Vector3.zero
			end)
			finish()
			return
		end
		r.AssemblyLinearVelocity = Vector3.new(r.AssemblyLinearVelocity.X, 150, r.AssemblyLinearVelocity.Z)
	end)
end

stackActions["TP DOWN"] = tpDownNow
stackActions["DROP BR"] = dropNow

-- Auto TP Down: every 0.1s ray down from the root; once the drop to the floor reaches the height, TP Down fires once
-- and re-arms when you are back under that height.
local autoTpAccum, autoTpFired, autoTpRoot = 0, false, nil
local autoTpRay = RaycastParams.new()
autoTpRay.FilterType = Enum.RaycastFilterType.Exclude
pcall(function() autoTpRay.RespectCanCollide = true end)

local function getAutoTpHeight()
	local n = tonumber(G.TextBox_6.Text)
	if not n or n ~= n or math.abs(n) == math.huge then n = 20 end
	return math.clamp(math.floor(n + 0.5), 1, 1000)
end

RunService.Heartbeat:Connect(function(dt)
	if not pillOn(G.WaveTogglePill_4) then
		autoTpAccum, autoTpFired, autoTpRoot = 0, false, nil
		return
	end
	if _G.dropActive or _G.IsDropping then
		autoTpAccum = 0
		return
	end
	autoTpAccum += dt or 0
	if autoTpAccum < 0.1 then return end
	autoTpAccum = 0
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then
		autoTpFired, autoTpRoot = false, nil
		return
	end
	if root ~= autoTpRoot then
		autoTpRoot, autoTpFired = root, false
	end
	autoTpRay.FilterDescendantsInstances = { char }
	local hit = workspace:Raycast(root.Position, Vector3.new(0, -2048, 0), autoTpRay)
	local dist = hit and math.max(0, root.Position.Y - hit.Position.Y) or nil
	local over = dist ~= nil and dist >= getAutoTpHeight()
	if over and not autoTpFired then
		autoTpFired = true
		tpDownNow()
	elseif not over then
		autoTpFired = false
	end
end)

-- ==========================================================================
-- ADDED: AUTO LEFT / AUTO RIGHT (ported from luckbroom startAutoLeft / startAutoRight)
--   One-shot run, same as luckbroom: walk to waypoint 1, then to waypoint 2, stop, face the FACE point, switch off.
--   Triggers: key bind (Auto Left row TextButton_10, default Z / Auto Right row TextButton_11, default C),
--             mobile buttons AUTO LEFT / AUTO RIGHT (latched colour while the run is active).
--   Pressing the same trigger again cancels the run. Left and Right exclude each other, as in luckbroom.
--   Speed = the "Normal Speed" box (G.TextBox), like luckbroom's NS. While a run is active the Wind speed engine
--   yields (_G.__WindAutoLRDriving), like luckbroom pauses its own engine during Auto Left/Right.
--   Starting a run switches the bat aimbot off; switching the bat aimbot on cancels a run (luckbroom enableAutoBat).
--   Not ported: luckbroom _suppressBodyLock/_unsuppressBodyLock. Wind's "Body Lock" row has no logic behind it yet.
--   Deviation from luckbroom: a run also stops when the character dies or is removed (luckbroom keeps steering
--   towards the waypoints after a respawn).
--   Waypoints below are luckbroom's AP table verbatim. They are world coordinates of ONE map and were not
--   verified by me on your game/map. If the run walks to the wrong place, only ROUTES needs changing.
-- ==========================================================================
local autoLR = { running = nil, phase = 1, conn = nil }
do
	local ARRIVE_DIST = 1     -- luckbroom: horizontal distance < 1 stud counts as arrived
	local SPEED_CAP = 500     -- same sanity cap as the Wind speed engine
	local DEFAULT_SPEED = 60  -- luckbroom NS default; used when the Normal Speed box holds junk

	local ROUTES = {
		left = {
			p1   = Vector3.new(-476.48, -6.28, 92.73),
			p2   = Vector3.new(-483.12, -4.95, 94.80),
			face = Vector3.new(-482.25, -4.96, 92.09),
			mobile = "AUTO LEFT",
		},
		right = {
			p1   = Vector3.new(-476.16, -6.52, 25.62),
			p2   = Vector3.new(-483.06, -5.03, 25.48),
			face = Vector3.new(-482.06, -6.93, 35.47),
			mobile = "AUTO RIGHT",
		},
	}

	local mobileFrameByName = {
		["AUTO LEFT"] = G.StackBtn_autoLeft,
		["AUTO RIGHT"] = G.StackBtn_autoRight,
	}

	local function setMobile(name, on)
		mobileToggles[name] = on
		local frame = mobileFrameByName[name]
		if frame then
			TweenService:Create(frame, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
				BackgroundColor3 = on and Color3.fromRGB(160, 16, 40) or Color3.fromRGB(48, 8, 15)
			}):Play()
		end
	end

	local function readNormalSpeed()
		local n = tonumber(G.TextBox.Text)
		if n and n == n and n > 0 and n < math.huge then
			return math.min(n, SPEED_CAP)
		end
		return DEFAULT_SPEED
	end

	local function flatDelta(root, point)
		local d = point - root.Position
		return Vector3.new(d.X, 0, d.Z)
	end

	-- luckbroom: hum:Move(direction) and horizontal AssemblyLinearVelocity = direction * speed, Y untouched
	local function driveToward(root, hum, point, speed)
		local flat = flatDelta(root, point)
		if flat.Magnitude < 1e-4 then return end -- .Unit of a zero vector would give NaN
		local mv = flat.Unit
		hum:Move(mv, false)
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(mv.X * speed, v.Y, mv.Z * speed)
	end

	function autoLR.stop()
		if autoLR.conn then
			autoLR.conn:Disconnect()
			autoLR.conn = nil
		end
		autoLR.running = nil
		autoLR.phase = 1
		_G.__WindAutoLRDriving = false
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then hum:Move(Vector3.zero, false) end
		setMobile("AUTO LEFT", false)
		setMobile("AUTO RIGHT", false)
	end

	local function step(side)
		local route = ROUTES[side]
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not root or not hum then return end
		if hum.Health <= 0 then
			autoLR.stop()
			return
		end
		local speed = readNormalSpeed()
		if autoLR.phase == 1 then
			if flatDelta(root, route.p1).Magnitude < ARRIVE_DIST then
				autoLR.phase = 2
				driveToward(root, hum, route.p2, speed)
			else
				driveToward(root, hum, route.p1, speed)
			end
		else
			if flatDelta(root, route.p2).Magnitude < ARRIVE_DIST then
				hum:Move(Vector3.zero, false)
				root.AssemblyLinearVelocity = Vector3.zero
				autoLR.stop()
				local facePos = Vector3.new(route.face.X, root.Position.Y, route.face.Z)
				if (facePos - root.Position).Magnitude > 0.01 then
					root.CFrame = CFrame.new(root.Position, facePos)
				end
			else
				driveToward(root, hum, route.p2, speed)
			end
		end
	end

	function autoLR.start(side)
		local route = ROUTES[side]
		if not route then return end
		autoLR.stop() -- cancels the other side / a previous run and resets both mobile buttons
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 or not char:FindFirstChild("HumanoidRootPart") then return end
		if pillOn(G.WaveTogglePill_22) then
			setToggleVisual(G.WaveTogglePill_22, false) -- bat aimbot off (luckbroom disableAllAimbots)
		end
		if G.WaveTogglePill_BatTP and pillOn(G.WaveTogglePill_BatTP) then
			setToggleVisual(G.WaveTogglePill_BatTP, false) -- Bat TP off too
		end
		autoLR.running = side
		autoLR.phase = 1
		_G.__WindAutoLRDriving = true
		setMobile(route.mobile, true)
		local errShown = false
		autoLR.conn = RunService.Heartbeat:Connect(function()
			local ok, err = pcall(step, side)
			if not ok then
				if not errShown then
					errShown = true
					warn("[WIND] auto left/right error: " .. tostring(err))
				end
				autoLR.stop()
			end
		end)
	end

	function autoLR.toggle(side)
		if autoLR.running == side then
			autoLR.stop()
		else
			autoLR.start(side)
		end
	end

	stackToggleHooks["AUTO LEFT"] = function() autoLR.toggle("left") end
	stackToggleHooks["AUTO RIGHT"] = function() autoLR.toggle("right") end

	-- bat aimbot switched on -> cancel a run
	G.WaveTogglePill_22:GetAttributeChangedSignal("WaveToggleOn"):Connect(function()
		if pillOn(G.WaveTogglePill_22) and autoLR.running then
			autoLR.stop()
		end
	end)

	LocalPlayer.CharacterRemoving:Connect(function()
		if autoLR.running then autoLR.stop() end
	end)

	_G.__WindAutoLRDriving = false
end

