	local function startInf()
		if AB.infThread then AB.infThread:Disconnect() end
		AB.infThread = RunService.Stepped:Connect(function()
			if not AB.infJump or not AB.jumpHeld then return end
			local now = tick()
			if now - AB.lastBoost < 0.05 then return end
			AB.lastBoost = now
			local char = localPlayer.Character
			if not char then return end
			local hum = char:FindFirstChildOfClass("Humanoid")
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if not hum or not hrp or hum.Health <= 0 then return end
			local vel = hrp.AssemblyLinearVelocity
			if vel.Y < 55 then
				hrp.AssemblyLinearVelocity = Vector3.new(vel.X, 65, vel.Z)
			end
		end)
	end
	local function stopInf()
		if AB.infThread then AB.infThread:Disconnect(); AB.infThread = nil end
		AB.jumpHeld = false
	end
