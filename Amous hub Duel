-- ========== LOCK UI + SMOOTH DRAG ==========
-- uiLocked follows the "Lock UI" toggle (WaveTogglePill_35).
-- ON  -> main GUI, steal bar and every mobile button are locked in place.
-- OFF -> the main GUI, the steal bar and each mobile button can be dragged separately.
local uiLocked = false
local stackPanelOn = false -- "Show Panel" toggle: ON = the whole panel drags, OFF = each mobile button drags alone
local DRAG_THRESHOLD = 6   -- pixels a press must move before it counts as a drag
local dragMoved = {}       -- [frame] = true if the current/last press became a drag
G.OnLayoutChanged = function() end -- replaced in the config section

-- gate (optional): returns false to refuse a drag; marks (optional): extra frames flagged as "dragged" so their click handlers stay quiet
local function makeDraggable(frame, handles, gate, marks)
	dragMoved[frame] = false
	local dragging, activeInput, dragStart, startPos, startAbs
	local startScale = 1

	local function update(input)
		local delta = input.Position - dragStart
		if not dragMoved[frame] then
			if delta.Magnitude < DRAG_THRESHOLD then return end
			dragMoved[frame] = true
			if marks then
				for _, f in ipairs(marks) do dragMoved[f] = true end
			end
		end
		local dx, dy = delta.X, delta.Y

		-- no screen-edge clamp: the GUI, the steal bar, the panel and every button can be dragged anywhere
		-- (a frame left completely off-screen is pulled back by rescueOffscreenFrames on load)

		-- offsets live in the parent's (possibly UIScale'd) space: screen px / scale
		frame.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + dx / startScale,
			startPos.Y.Scale, startPos.Y.Offset + dy / startScale
		)
	end

	local function begin(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		if activeInput == input then return end -- same press reported by parent and child handle
		dragMoved[frame] = false
		if marks then
			for _, f in ipairs(marks) do dragMoved[f] = false end
		end
		if uiLocked then return end
		if gate and not gate() then return end

		activeInput = input
		dragging = true
		dragStart = input.Position
		startPos = frame.Position
		startAbs = frame.AbsolutePosition
		local parentScale = frame.Parent and frame.Parent:FindFirstChildOfClass("UIScale")
		startScale = (parentScale and parentScale.Scale > 0) and parentScale.Scale or 1

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				activeInput = nil
				if dragMoved[frame] then
					local hook = G.OnLayoutChanged
					if hook then task.defer(hook) end
				end
			end
		end)
	end

	for _, h in ipairs(handles) do
		if h then h.InputBegan:Connect(begin) end
	end

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if uiLocked then
			dragging = false
			activeInput = nil
			return
		end
		if input == activeInput or input.UserInputType == Enum.UserInputType.MouseMovement then
			update(input)
		end
	end)
end

