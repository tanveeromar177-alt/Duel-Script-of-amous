        label.TextTruncate = Enum.TextTruncate.AtEnd
        label.ZIndex = 9

        local arrow = Instance.new("TextLabel", container)
        arrow.Size = UDim2.new(0, 20, 1, 0)
        arrow.Position = UDim2.new(1, -22, 0, 0)
        arrow.BackgroundTransparency = 1
        arrow.Text = ">"
        arrow.TextColor3 = Color3.fromRGB(200, 200, 210)
        arrow.Font = Enum.Font.GothamBold
        arrow.TextSize = 14
        arrow.ZIndex = 9

        local currentIdx = 1
        for i, opt in ipairs(options) do
            if tostring(opt) == tostring(defaultText) then currentIdx = i; break end
        end

        -- Parent dropdown to main GUI so it isn't clipped by ScrollingFrame
        local dropParent = main or parent
        local listH = math.min(#options, MAX_VISIBLE) * OPT_H
        local dropdown = Instance.new("Frame", dropParent)
        dropdown.Name = "HazeDropdown"
        dropdown.Size = UDim2.new(0, 130, 0, listH)
        dropdown.BackgroundColor3 = Color3.fromRGB(27, 29, 26)
        dropdown.BackgroundTransparency = 0
        dropdown.BorderSizePixel = 0
        dropdown.Visible = false
        dropdown.ZIndex = 200
        dropdown.ClipsDescendants = true
        Instance.new("UICorner", dropdown).CornerRadius = UDim.new(0, 0)
        local ddStroke = Instance.new("UIStroke", dropdown)
        ddStroke.Color = Color3.fromRGB(173, 175, 180)
        ddStroke.Thickness = 1.2
        ddStroke.Transparency = 0.15

        local scroll = Instance.new("ScrollingFrame", dropdown)
        scroll.Size = UDim2.new(1, 0, 1, 0)
        scroll.BackgroundTransparency = 1
        scroll.BorderSizePixel = 0
        scroll.ScrollBarThickness = 4
        scroll.ScrollBarImageColor3 = Color3.fromRGB(192, 194, 200)
        scroll.CanvasSize = UDim2.new(0, 0, 0, #options * OPT_H)
        scroll.ZIndex = 201
        scroll.ScrollingDirection = Enum.ScrollingDirection.Y

        local open = false
        local optionBtns = {}

        for i, opt in ipairs(options) do
            local btn = Instance.new("TextButton", scroll)
            btn.Size = UDim2.new(1, 0, 0, OPT_H)
            btn.Position = UDim2.new(0, 0, 0, (i - 1) * OPT_H)
            btn.BackgroundColor3 = (i == currentIdx) and Color3.fromRGB(115, 116, 120) or Color3.fromRGB(27, 29, 26)
            btn.BackgroundTransparency = 0
            btn.BorderSizePixel = 0
            btn.Text = tostring(opt)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.Font = Enum.Font.GothamBold
            btn.TextSize = 12
            btn.AutoButtonColor = false
            btn.ZIndex = 202
            optionBtns[i] = btn

            btn.MouseEnter:Connect(function()
                if i ~= currentIdx then
                    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
                end
            end)
            btn.MouseLeave:Connect(function()
                if i ~= currentIdx then
                    btn.BackgroundColor3 = Color3.fromRGB(27, 29, 26)
                end
            end)
            btn.MouseButton1Click:Connect(function()
                currentIdx = i
                label.Text = tostring(options[currentIdx])
                for j, b in ipairs(optionBtns) do
                    b.BackgroundColor3 = (j == currentIdx) and Color3.fromRGB(115, 116, 120) or Color3.fromRGB(27, 29, 26)
                end
                open = false
                dropdown.Visible = false
                arrow.Text = ">"
                if cb then pcall(cb, options[currentIdx], currentIdx) end
            end)
        end

        local function positionDropdown()
            local abs = container.AbsolutePosition
            local absSize = container.AbsoluteSize
            local mainAbs = dropParent.AbsolutePosition
            local x = abs.X - mainAbs.X
            local y = abs.Y - mainAbs.Y + absSize.Y + 2
            -- keep inside main if possible
            local maxY = dropParent.AbsoluteSize.Y - listH - 4
            if y > maxY then
                y = abs.Y - mainAbs.Y - listH - 2
            end
            dropdown.Position = UDim2.new(0, x, 0, math.max(0, y))
        end

        local openBtn = Instance.new("TextButton", container)
        openBtn.Size = UDim2.new(1, 0, 1, 0)
