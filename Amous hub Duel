	task.spawn(function()
		local function isText(d)
			return d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")
		end
		local function hook(root)
			for _, d in ipairs(root:GetDescendants()) do
				if isText(d) then pcall(function() d.FontFace = G.SpicyFont end) end
			end
			root.DescendantAdded:Connect(function(d)
				if isText(d) then pcall(function() d.FontFace = G.SpicyFont end) end
			end)
		end
		if SPICY_APPLY_TO_GAME_GUI then
			local pg = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
			hook(pg)
		end
		if SPICY_APPLY_TO_WORLD_GUI then
			hook(workspace)
		end
	end)
end
