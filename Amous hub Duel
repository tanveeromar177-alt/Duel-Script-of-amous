-- Mini button logo: G.MINI_ICON_ASSET (122527723321819) is loaded like a DECAL id. The rbxthumb above is the fallback; when the executor has
-- game:GetObjects the Decal is loaded and its real Texture (the image id) replaces it.
task.spawn(function()
	local ok, objs = pcall(function()
		return game:GetObjects("rbxassetid://" .. G.MINI_ICON_ASSET)
	end)
	if not ok or type(objs) ~= "table" then return end
	local decal = objs[1]
	if decal and (decal:IsA("Decal") or decal:IsA("Texture")) and decal.Texture ~= "" then
		local tex = decal.Texture
		G.WaveMiniRestoreButton.Image = tex
		if G.LogoPreload_default then G.LogoPreload_default.Image = tex end
	end
	pcall(function() if decal then decal:Destroy() end end)
end)

